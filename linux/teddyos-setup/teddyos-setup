APP_ID = "com.teddyos.Setup"


def animations_enabled() -> bool:
    """Whether this desktop wants motion at all.

    GNOME turns this off for Reduce Animation and for the accessibility
    profiles. The boot menu offers "Install teddyOS (screen reader)", so
    somebody will arrive here driving the machine with Orca — and a timed
    sequence that owns the screen is, for them, a screen that says nothing
    for six seconds. When it is off the welcome page is simply shown.
    """
    settings = Gtk.Settings.get_default()
    if settings is None:
        return False
    return bool(settings.get_property("gtk-enable-animations"))


def on_live_media() -> bool:
    """True when running from the USB stick or ISO rather than an install.

    This decides a sentence, so it fails to the cautious answer: if we cannot
    tell, we do not claim the disk is untouched.
    """
    if Path("/run/live/medium").exists():
        return True
    try:
        return "boot=live" in Path("/proc/cmdline").read_text()
    except OSError:
        return False


def pill(label: str, primary: bool = True) -> Gtk.Button:
    button = Gtk.Button(label=label, halign=Gtk.Align.CENTER)
    if primary:
        button.add_css_class("suggested-action")
    button.add_css_class("pill")
    return button


class SetupWindow(Adw.ApplicationWindow):
    def __init__(self, app: Adw.Application, first_boot: bool = False):
        super().__init__(application=app, title="Welcome to teddyOS")
        self.first_boot = first_boot
        if first_boot:
            # Fullscreen, like the macOS Setup Assistant. On first boot this is
            # not an app among others — it is the machine asking, and a small
            # window floating over a desktop reads as something you can ignore
            # or postpone. Fullscreen is what makes it a journey.
            #
            # Deliberately NOT undismissable. Setup Assistant traps you because
            # Apple controls the hardware; here, a first boot that goes wrong
            # (no pointer, unreadable text on a bad display mode) must not leave
            # someone stuck with no way to reach a terminal. Escape closes it,
            # and the autostart brings it back next login because the answers
            # were never written.
            self.fullscreen()
        else:
            # Run from Settings later: an ordinary window. 720x560 because the
            # Skills page is the tallest, and at 660 its Finish button lands
            # below the fold on a 1024x768 display.
            self.set_default_size(720, 560)

        self.level_id = caps.DEFAULT_LEVEL
        self.cap_switches: dict[str, Gtk.Switch] = {}
        self.skill_switches: dict[str, Gtk.Switch] = {}
        self.workspace_paths: list[str] = []

        self.stack = Gtk.Stack(transition_type=Gtk.StackTransitionType.SLIDE_LEFT)
        self.stack.add_named(self._welcome(), "welcome")
        self.stack.add_named(self._experience(), "experience")
        self.stack.add_named(self._capabilities(), "caps")
        self.stack.add_named(self._skills(), "skills")
        self.stack.add_named(self._done(), "done")

        self.header = Adw.HeaderBar(show_title=False)
        self.back = Gtk.Button(icon_name="go-previous-symbolic", visible=False)
        self.back.connect("clicked", self._go_back)
        self.header.pack_start(self.back)

        toolbar = Adw.ToolbarView()
        toolbar.add_top_bar(self.header)
        toolbar.set_content(self.stack)
        self.set_content(toolbar)

        self.order = ["welcome", "experience", "caps", "skills", "done"]
        self.stack.connect("notify::visible-child-name", self._sync_back)

    # --- navigation ---------------------------------------------------------

    def _sync_back(self, *_a) -> None:
        name = self.stack.get_visible_child_name()
        # No way back from Done: everything is already written, and a back
        # button that cannot undo the write is a lie about what it does.
        self.back.set_visible(name not in ("welcome", "done"))

    def _go(self, name: str) -> None:
        self.stack.set_visible_child_name(name)

    def _go_back(self, *_a) -> None:
        i = self.order.index(self.stack.get_visible_child_name())
        if i > 0:
            self.stack.set_transition_type(Gtk.StackTransitionType.SLIDE_RIGHT)
            self._go(self.order[i - 1])
            self.stack.set_transition_type(Gtk.StackTransitionType.SLIDE_LEFT)

    def guided(self) -> bool:
        return self.level_id == "guided"

    # --- 1. welcome ---------------------------------------------------------

    def _welcome(self) -> Gtk.Widget:
        page = Adw.StatusPage(
            icon_name="system-search-symbolic",
            title="teddyOS",
            description=(
                "A few questions before you start.\n\n"
                "teddyOS asks before it touches anything — your files, or the "
                "network. Everything is off until you turn it on, and every "
                "answer here can be changed later."
            ),
        )
        button = pill("Continue")
        button.connect("clicked", lambda *_: self._go("experience"))
        page.set_child(button)
        if self.first_boot and animations_enabled():
            return self._intro_over(page)
        return page

    # --- 1a. the first ten seconds ------------------------------------------

    def _intro_over(self, page: Gtk.Widget) -> Gtk.Widget:
        """Fade three sentences over the welcome page, then reveal it.

        This exists for the moment someone sits down in front of a machine
        they have never seen and does not know what any of it is. The welcome
        page below is a good screen, but it opens by asking for something —
        and a question assumes the reader already feels oriented enough to
        answer it. The discomfort peaks in the first few seconds, so the
        cheapest thing that helps is to not ask for anything yet.

        It is a reveal of that page rather than a screen before it. A separate
        screen would cost an extra click and a second thing to dismiss, and
        the page it resolves into already says the concrete part.

        Opacity and nothing else. Blur is disabled across this desktop because
        a full-surface readback per frame on an emulated GPU is what makes the
        machine feel slow; an intro that stutters would argue the opposite of
        what it says.
        """
        self._intro_over_ = False
        self._intro_anims: list[Adw.TimedAnimation] = []

        page.set_opacity(0.0)

        icon = Gtk.Image.new_from_icon_name("system-search-symbolic")
        icon.set_pixel_size(48)
        icon.add_css_class("dim-label")
        icon.set_opacity(0.0)

        # One sentence at a time, and never two.
        #
        # A Gtk.Stack CROSSFADE was tried here and is wrong for this content.
        # It genuinely overlaps its children, which is the point — but these
        # children are centred blocks of two and three lines, so mid-transition
        # the screen shows both sentences interleaved through each other. The
        # same legible-through-legible mud as the handoff, in miniature.
        #
        # So the line fades out, the screen rests, the next one fades in. The
        # rest is not a gap to be minimised: it is a beat of silence, and it is
        # what makes a sequence feel calm rather than busy. What made the first
        # attempt read as a flicker was linear easing and a rushed 20ms, not
        # the pause itself.
        #
        # The glyph never fades between beats. It anchors the screen, so the
        # quiet moment is a rest rather than a void.
        line = Gtk.Label(wrap=True, justify=Gtk.Justification.CENTER)
        line.add_css_class("title-2")
        line.set_max_width_chars(38)
        line.set_opacity(0.0)

        col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=28,
                      valign=Gtk.Align.CENTER, halign=Gtk.Align.CENTER,
                      margin_start=40, margin_end=40)
        col.append(icon)
        col.append(line)

        # Always reachable, and it does exactly what waiting would do. Someone
        # anxious enough to need this screen is not soothed by being unable to
        # leave it.
        skip = Gtk.Button(label="Skip")
        skip.add_css_class("flat")
        skip.set_halign(Gtk.Align.END)
        skip.set_valign(Gtk.Align.END)
        skip.set_margin_end(16)
        skip.set_margin_bottom(16)
        skip.set_opacity(0.0)
        skip.connect("clicked", lambda *_: self._intro_finish(page, col, skip))

        overlay = Gtk.Overlay()
        overlay.set_child(page)
        overlay.add_overlay(col)
        overlay.add_overlay(skip)

        beats = [
            "Hello.",
            "You don't need to know how any of this works.",
            # Only true off the USB stick, so it is chosen at runtime. A
            # first-run screen that reassures you with something false is
            # worse than one that says nothing.
            "Nothing here can break, and nothing you do touches the "
            "computer you had before."
            if on_live_media() else
            "Nothing here can break. Anything you change, you can change back.",
        ]

        self._fade(icon, 1.0, 700, Adw.Easing.EASE_OUT_CUBIC)
        self._later(900, lambda: self._fade(skip, 0.6, 400))
        self._later(600, lambda: self._beat(page, col, skip, line, beats, 0))
        return overlay

    # One beat: fade in, hold, fade out, rest. IN is longer than OUT because a
    # sentence should arrive gently and leave without dawdling; REST is the
    # silence in between, on purpose.
    BEAT_IN, BEAT_HOLD, BEAT_OUT, BEAT_REST = 460, 1250, 400, 170

    def _beat(self, page, col, skip, line: Gtk.Label,
              beats: list[str], i: int) -> None:
        if self._intro_over_:
            return
        if i >= len(beats):
            self._intro_finish(page, col, skip)
            return
        line.set_text(beats[i])
        self._fade(line, 1.0, self.BEAT_IN, Adw.Easing.EASE_OUT_CUBIC)
        out_at = self.BEAT_IN + self.BEAT_HOLD
        # The last sentence does not fade out on its own — _intro_finish takes
        # the whole layer down together, so the screen never blinks between the
        # end of the words and the start of the page.
        if i == len(beats) - 1:
            self._later(out_at, lambda: self._beat(page, col, skip, line, beats, i + 1))
        else:
            self._later(out_at,
                        lambda: self._fade(line, 0.0, self.BEAT_OUT,
                                           Adw.Easing.EASE_IN_CUBIC))
            self._later(out_at + self.BEAT_OUT + self.BEAT_REST,
                        lambda: self._beat(page, col, skip, line, beats, i + 1))

    def _intro_finish(self, page, col, skip) -> None:
        """Hand over in sequence, not as a crossfade.

        Crossfading the two layers put both on screen at ~50% at once, and
        their contents do not line up: two magnifying glasses at different
        sizes, and the last sentence drawn straight through the page's title
        and its paragraph. Legible-through-legible is the worst thing a
        transition can do, and it was the ugliest moment in the sequence.

        So the intro leaves before the page arrives, with the page starting
        while the intro is already faint. Both are near-white screens, so the
        seam is invisible — far better than a double image.
        """
        if self._intro_over_:
            return
        self._intro_over_ = True
        self._fade(col, 0.0, 380, Adw.Easing.EASE_IN_CUBIC)
        self._fade(skip, 0.0, 260, Adw.Easing.EASE_IN_CUBIC)
        self._later(300, lambda: self._fade(page, 1.0, 460, Adw.Easing.EASE_OUT_CUBIC))
        # Stop the overlay eating clicks meant for Continue once it is gone.
        self._later(780, lambda: (col.set_visible(False), skip.set_visible(False)))

    def _fade(self, widget: Gtk.Widget, to: float, ms: int,
              easing: Adw.Easing = Adw.Easing.EASE_IN_OUT_CUBIC) -> None:
        target = Adw.PropertyAnimationTarget.new(widget, "opacity")
        anim = Adw.TimedAnimation.new(widget, widget.get_opacity(), to, ms, target)
        # Linear opacity reads as mechanical — it starts and stops at full
        # speed, so the eye catches both ends. Cubic easing is what makes the
        # same duration feel unhurried.
        anim.set_easing(easing)
        # Held on self: a TimedAnimation that goes out of scope is collected
        # mid-play and the property simply stops moving, which looks like a
        # frame drop rather than a bug.
        self._intro_anims.append(anim)
        anim.play()

    def _later(self, ms: int, fn) -> None:
        def once() -> bool:
            # Each callback decides for itself whether it is still wanted --
            # _beat and _intro_finish both check _intro_over_, and the cleanup
            # queued BY _intro_finish has to run after that flag is set, so the
            # guard cannot live here.
            #
            # The window can be closed, or Escape pressed, at any point in the
            # timeline. Firing into a torn-down widget must not be a crash on
            # the way out of the one screen whose job is to be reassuring.
            try:
                fn()
            except Exception:  # noqa: BLE001
                pass
            return GLib.SOURCE_REMOVE
        GLib.timeout_add(ms, once)

    # --- 2. experience ------------------------------------------------------

    def _experience(self) -> Gtk.Widget:
        box = self._page_box(
            "How much should it explain?",
            "This only changes how much teddyOS explains. It does not change "
            "what it is allowed to do.",
        )

        group = Adw.PreferencesGroup()
        self._level_rows: dict[str, Gtk.CheckButton] = {}
        first: Gtk.CheckButton | None = None
        for lvl in caps.LEVELS:
            row = Adw.ActionRow(title=lvl["label"], subtitle=lvl["detail"])
            radio = Gtk.CheckButton(valign=Gtk.Align.CENTER)
            if first is None:
                first = radio
                radio.set_active(True)
            else:
                radio.set_group(first)
            radio.connect("toggled", self._level_changed, lvl["id"])
            row.add_prefix(radio)
            row.set_activatable_widget(radio)
            self._level_rows[lvl["id"]] = radio
            group.add(row)
        box.append(group)

        button = pill("Continue")
        button.set_halign(Gtk.Align.END)
        button.connect("clicked", lambda *_: (self._retitle_caps(), self._go("caps")))
        box.append(button)
        return self._scroll(box)

    def _level_changed(self, radio: Gtk.CheckButton, level_id: str) -> None:
        if radio.get_active():
            self.level_id = level_id

    # --- 3. capabilities ----------------------------------------------------

    def _capabilities(self) -> Gtk.Widget:
        box = self._page_box(
            "What may this machine touch?",
            "",
        )
        self._caps_subtitle = box.get_last_child()

        if not sandbox.available():
            box.append(Adw.Banner(
                title="On this machine, these settings are promises — teddyOS "
                      "will try to follow them, but the computer cannot lock "
                      "them as tightly as usual.",
                revealed=True,
            ))

        self._caps_group = Adw.PreferencesGroup()
        defaults = caps.load()
        for cap in caps.CAPABILITIES:
            row = Adw.ActionRow(title=caps.text(cap, "label", True))
            row.set_subtitle(caps.text(cap, "detail", True))

            if cap["enforced"] and sandbox.available():
                badge = Gtk.Label(label=caps.text(cap, "badge", True))
                badge.add_css_class("success")
            else:
                badge = Gtk.Label(label=caps.text(cap, "badge", True))
                badge.add_css_class("dim-label")
            badge.add_css_class("caption")
            row.add_suffix(badge)

            switch = Gtk.Switch(valign=Gtk.Align.CENTER,
                                active=defaults.get(cap["id"], False))
            row.add_suffix(switch)
            row.set_activatable_widget(switch)
            self.cap_switches[cap["id"]] = switch
            self._caps_group.add(row)

            why = Adw.ActionRow(subtitle=caps.text(cap, "why", True))
            why.set_subtitle_lines(4)
            why.add_css_class("dim-label")
            self._caps_group.add(why)
            cap["_row"], cap["_why"], cap["_badge"] = row, why, badge

            if cap["id"] == "workspace.index":
                self.folder_row = Adw.ActionRow(title="Folders it may search",
                                                subtitle="None chosen yet")
                choose = Gtk.Button(label="Choose…", valign=Gtk.Align.CENTER)
                choose.connect("clicked", self._choose_folder)
                self.folder_row.add_suffix(choose)
                self.folder_row.set_sensitive(switch.get_active())
                switch.connect("notify::active",
                               lambda sw, _p: self.folder_row.set_sensitive(sw.get_active()))
                self._caps_group.add(self.folder_row)

        box.append(self._caps_group)

        note = Gtk.Label(xalign=0, wrap=True)
        note.add_css_class("dim-label")
        note.add_css_class("caption")
        note.set_text(
            # Was two paragraphs restating what the switch above already says.
            # One sentence of fact, one of consequence.
            "Ranking happens here, so what you type is never sent. That needs "
            "a copy of the index — about 68 MB, downloaded once at the end of "
            "setup. “Help improve teddyOS” is separate: it only allows log "
            "snapshots on this machine, off unless you turn it on."
        )
        box.append(note)

        button = pill("Continue")
        button.set_halign(Gtk.Align.END)
        button.connect("clicked", lambda *_: (self._retitle_skills(), self._go("skills")))
        box.append(button)
        return self._scroll(box)

    def _retitle_caps(self) -> None:
        """Apply the Experience choice to this screen's copy.

        Advanced swaps the plain-language consequence for the wire name, which
        is what core/src/level.rs means by `blurb(level)` — the same row, told
        to someone who would rather see `portal.sync` than a sentence.
        """
        g = self.guided()
        for cap in caps.CAPABILITIES:
            row, why, badge = cap.get("_row"), cap.get("_why"), cap.get("_badge")
            if not row:
                continue
            row.set_title(caps.text(cap, "label", g))
            # Advanced asked for the tool name; Guided asked for a sentence.
            row.set_subtitle(caps.text(cap, "detail", g) if g else cap["id"])
            why.set_subtitle(caps.text(cap, "why", g))
            if badge:
                badge.set_label(caps.text(cap, "badge", g))

    # --- 4. skills ----------------------------------------------------------

    def _skills(self) -> Gtk.Widget:
        box = self._page_box("What should it help you with?", "")
        self._skills_heading = box._heading
        self._skills_subtitle = box.get_last_child()

        group = Adw.PreferencesGroup()
        enabled = set(caps.DEFAULT_SKILLS)
        for skill in caps.SKILLS:
            row = Adw.ActionRow(title=caps.text(skill, "label", True),
                                subtitle=caps.text(skill, "detail", True))
            switch = Gtk.Switch(valign=Gtk.Align.CENTER,
                                active=skill["id"] in enabled)
            row.add_suffix(switch)
            row.set_activatable_widget(switch)
            self.skill_switches[skill["id"]] = switch
            group.add(row)
            skill["_row"] = row
        box.append(group)

        note = Gtk.Label(xalign=0, wrap=True)
        note.add_css_class("dim-label")
        note.add_css_class("caption")
        self._skills_note = note
        note.set_text(
            "None of these can do anything you did not allow on the last "
            "screen. Turning one on does not give teddyOS any new access."
        )
        box.append(note)

        button = pill("Finish")
        button.set_halign(Gtk.Align.END)
        button.connect("clicked", self._finish)
        box.append(button)
        return self._scroll(box)

    def _retitle_skills(self) -> None:
        for skill in caps.SKILLS:
            row = skill.get("_row")
            if row:
                row.set_title(caps.text(skill, "label", self.guided()))
                row.set_subtitle(caps.text(skill, "detail", self.guided())
                                 if self.guided() else skill["id"])
        if self.guided():
            self._skills_heading.set_markup(
                "<span size='xx-large' weight='bold'>What should it help you with?</span>")
            self._skills_subtitle.set_text(
                "Pick whatever sounds useful. You can change this later, and "
                "none of it can do more than you allowed on the last screen."
            )
        else:
            self._skills_heading.set_markup(
                "<span size='xx-large' weight='bold'>What should it help you with?</span>")
            self._skills_subtitle.set_text(
                "Turn on the kinds of help you want. You can change this later."
            )

    # --- 5. done ------------------------------------------------------------

    def _done(self) -> Gtk.Widget:
        self.done_page = Adw.StatusPage(icon_name="emblem-ok-symbolic",
                                        title="Ready", description="")
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16,
                      halign=Gtk.Align.CENTER)
        self.sync_bar = Gtk.ProgressBar(show_text=True, visible=False)
        self.sync_bar.set_size_request(320, -1)
        box.append(self.sync_bar)
        button = pill("Start using teddyOS")
        button.connect("clicked", lambda *_: self.get_application().quit())
        box.append(button)
        self.done_page.set_child(box)
        return self.done_page

    # --- getting search ready, without a terminal ---------------------------

    def _start_corpus_download(self) -> None:
        """Fetch the search index here, because otherwise nobody ever does.

        Turning on "Search the web" grants permission; it does not download the
        index that makes search work. Until this existed, the machine told you
        so in the only place it could — as a note under an empty result list
        reading "run teddyos-search --sync". That sentence assumes a terminal,
        a command name and a flag, which is three things too many for the one
        feature this OS is built around. Somebody who has never opened a
        terminal simply had a search box that found nothing, forever.

        So the download happens as the last step of setup, where the person is
        already waiting and already being told what the machine is doing.

        Started detached, and deliberately: 68 MB is minutes on a slow line and
        nobody should be held on a setup screen for it. Clicking through closes
        this window while the download carries on to completion.
        """
        exe = shutil.which("teddyos-search")
        if not exe:
            return
        self.sync_bar.set_visible(True)
        self.sync_bar.set_text("Getting search ready…")
        self.sync_bar.set_fraction(0.0)

        def run() -> None:
            try:
                proc = subprocess.Popen(
                    [exe, "--sync"], stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                    text=True, bufsize=1, start_new_session=True)
            except OSError:
                GLib.idle_add(self.sync_bar.set_visible, False)
                return
            for line in proc.stdout:
                # The CLI prints running totals as plain "12 MB" lines.
                mb = "".join(ch for ch in line if ch.isdigit())
                if mb and "MB" in line:
                    done = int(mb)
                    GLib.idle_add(self._sync_progress, done)
            GLib.idle_add(self._sync_done, proc.wait() == 0)

        threading.Thread(target=run, daemon=True).start()

    def _sync_progress(self, done_mb: int) -> bool:
        # ~68 MB, but the total is not known until the server says so; cap the
        # bar rather than let it overshoot and look broken.
        self.sync_bar.set_fraction(min(done_mb / 68.0, 1.0))
        self.sync_bar.set_text(f"Getting search ready — {done_mb} MB of about 68")
        return GLib.SOURCE_REMOVE

    def _sync_done(self, ok: bool) -> bool:
        self.sync_bar.set_fraction(1.0 if ok else 0.0)
        self.sync_bar.set_text("Search is ready" if ok else
                               "Search will finish setting up in the background")
        if ok:
            # Say it, then go. A full bar reading "Search is ready" is finished
            # furniture — it answers a question nobody is asking any more, and
            # it sits directly above the only button on the screen. Long enough
            # to be read, then out of the way.
            #
            # Success only. The failure text is the one case where the bar still
            # carries information, so that one stays put.
            GLib.timeout_add(1800, self._sync_fade_out)
        return GLib.SOURCE_REMOVE

    def _sync_fade_out(self) -> bool:
        target = Adw.PropertyAnimationTarget.new(self.sync_bar, "opacity")
        anim = Adw.TimedAnimation.new(self.sync_bar, 1.0, 0.0, 420, target)
        anim.set_easing(Adw.Easing.EASE_IN_CUBIC)
        # Held on self, or it is collected mid-play and the bar stops
        # half-faded — the same trap as the intro animation.
        self._sync_anim = anim
        # Hidden only after the fade finishes, so the layout does not jump
        # while it is still visible.
        anim.connect("done", lambda *_: self.sync_bar.set_visible(False))
        anim.play()
        return GLib.SOURCE_REMOVE

    # --- helpers ------------------------------------------------------------

    def _page_box(self, heading: str, subtitle: str) -> Gtk.Box:
        """Returns the box; the heading label is stashed as box._heading."""
        # Wider margins and more air on first boot; the content itself is
        # clamped to a readable column by _scroll() rather than spanning the
        # display, because a settings row stretched across 2560px is unreadable
        # and looks nothing like a setup assistant.
        pad = 48 if getattr(self, "first_boot", False) else 32
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=18,
                      margin_top=pad, margin_bottom=pad,
                      margin_start=pad, margin_end=pad)
        title = Gtk.Label(xalign=0)
        title.set_markup(f"<span size='xx-large' weight='bold'>{heading}</span>")
        box.append(title)
        box._heading = title
        sub = Gtk.Label(xalign=0, wrap=True)
        sub.add_css_class("dim-label")
        sub.set_text(subtitle)
        box.append(sub)
        return box

    def _scroll(self, child: Gtk.Widget) -> Gtk.Widget:
        # AdwClamp is what keeps the journey a centred column at any width.
        clamp = Adw.Clamp(maximum_size=640, tightening_threshold=520)
        clamp.set_child(child)
        clamp.set_valign(Gtk.Align.CENTER)
        scroller = Gtk.ScrolledWindow(vexpand=True)
        scroller.set_child(clamp)
        return scroller

    def _choose_folder(self, _button) -> None:
        Gtk.FileDialog(title="Choose a folder teddyOS may search").select_folder(
            self, None, self._folder_chosen)

    def _folder_chosen(self, dialog, result) -> None:
        try:
            folder = dialog.select_folder_finish(result)
        except GLib.Error:
            return
        if folder and (path := folder.get_path()):
            if path not in self.workspace_paths:
                self.workspace_paths.append(path)
            self.folder_row.set_subtitle(", ".join(self.workspace_paths))

    def _finish(self, _button) -> None:
        granted = {cid: sw.get_active() for cid, sw in self.cap_switches.items()}
        # A granted capability with nothing selected is a switch that will do
        # nothing and look broken.
        if granted.get("workspace.index") and not self.workspace_paths:
            granted["workspace.index"] = False

        chosen_skills = [sid for sid, sw in self.skill_switches.items() if sw.get_active()]
        caps.save(granted, self.workspace_paths, self.level_id, chosen_skills)

        on = [c["label"] for c in caps.CAPABILITIES if granted.get(c["id"])]
        off = [c["label"] for c in caps.CAPABILITIES if not granted.get(c["id"])]
        lines = [("On: " + ", ".join(on)) if on else "Everything is off."]
        if off:
            lines.append("Off: " + ", ".join(off))
        lines.append(f"{len(chosen_skills)} kind(s) of help turned on.")
        # Never name a command here — the whole point of this screen is that
        # the person never needs one. Permissions is an app in the grid.
        lines.append("\nYou can change any of this later — look for Permissions.")
        self.done_page.set_description("\n".join(lines))
        self._go("done")

        # Granting "Search the web" is permission, not an index. Fetch it now
        # so the first search finds something.
        if granted.get("portal.sync"):
            self._start_corpus_download()

        # Diagnostics consent arms the log collector. Without this, the daily
        # timer would still fire but collect nothing — take one snapshot now
        # so a problem on day one is already in /var/log/teddyos/snapshots.
        if granted.get("diagnostics.share"):
            self._arm_diagnostics()
        else:
            log.info("diagnostics.share off — log collector stays idle")

    def _arm_diagnostics(self) -> None:
        """Start the snapshot timer and take one snapshot if we can.

        Best-effort: a live session without passwordless sudo still saved the
        grant to capabilities.json, and the next boot's timer will see it.
        """
        log.info("diagnostics.share on — arming log collector")
        try:
            Gio.Subprocess.new(
                ["systemctl", "--user", "start", "teddyos-log-collect.service"],
                Gio.SubprocessFlags.NONE,
            )
        except GLib.Error:
            pass
        # System timer is the real path (root). Prefer pkexec-free enable.
        for argv in (
            ["systemctl", "start", "teddyos-log-collect.service"],
            ["teddyos-log-collect"],
        ):
            try:
                Gio.Subprocess.new(argv, Gio.SubprocessFlags.NONE)
            except GLib.Error:
                continue


class SetupApp(Adw.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID,
                         flags=Gio.ApplicationFlags.HANDLES_COMMAND_LINE)
        self._first_boot = False

    def do_command_line(self, command_line):
        # --if-needed is what the first-boot autostart passes, so the journey
        # appears exactly once without a separate "have we run yet" file to
        # drift out of sync with the answers themselves.
        args = command_line.get_arguments()
        # --if-needed means "this is the first boot": autostart passes it, a
        # human running it from Settings does not. That is also what decides
        # fullscreen-journey vs ordinary-window.
        self._first_boot = "--if-needed" in args
        if self._first_boot and caps.is_configured():
            return 0
        self.activate()
        return 0

    def do_activate(self):
        log.info("setup open first_boot=%s", self._first_boot)
        (self.props.active_window
         or SetupWindow(self, first_boot=self._first_boot)).present()


if __name__ == "__main__":
    # X11 needs this, and X11 is exactly where this image ends up.
    #
    # GNOME binds a window to its launcher by WM_CLASS. Under Wayland that is the
    # GApplication id, which is what StartupWMClass in the .desktop already says.
    # Under X11 it comes from the program name instead — "teddyos-search-app" — so
    # the match fails, the running window does not light up its pinned dock tile,
    # and it appears a second time as a stray entry with a fallback icon.
    #
    # That was visible the moment the desktop came up on a machine with no GPU,
    # because a machine with no GPU is one running the X11 session. Setting prgname
    # to the application id makes both worlds agree.
    GLib.set_prgname(APP_ID)
    sys.exit(SetupApp().run(sys.argv))
