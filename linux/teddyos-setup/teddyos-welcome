#!/usr/bin/env python3
"""A short tour for someone who just sat down at teddyOS.

After setup, the wallpaper and dock appear with no explanation. Technical
people treat that as “ready.” Everyone else thinks “now what?” This window is
the answer: a few calm screens, one idea each, no jargon, no terminal, no
homework.

It is not a manual. Every important step either does something (opens Search)
or points at something already on screen (the bottom bar). Documentation is
where you send people when you have run out of product — we have not.
"""

from __future__ import annotations

import sys
from pathlib import Path

sys.path.insert(0, "/usr/lib/teddyos")
sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "teddyos-search"))

import gi  # noqa: E402

gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
from gi.repository import Adw, Gio, GLib, Gtk  # noqa: E402

import caps  # noqa: E402

APP_ID = "com.teddyos.Welcome"
SEEN = Path(
    __import__("os").environ.get("XDG_CONFIG_HOME", Path.home() / ".config")
) / "teddyos" / "welcome-seen"


def launch(argv: list[str]) -> None:
    try:
        Gio.Subprocess.new(argv, Gio.SubprocessFlags.NONE)
    except GLib.Error:
        pass


# One idea per page. Keep every sentence something a non-technical person
# would say out loud. No “helper”, “CLI”, “capability”, “OAuth”.
