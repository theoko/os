    def _on_broadcast_clicked(self) -> None:
        """Continue = setup if needed, else ask. One story for new users."""
        project = self._broadcast_project
        if project is None:
            return
        ready = work_tools.tools_ready_for_broadcast(
            self._broadcast_tools, self._credit_statuses,
        )
        entry = self._broadcast_entry
        prompt = (entry.get_text() if entry else "").strip()
        # Messaging actions: fixed draft prompt, not free-typed box.
        if getattr(self, "_linkedin_action", False):
            prompt = (
                getattr(self, "_pending_task", None)
                or engine.linkedin_reply_action_prompt()
            ).strip()
        elif getattr(self, "_whatsapp_action", False):
            prompt = (
                getattr(self, "_pending_task", None)
                or engine.whatsapp_reply_action_prompt()
            ).strip()

        if not ready:
            # Natural next step — no jargon, no separate app to invent.
            # Remember kind + original Search words so freeform/messaging
            # comes back after sign-in (not “work on home-folder-name”).
            if getattr(self, "_linkedin_action", False):
                kind = "linkedin"
            elif getattr(self, "_whatsapp_action", False):
                kind = "whatsapp"
            elif getattr(self, "_freeform_help", False):
                kind = "freeform"
            else:
                kind = "work"
            user_q = (getattr(self, "_user_query", None) or "").strip()
            if not user_q and entry is not None:
                # Project path: keep typed need as prompt, not as Search query.
                user_q = ""
            # Never persist the long internal playbook as the only restore key.
            store_prompt = prompt if kind == "work" else ""
            if kind == "freeform" and not store_prompt:
                store_prompt = (getattr(self, "_pending_task", None) or prompt or "").strip()
                # If freeform pending was already a long playbook, drop it.
                if len(store_prompt) > 280:
                    store_prompt = user_q or ""
            if kind in ("linkedin", "whatsapp"):
                store_prompt = ""
            if prompt and kind == "work":
                self._pending_task = prompt
            pending_ask.save(
                str(project),
                store_prompt,
                query=user_q or (prompt if kind == "freeform" else ""),
                kind=kind,
            )
            self._notify("Opening a short sign-in…", timeout=3)
            self._open_accounts(setup_all=True)
            return

        if not prompt:
            self._notify("Type what you need help with first.", timeout=3)
            if entry:
                entry.grab_focus()
            return
        log.info(
            "ask-all project=%s tools=%s prompt_len=%d linkedin=%s whatsapp=%s",
            project, [t.id for t in ready], len(prompt),
            bool(getattr(self, "_linkedin_action", False)),
            bool(getattr(self, "_whatsapp_action", False)),
        )
        if getattr(self, "_linkedin_action", False):
            self._open_linkedin_messaging()
            self._notify("Drafting LinkedIn replies… paste messages when asked.", timeout=4)
        elif getattr(self, "_whatsapp_action", False):
            self._open_whatsapp()
            self._notify("Drafting WhatsApp replies… paste messages when asked.", timeout=4)
        self._open_ask_all(project, prompt, [t.id for t in ready])

    def _auto_start_messaging_replies(self) -> bool:
        """One-shot: open Answers with the inbox draft playbook when ready."""
        linkedin = bool(getattr(self, "_linkedin_action", False))
        whatsapp = bool(getattr(self, "_whatsapp_action", False))
        if not (linkedin or whatsapp):
            return False
        project = self._broadcast_project
        if project is None:
            return False
        ready = work_tools.tools_ready_for_broadcast(
            self._broadcast_tools, self._credit_statuses,
        )
        if not ready:
            return False
        if linkedin:
            prompt = (
                getattr(self, "_pending_task", None)
                or engine.linkedin_reply_action_prompt()
            ).strip()
            self._open_linkedin_messaging()
            label = "LinkedIn"
        else:
            prompt = (
                getattr(self, "_pending_task", None)
                or engine.whatsapp_reply_action_prompt()
            ).strip()
            self._open_whatsapp()
            label = "WhatsApp"
        if not prompt:
            return False
        log.info(
            "%s auto-start tools=%s prompt_len=%d",
            label.lower(), [t.id for t in ready], len(prompt),
        )
        self._notify(
            f"Drafting replies — paste each {label} message when asked.",
            timeout=4,
        )
        self._open_ask_all(project, prompt, [t.id for t in ready])
        return False  # one-shot GLib timeout

