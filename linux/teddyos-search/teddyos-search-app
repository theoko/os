                    tool, project, recent=tool.id in recent and tool.is_ai,
                ))
            box.append(lb)

        # Subtle extras only after someone is signed in — not the first path.
        _section("Or pick one by name", chat_tools)
        _section("Apps", other_ai)
        _section("Also", open_with)

    def _refresh_broadcast_ui(self) -> None:
        # Wait for the first credit probe so we do not blast tools that are
        # already known empty. Empty statuses = still checking.
        probing = bool(self._broadcast_tools) and not self._credit_statuses
        ready = (
            []
            if probing
            else work_tools.tools_ready_for_broadcast(
                self._broadcast_tools, self._credit_statuses,
            )
        )
        names = ", ".join(t.title for t in ready) if ready else ""
        project = self._broadcast_project
        pname = project.name if project else "this project"

        if self._broadcast_title is not None:
            if probing:
                self._broadcast_title.set_text(f"Working on “{pname}”")
            elif not ready:
                self._broadcast_title.set_text(
                    f"Let’s get you ready to work on “{pname}”"
                )
            else:
                self._broadcast_title.set_text("What do you need help with?")

        if self._broadcast_step is not None:
            self._broadcast_step.set_text(
                "Almost ready" if not ready and not probing else "Start here"
            )

        if self._broadcast_hint is not None:
            if not self._broadcast_tools:
                self._broadcast_hint.set_text(
                    "This computer doesn’t have any AI set up yet. "
                    "Reinstall teddyOS, or ask whoever set up the machine."
                )
            elif probing:
                self._broadcast_hint.set_text("One moment…")
            elif not ready:
                self._broadcast_hint.set_text(
                    "Next we’ll open a short sign-in in your browser. "
                    "You only do this once. Then you can ask anything about "
                    f"“{pname}”."
                )
            elif len(ready) == 1:
                self._broadcast_hint.set_text(
                    "Type what you need. You’ll get an answer in a simple window."
                )
            else:
                self._broadcast_hint.set_text(
                    "Type what you need. You’ll get answers in one window."
                )

        if self._broadcast_entry is not None:
            # Don’t force a question before the person is signed in.
            self._broadcast_entry.set_visible(bool(ready) or probing)
            if ready:
                self._broadcast_entry.set_placeholder_text(
                    "e.g. Explain this project in simple words"
                )

        if self._broadcast_btn is not None:
            if probing:
                self._broadcast_btn.set_sensitive(False)
                self._broadcast_btn.set_label("One moment…")
            elif not ready:
                self._broadcast_btn.set_sensitive(True)
                self._broadcast_btn.set_label("Continue")
            else:
                self._broadcast_btn.set_sensitive(True)
                self._broadcast_btn.set_label("Get help")

        self._rebuild_advanced_options(ready=bool(ready), probing=probing)

    def _on_broadcast_clicked(self) -> None:
        """Continue = setup if needed, else ask. One story for new users."""
        project = self._broadcast_project
        if project is None:
            return
        ready = work_tools.tools_ready_for_broadcast(
            self._broadcast_tools, self._credit_statuses,
        )
        entry = self._broadcast_entry
        prompt = (entry.get_text() if entry else "").strip()

        if not ready:
            # Natural next step — no jargon, no separate app to invent.
            if prompt:
                self._pending_task = prompt
            pending_ask.save(str(project), prompt or "")
            self._notify("Opening a short sign-in…", timeout=3)
            self._open_accounts(setup_all=True)
            return

        if not prompt:
            self._notify("Type what you need help with first.", timeout=3)
            if entry:
                entry.grab_focus()
            return
        log.info(
            "ask-all project=%s tools=%s prompt_len=%d",
            project, [t.id for t in ready], len(prompt),
        )
        self._open_ask_all(project, prompt, [t.id for t in ready])

    def _begin_git_lookup(self, subject: str, generation: int) -> None:
        def work() -> None:
            try:
                repos = git_projects.find_remote_repos(subject)
                log.info("git lookup subject=%r hits=%d", subject, len(repos))
            except Exception as exc:  # noqa: BLE001
                log.exception("git lookup failed")
                repos = []
                err = str(exc)
            else:
                err = ""
            GLib.idle_add(
                self._show_git_repos, generation, subject, repos, err,
            )

        threading.Thread(target=work, daemon=True).start()

    def _show_git_repos(
        self,
        generation: int,
        subject: str,
        repos: list,
        err: str,
    ) -> bool:
        if generation != self._generation:
            return False
        # Drop the "looking…" notice; rebuild the work-goal block in place.
        child = self.results.get_first_child()
        while child:
            nxt = child.get_next_sibling()
            self.results.remove(child)
            child = nxt

        if err:
            self.results.append(self._notice_row(
                "Something went wrong while looking for that project online. "
                "Check your internet connection and try again.",
                "dialog-warning-symbolic",
            ))
            log.warning("git lookup error for %r: %s", subject, err)
        if not repos:
            self.results.append(self._notice_row(
                f"Couldn’t find a project named “{subject}” on this computer "
                "or in your GitHub account. Check the name, or put the folder "
                "in your home folder and try again.",
                "dialog-information-symbolic",
            ))
            self.stack.set_visible_child_name("results")
            return False

        self.results.append(self._section_label("On your GitHub — tap to download"))
        for repo in repos:
            self.results.append(self._clone_row(repo))
        self.stack.set_visible_child_name("results")
        return False

