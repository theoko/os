    log = logging.getLogger("teddyos.search-app")

APP_ID = "com.teddyos.Search"

# Queries run in `teddyos-search`, not in this process.
#
# This window is the only search anyone actually uses — it is the first icon in
# the dock — and the setup screen tells the user, in as many words, that a
# capability left off means "the computer stopping it, not teddyOS promising to
# behave". That sentence was false here. The CLI calls sandbox.reexec() before
# it touches a single source, so denied capabilities are absent from the
# process; this window called search.search() in-process, where a grant is only
# an `if` statement. One missed branch and a capability the user switched off is
# quietly on, which is precisely the failure the copy promises cannot happen.
#
# The window cannot simply sandbox itself: the namespace masks /home and cuts
# the network, and a GTK application that loses its home directory mid-flight
# loses its settings, its theme and its dconf. So the split is by job — the UI
# stays out here where it can draw, and everything that reads a file or opens a
# socket happens over there, inside the namespace.
SEARCH_CLI = "teddyos-search"

# Where a query goes when this machine cannot answer it.
#
# The corpus is a general crawl, so anything institution-specific — a college's
# Canvas, a company intranet, a bank — is not in it and never will be. A
# student typing "canvas" gets needlepoint, and that is not a ranking bug to
# fix; it is the corpus not containing their school. Better ranking would only
# return better needlepoint.
#
# So every search ends with a way out. It is always present, never a fallback
# that appears only on failure: "no results" is not the only case where what
# you wanted was on the open web, and a row that appears sometimes is a row
# nobody learns to look for.
WEB_SEARCH = "https://teddysearch.com/tsearch/?q="

SOURCE_LABEL = {
    "teddysearch": "on the web",
    "portal": "on the web",
    "your files": "your files",
    "built-in": "built-in help",
}


_worker: subprocess.Popen | None = None
_worker_lock = threading.Lock()


def _start_worker() -> subprocess.Popen | None:
    """Spawn the sandboxed worker and wait for it to say it is ready."""
    exe = shutil.which(SEARCH_CLI)
    if not exe:
        return None
    proc = subprocess.Popen(
        [exe, "--serve"],
        stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
        text=True, bufsize=1)
    # It prints {"ready":true} after entering the sandbox and warming the
    # corpus. Waiting for that here means the readiness cost is paid once, at
    # startup, instead of landing on whoever types first.
    line = proc.stdout.readline()
    if not line:
        proc.kill()
        return None
    return proc


def _decode(data: dict) -> engine.Outcome:
    # Tolerate a payload from a newer or older teddyos-search than this window:
    # take the fields Result declares and ignore the rest, rather than throwing
    # a TypeError into the worker thread and showing the user a traceback.
    fields = set(engine.Result.__dataclass_fields__)
    results = [
        engine.Result(**{k: v for k, v in row.items() if k in fields})
        for row in data.get("results", []) if isinstance(row, dict)
    ]
    return engine.Outcome(
        results=results,
        denied=data.get("denied", []),
        errors=data.get("errors", []),
        notes=data.get("notes", []),
        portal_age=data.get("portal_age_seconds"),
    )


def _confined_search(query: str) -> engine.Outcome:
    """Ask the sandboxed worker, starting or restarting it if needed.

    Everything that could read a file or open a socket happens over there, so a
    bug on this side cannot widen what the search was allowed to reach.

    One worker, not one per query. Spawning a process per keystroke meant the
    67 MB portal corpus was parsed and tokenised every single time — its cache
    is a module global and cannot outlive the process — which is what began
    OOM-killing the desktop on a live system.
    """
    global _worker
    with _worker_lock:
        for attempt in (1, 2):
            if _worker is None or _worker.poll() is not None:
                _worker = _start_worker()
            if _worker is None:
                # Refuse rather than degrade. Falling back to an in-process
                # search would work, look identical, and silently drop the
                # enforcement the setup screen promised — the one failure mode
                # worth being loud about.
                return engine.Outcome(errors=[
                    "Search could not be confined to what you allowed, so "
                    "nothing was searched."])
            try:
                _worker.stdin.write(query + "\n")
                _worker.stdin.flush()
                line = _worker.stdout.readline()
            except (BrokenPipeError, OSError):
                line = ""
            if line:
                try:
                    return _decode(json.loads(line))
                except json.JSONDecodeError:
                    return engine.Outcome(
                        errors=["The search returned nothing readable."])
            # Worker died mid-query. Reap it and try once more; a crash on one
            # query should not take search out for the rest of the session.
            if _worker is not None:
                _worker.kill()
                _worker = None
            if attempt == 2:
                return engine.Outcome(errors=[
                    "Search stopped unexpectedly and could not be restarted."])
    return engine.Outcome(errors=["Search did not answer."])


class SearchWindow(Adw.ApplicationWindow):
    def __init__(self, app: Adw.Application):
        super().__init__(application=app, title="Search")
        self.set_default_size(720, 480)
        # No title bar. There is exactly one control in this window and it is
        # the search field; a chrome bar above it holding three buttons and a
        # word is furniture around a thing that needs none. Escape closes,
        # because an undecorated window with no way out is a trap.
        self.set_decorated(False)
        esc = Gtk.EventControllerKey()
        esc.connect("key-pressed", self._on_key)
        self.add_controller(esc)

        # Bumped on every keystroke. A slow search that finishes after a newer
        # one must not overwrite it — without this, typing "nolan" can end up
        # showing results for "nol" because the bigger corpus answered later.
        self._generation = 0
        self._pending: str | None = None
        self._busy_timer: int | None = None
        # tool_id -> ActionRow, so a credit probe can update the subtitle after
        # the list is already on screen without rebuilding the whole stack.
        self._tool_rows: dict[str, Adw.ActionRow] = {}
        self._credit_generation = 0
        # tool_id -> base credit subtitle (without the "Recently used" tag), so
        # a late credit probe does not wipe the recency badge.
        self._credit_labels: dict[str, str] = {}

        self.entry = Gtk.SearchEntry(
            placeholder_text="Ask anything",
            hexpand=True,
        )
        self.entry.add_css_class("teddyos-ask")
        self.entry.connect("search-changed", self._on_typed)
        self.entry.connect("activate", lambda *_: self._run(self.entry.get_text()))

        # The field IS the window's top edge. Not inside a header bar — that
        # was a title widget in a bar whose only other job was drawing buttons
        # we no longer have.
        # A spinner beside the field, not replacing the results. Searching the
        # 67 MB corpus takes a second or two, and with no feedback the window
        # looks frozen — the same keystroke either did nothing or is still
        # working, and you cannot tell which. Beside the field rather than in
        # place of the list so that refining a query does not blank out the
        # results you are reading.
        self.spinner = Gtk.Spinner()
        self.spinner.set_valign(Gtk.Align.CENTER)
        self.spinner.set_margin_start(10)
        self.spinner.set_visible(False)

        top = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        top.append(self.entry)
        top.append(self.spinner)
        top.set_margin_top(14)
        top.set_margin_bottom(14)
        top.set_margin_start(16)
        top.set_margin_end(16)

        self.banner = Adw.Banner(button_label="Change permissions")
        self.banner.connect("button-clicked", self._open_setup)

        self.results = Gtk.ListBox(selection_mode=Gtk.SelectionMode.NONE)
        self.results.add_css_class("boxed-list")
        self.results.set_margin_top(12)
        self.results.set_margin_bottom(24)
        self.results.set_margin_start(18)
        self.results.set_margin_end(18)

        scroller = Gtk.ScrolledWindow(vexpand=True)
        scroller.set_child(Adw.Clamp(maximum_size=760, child=self.results))

        # Empty state: one quiet line, no illustration. A 180px magnifier above
        # the words "Ask anything" next to a field that already says "Ask
        # anything" is the same instruction three times, and it fills the window
        # with something to look at instead of leaving it calm.
        self.status = Gtk.Label(wrap=True, justify=Gtk.Justification.CENTER)
        self.status.add_css_class("dim-label")
        self.status.set_vexpand(True)
        self.status.set_valign(Gtk.Align.CENTER)
        self.status.set_text(self._idle_description())

        self.stack = Gtk.Stack()
        self.stack.add_named(self.status, "idle")
        self.stack.add_named(scroller, "results")
        self.stack.set_visible_child_name("idle")

        body = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        body.append(self.banner)
        body.append(self.stack)

        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        outer.append(top)
        outer.append(body)
        # Toast overlay so "Opening Gemini…" is visible when a click works —
        # without it, a slow window or a Terminal that opens behind Search
        # looks exactly like a dead button.
        self._toasts = Adw.ToastOverlay()
        self._toasts.set_child(outer)
        self.set_content(self._toasts)

        css = Gtk.CssProvider()
        css.load_from_data(b"""
            .teddyos-ask { font-size: 20px; padding: 10px 8px; }
            window { border-radius: 14px; }
        """)
        Gtk.StyleContext.add_provider_for_display(
            self.get_display(), css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

        self._refresh_banner()
        self.entry.grab_focus()
        log.info("search-app ready (launch=terminal-first for TTY tools)")

    def _on_key(self, _c, keyval, _code, _state) -> bool:
        if keyval == Gdk.KEY_Escape:
            self.close()
            return True
        return False

    # --- what the machine is currently allowed to do ------------------------

    def _idle_description(self) -> str:
        grants = caps.load()
        on = [caps.text(c, "label", True) for c in caps.CAPABILITIES
              if grants.get(c["id"])]
        if not on:
            return "Nothing is switched on yet, so there is nowhere to look."
        return "Searching " + ", ".join(on).lower() + "."

    def _refresh_banner(self) -> None:
        grants = caps.load()
        off = [caps.text(c, "label", True) for c in caps.CAPABILITIES
               if not grants.get(c["id"])]
        if off:
            # An offer, not a warning. These are choices the user made, and the
            # only reason to mention them is that "no results" and "no results
            # because I was not allowed to look" are indistinguishable.
            self.banner.set_title(
                f"Turned off: {', '.join(off).lower()} — open settings to change")
            self.banner.set_revealed(True)
        else:
            self.banner.set_revealed(False)

    def _open_setup(self, *_a) -> None:
        try:
            Gio.Subprocess.new(["teddyos-setup"], Gio.SubprocessFlags.NONE)
        except GLib.Error:
            pass

    # --- searching ----------------------------------------------------------

    def _on_typed(self, entry: Gtk.SearchEntry) -> None:
        text = entry.get_text().strip()
        if not text:
            self._generation += 1          # cancel anything in flight
            self._cancel_busy()
            self.status.set_text(self._idle_description())
            self.stack.set_visible_child_name("idle")
            return
        self._run(text)

    def _run(self, query: str) -> None:
        query = query.strip()
        if not query:
            return
        self._generation += 1
        generation = self._generation
        self._begin_busy(generation)
        log.info("query=%r", query)

        def work() -> None:
            try:
                outcome = _confined_search(query)
                log.info(
                    "results=%d denied=%s errors=%d work_goal=%s",
                    len(outcome.results), outcome.denied, len(outcome.errors),
                    engine.is_work_goal(query),
                )
            except Exception as exc:  # noqa: BLE001 - never kill the UI thread
                log.exception("search failed for %r", query)
                outcome = engine.Outcome(errors=[str(exc)])
            GLib.idle_add(self._show, generation, query, outcome)

        # Daemon: a 67 MB parse in flight must not keep the app alive after the
        # window is closed.
        threading.Thread(target=work, daemon=True).start()

    def _begin_busy(self, generation: int) -> None:
        """Show the spinner, but only if the search is slow enough to notice.

        A spinner that appears and vanishes inside 100ms is a flicker, not
        feedback — and searches that hit only the small index do finish that
        fast. The delay means the indicator appears exactly when there is
        something to wait for.
        """
        self._cancel_busy()
        self._busy_timer = GLib.timeout_add(120, self._enter_busy, generation)

    def _enter_busy(self, generation: int) -> bool:
        self._busy_timer = None
        if generation == self._generation:
            self.spinner.set_visible(True)
            self.spinner.start()
            if self.stack.get_visible_child_name() == "idle":
                self.status.set_text("Searching…")
        return False  # one-shot

    def _cancel_busy(self) -> None:
        if self._busy_timer is not None:
            GLib.source_remove(self._busy_timer)
            self._busy_timer = None
        self.spinner.stop()
        self.spinner.set_visible(False)

    def _show(self, generation: int, query: str, outcome) -> bool:
        if generation != self._generation:
            return False  # a newer query already answered
        self._cancel_busy()

        child = self.results.get_first_child()
        while child:
            self.results.remove(child)
            child = self.results.get_first_child()

        # "i wanna work on iakovos-trading" is a goal, not a document lookup.
        # Offer AI tools (and Files) first; document hits stay below as backup.
        work = self._work_goal_block(query)
        if work:
            for row in work:
                self.results.append(row)

        if not outcome.results and not work:
            # Not an empty screen. "Nothing found" with no next step is where
            # someone gives up; the same screen with one obvious action is not.
            #
            # And the reason comes FIRST when there is nothing else. An empty
            # list reads as "this is broken"; an empty list under a sentence
            # saying the index is still downloading reads as "wait a minute".
            self._append_notices(outcome)
            self.results.append(self._web_row(query))
            self.stack.set_visible_child_name("results")
            self._refresh_banner()
            return False

        if outcome.results:
            if work:
                # A quiet divider so "open with Claude" is not mistaken for a
                # search hit about Claude.
                self.results.append(self._section_label("Also found"))
            for res in outcome.results:
                self.results.append(self._row(res))
        self._append_notices(outcome)
        if not work:
            self.results.append(self._web_row(query))
        self.stack.set_visible_child_name("results")
        self._refresh_banner()
        return False

    def _section_label(self, text: str) -> Gtk.Widget:
        row = Adw.ActionRow(title=GLib.markup_escape_text(text))
        row.add_css_class("dim-label")
        row.set_activatable(False)
        return row

    def _work_goal_block(self, query: str) -> list[Gtk.Widget]:
        """Rows that open a project with an AI tool, or explain why not.

        Returns an empty list when the query is ordinary search — the rest of
        _show then behaves as before.
        """
        if not engine.is_work_goal(query):
            return []
        subject = engine.focus_query(query)
        if not subject:
            return []

        projects = engine.resolve_project_dirs(subject)
        tools = work_tools.available_work_tools()
        rows: list[Gtk.Widget] = []
        self._tool_rows = {}
        self._credit_labels = {}

        if projects:
            self._append_project_tools(rows, projects, tools)
            self._begin_credit_probes(tools)
            return rows

        # No local folder — try the person's GitHub when they are signed in.
        auth = git_projects.git_auth()
        if not auth.ok:
            rows.append(self._notice_row(
                f"There isn’t a folder called “{subject}” on this computer yet. "
                "If it lives in your GitHub account, connect GitHub once, then "
                "try again. Or copy the project folder into your home folder.",
                "dialog-information-symbolic",
            ))
            # One clear button beats "run this command in a terminal".
            rows.append(self._github_connect_row())
            return rows

        who = f" as {auth.login}" if auth.login else ""
        rows.append(self._notice_row(
            f"There isn’t a folder called “{subject}” here. "
            f"Checking your GitHub projects{who}…",
            "emblem-synchronizing-symbolic",
        ))
        self._begin_git_lookup(subject, generation=self._generation)
        return rows

    def _append_project_tools(
        self,
        rows: list[Gtk.Widget],
        projects: list[Path],
        tools: list[WorkTool],
    ) -> None:
        recent = set(work_tools.recent_ids())
        for project in projects[:5]:
            label = project.name
            parent = str(project.parent).replace(str(Path.home()), "~")
            rows.append(self._section_label(f"Work on “{label}”"))
            recent_tools = [t for t in tools if t.is_ai and t.id in recent]
            other_tools = [t for t in tools if t not in recent_tools]
            # Split AI helpers from Files/Terminal so a machine with only
            # Claude does not look like Claude is the entire product.
            ai_recent = [t for t in recent_tools if t.is_ai]
            ai_other = [t for t in other_tools if t.is_ai]
            open_with = [t for t in other_tools if not t.is_ai]
            if ai_recent:
                rows.append(self._section_label("Recently used"))
                for tool in ai_recent:
                    rows.append(self._tool_row(tool, project, recent=True))
            if ai_other:
                rows.append(self._section_label(
                    "AI helpers" if not ai_recent else "More AI helpers"))
                for tool in ai_other:
                    rows.append(self._tool_row(
                        tool, project, recent=tool.id in recent))
            if open_with:
                rows.append(self._section_label("Also open with"))
                for tool in open_with:
                    rows.append(self._tool_row(tool, project, recent=False))

    def _begin_git_lookup(self, subject: str, generation: int) -> None:
        def work() -> None:
            try:
                repos = git_projects.find_remote_repos(subject)
                log.info("git lookup subject=%r hits=%d", subject, len(repos))
            except Exception as exc:  # noqa: BLE001
                log.exception("git lookup failed")
                repos = []
                err = str(exc)
            else:
                err = ""
            GLib.idle_add(
                self._show_git_repos, generation, subject, repos, err,
            )

        threading.Thread(target=work, daemon=True).start()

    def _show_git_repos(
        self,
        generation: int,
        subject: str,
        repos: list,
        err: str,
    ) -> bool:
        if generation != self._generation:
            return False
        # Drop the "looking…" notice; rebuild the work-goal block in place.
        child = self.results.get_first_child()
        while child:
            nxt = child.get_next_sibling()
            self.results.remove(child)
            child = nxt

        if err:
            self.results.append(self._notice_row(
                "Something went wrong while looking for that project online. "
                "Check your internet connection and try again.",
                "dialog-warning-symbolic",
            ))
            log.warning("git lookup error for %r: %s", subject, err)
        if not repos:
            self.results.append(self._notice_row(
                f"Couldn’t find a project named “{subject}” on this computer "
                "or in your GitHub account. Check the name, or put the folder "
                "in your home folder and try again.",
                "dialog-information-symbolic",
            ))
            self.stack.set_visible_child_name("results")
            return False

        self.results.append(self._section_label("On your GitHub — tap to download"))
        for repo in repos:
            self.results.append(self._clone_row(repo))
        self.stack.set_visible_child_name("results")
        return False

    def _github_connect_row(self) -> Gtk.Widget:
        """One-tap path to connect GitHub without memorizing a command."""
        row = Adw.ActionRow(title="Connect GitHub")
        row.set_subtitle("Opens a short sign-in so teddyOS can download your projects")
        row.set_subtitle_lines(2)
        row.add_prefix(Gtk.Image.new_from_icon_name("user-info-symbolic"))
        row.add_suffix(Gtk.Image.new_from_icon_name("go-next-symbolic"))
        row.set_activatable(True)
        row.connect("activated", lambda *_: self._start_github_connect())
        return row

    def _start_github_connect(self) -> None:
        """Launch GitHub sign-in in a window the person can follow.

        They should not have to invent a command. Prefer Terminal so the
        browser/code steps from GitHub are visible; fall back to a plain
        notice if nothing can run.
        """
        log.info("start github connect")
        if not shutil.which("gh"):
            self.results.append(self._notice_row(
                "This copy of teddyOS can’t connect to GitHub yet. "
                "Ask whoever set up the computer to install GitHub tools, "
                "or copy the project folder into your home folder.",
                "dialog-information-symbolic",
            ))
            return
        # Interactive sign-in needs a real terminal window.
        candidates = []
        if shutil.which("gnome-terminal"):
            candidates.append(["gnome-terminal", "--", "gh", "auth", "login"])
        if shutil.which("kgx"):
            candidates.append(["kgx", "-e", "gh auth login"])
        for argv in candidates:
            try:
                Gio.Subprocess.new(argv, Gio.SubprocessFlags.NONE)
                return
            except GLib.Error:
                continue
        self.results.append(self._notice_row(
            "Open the Terminal app and ask for help connecting GitHub, "
            "then try your search again.",
            "dialog-information-symbolic",
        ))

    def _clone_row(self, repo: git_projects.RemoteRepo) -> Gtk.Widget:
        # Human title: "tsearch-revival" is enough; owner/name is secondary.
        title = f"Download “{repo.name}”"
        sub = repo.description.strip() if repo.description else f"From {repo.full_name}"
        if repo.description:
            sub = f"{sub} · {repo.full_name}"
        row = Adw.ActionRow(title=GLib.markup_escape_text(title))
        row.set_subtitle(GLib.markup_escape_text(sub[:160]))
        row.set_subtitle_lines(2)
        row.add_prefix(Gtk.Image.new_from_icon_name("folder-download-symbolic"))
        row.add_suffix(Gtk.Image.new_from_icon_name("go-next-symbolic"))
        row.set_activatable(True)
        row.connect("activated", lambda *_a, r=repo: self._clone_and_open(r))
        return row

    def _clone_and_open(self, repo: git_projects.RemoteRepo) -> None:
        log.info("clone %s", repo.full_name)
        # Replace the list with a single status row while git runs.
        child = self.results.get_first_child()
        while child:
            nxt = child.get_next_sibling()
            self.results.remove(child)
            child = nxt
        self.results.append(self._notice_row(
            f"Downloading “{repo.name}” to this computer…",
            "emblem-synchronizing-symbolic",
        ))
        self.stack.set_visible_child_name("results")
        generation = self._generation

        def work() -> None:
            path, message = git_projects.clone_repo(repo)
            GLib.idle_add(
                self._after_clone, generation, repo, path, message,
            )

        threading.Thread(target=work, daemon=True).start()

    def _after_clone(
        self,
        generation: int,
        repo: git_projects.RemoteRepo,
        path: Path | None,
        message: str,
    ) -> bool:
        if generation != self._generation:
            return False
        child = self.results.get_first_child()
        while child:
            nxt = child.get_next_sibling()
            self.results.remove(child)
            child = nxt
        if path is None:
            log.warning("clone failed: %s", message)
            self.results.append(self._notice_row(
                f"Couldn’t download “{repo.name}”. "
                "Check your internet connection and that you still have access "
                "to the project, then try again.",
                "dialog-warning-symbolic",
            ))
            self.stack.set_visible_child_name("results")
            return False

        log.info("cloned %s → %s (%s)", repo.full_name, path, message)
        tools = work_tools.available_work_tools()
        rows: list[Gtk.Widget] = []
        self._tool_rows = {}
        self._credit_labels = {}
        where = str(path).replace(str(Path.home()), "~")
        self.results.append(self._notice_row(
            f"“{repo.name}” is ready on this computer ({where}). "
            "Choose how you want to open it.",
            "emblem-ok-symbolic",
        ))
        self._append_project_tools(rows, [path], tools)
        for row in rows:
            self.results.append(row)
        self._begin_credit_probes(tools)
        self.stack.set_visible_child_name("results")
        return False

    def _tool_row(
        self, tool: WorkTool, project: Path, *, recent: bool = False
    ) -> Gtk.Widget:
        row = Adw.ActionRow(title=GLib.markup_escape_text(tool.title))
        # Metered AI: probe fills in plan status. Free AI (VS Code, Ollama): ready.
        # Files / Terminal are not plans — keep the action subtitle.
        if tool.metered:
            base = "Checking your plan…"
        elif tool.is_ai:
            base = "Ready to use"
        else:
            base = tool.subtitle
        self._credit_labels[tool.id] = base
        row.set_subtitle(GLib.markup_escape_text(
            self._format_tool_subtitle(tool.id, base, recent)))
        row.set_subtitle_lines(2)
        row.add_prefix(self._tool_icon(tool.icon))
        if recent:
            badge = Gtk.Label(label="Recently used")
            badge.add_css_class("caption")
            badge.add_css_class("dim-label")
            badge.set_valign(Gtk.Align.CENTER)
            row.add_suffix(badge)
        row.add_suffix(Gtk.Image.new_from_icon_name("go-next-symbolic"))
        row.set_activatable(True)
        row.connect(
            "activated",
            lambda *_a, t=tool, p=project: self._launch_tool(t, p),
        )
        # Last project wins for multi-match UIs; that is fine — credit status
        # is per tool, not per folder.
        self._tool_rows[tool.id] = row
        return row

    def _tool_icon(self, name: str) -> Gtk.Image:
        """Load a work-tool icon from the theme, with a file fallback.

        The live image installs teddyos-*.svg into hicolor. A guest that was
        upgraded without re-baking the icon cache still needs a picture — so
        we also try the on-disk SVG path. Never leave a blank square for the
        three AI tools that are the whole point of this list.
        """
        img = Gtk.Image()
        img.set_pixel_size(32)
        theme = Gtk.IconTheme.get_for_display(self.get_display())
        if theme and theme.has_icon(name):
            img.set_from_icon_name(name)
            return img
        for base in (
            Path("/usr/share/icons/hicolor/scalable/apps"),
            Path(__file__).resolve().parent.parent / "icons",
        ):
            svg = base / f"{name}.svg"
            if svg.is_file():
                try:
                    img.set_from_file(str(svg))
                    return img
                except GLib.Error:
                    pass
        img.set_from_icon_name("application-x-executable")
        return img

    def _format_tool_subtitle(
        self, tool_id: str, credit_label: str, recent: bool | None = None
    ) -> str:
        if recent is None:
            recent = work_tools.is_recent(tool_id)
        # Credit line is the substance; "Recently used" is also a section
        # header, so only repeat it in the subtitle when the row is not already
        # under that section — still useful as a suffix on "All tools".
        label = (credit_label or "").strip()
        if recent and label:
            return f"{label} · Recently used"
        if recent:
            return "Recently used"
        return label

    def _begin_credit_probes(self, tools: list[WorkTool]) -> None:
        # Probe everything that is metered, plus free AI tools that still have
        # a probe (so "Installed · …" can replace "No credits needed" when
        # that is more honest).
        to_probe = [t for t in tools if t.is_ai]
        if not to_probe:
            return
        self._credit_generation += 1
        generation = self._credit_generation

        def work() -> None:
            statuses = {t.id: work_tools.probe_credits(t) for t in to_probe}
            GLib.idle_add(self._apply_credit_statuses, generation, statuses)

        threading.Thread(target=work, daemon=True).start()

    def _apply_credit_statuses(
        self,
        generation: int,
        statuses: dict[str, CreditStatus],
    ) -> bool:
        if generation != self._credit_generation:
            return False  # a newer goal already replaced the list
        for tool_id, status in statuses.items():
            row = self._tool_rows.get(tool_id)
            if row is None:
                continue
            self._credit_labels[tool_id] = status.label
            row.set_subtitle(GLib.markup_escape_text(
                self._format_tool_subtitle(tool_id, status.label)))
            # Dim and still clickable when empty: the person may want to open
            # Claude to top up or re-login. A hard-disabled row looks broken.
            if status.ok is False:
                row.add_css_class("dim-label")
            else:
                row.remove_css_class("dim-label")
        return False

    # Terminal AI tools that die without a TTY. Never bare-spawn these.
    _TTY_TOOLS = frozenset({
        "claude", "grok", "gemini", "codex", "aider", "ollama", "crush", "goose",
    })

    def _notify(self, message: str, *, timeout: int = 3) -> None:
        """Short on-screen confirmation that a click did something."""
        try:
            toast = Adw.Toast.new(message)
            toast.set_timeout(timeout)
            self._toasts.add_toast(toast)
        except Exception:  # noqa: BLE001
            pass

    def _launch_tool(self, tool: WorkTool, project: Path) -> None:
        # Record before spawn so a crashy tool still counts as a choice.
        work_tools.record_use(tool.id)
        path = str(project)
        self._notify(f"Opening {tool.title}…")

        # Non-technical first: never drop people into a raw Terminal.
        # 1) Claude → dedicated app window.
        # 2) Other TTY AI → teddyos-agent (app chrome + plain-language hint).
        # 3) gnome-terminal only as a last resort if the agent binary is gone.
        # 4) Non-TTY tools (Files, VS Code, …) use their normal argv.
        # Never bare-spawn gemini/codex/grok — no TTY, dies, looks dead.
        ok = False
        if tool.id == "claude" and shutil.which("teddyos-claude"):
            ok = self._spawn(["teddyos-claude", path], cwd=path)
        if not ok and tool.id in self._TTY_TOOLS:
            agent = shutil.which("teddyos-agent")
            if agent:
                ok = self._spawn([agent, tool.id, path], cwd=path)
        if not ok and tool.id in self._TTY_TOOLS:
            ok = self._launch_via_terminal(tool, path)
        if not ok:
            argv = self._launch_argv(tool, path)
            ok = self._spawn(argv, cwd=path)
        if ok:
            # Get out of the way so the helper isn’t hidden behind Search.
            GLib.timeout_add(250, self._yield_to_launched_app)
            return
        log.error("all launch paths failed tool=%s project=%s", tool.id, path)
        self._notify(
            f"Couldn’t open {tool.title}. Try again in a moment.",
            timeout=5,
        )
        try:
            Gtk.UriLauncher.new(
                Gio.File.new_for_path(path).get_uri()
            ).launch(self, None, None, None)
        except GLib.Error:
            pass

    def _yield_to_launched_app(self) -> bool:
        """Minimize Search so the tool window is not hidden behind it."""
        try:
            self.minimize()
        except Exception:  # noqa: BLE001
            try:
                self.set_visible(False)
                GLib.timeout_add_seconds(30, self._restore_after_hide)
            except Exception:  # noqa: BLE001
                pass
        return False

    def _restore_after_hide(self) -> bool:
        try:
            self.set_visible(True)
            self.present()
        except Exception:  # noqa: BLE001
            pass
        return False

    def _spawn(self, argv: list[str], *, cwd: str) -> bool:
        """Start a GUI/terminal child with the desktop session’s environment."""
        if not argv or not argv[0]:
            return False
        # Resolve bare names so a thin PATH cannot hide /usr/local/bin tools.
        if "/" not in argv[0]:
            found = shutil.which(argv[0])
            if not found:
                log.error("spawn: not on PATH: %s", argv[0])
                return False
            argv = [found, *argv[1:]]
        log.info("launch argv=%s cwd=%s", argv, cwd)
        try:
            launcher = Gio.SubprocessLauncher.new(Gio.SubprocessFlags.NONE)
            launcher.set_cwd(cwd)
            path_env = os.environ.get("PATH", "/usr/bin:/bin")
            for extra in ("/usr/local/bin", str(Path.home() / ".local" / "bin")):
                if extra not in path_env.split(":"):
                    path_env = f"{extra}:{path_env}"
            launcher.setenv("PATH", path_env, True)
            for key in (
                "DISPLAY", "WAYLAND_DISPLAY", "XDG_RUNTIME_DIR",
                "DBUS_SESSION_BUS_ADDRESS", "HOME", "USER", "LANG",
                "XAUTHORITY", "GDK_BACKEND",
            ):
                val = os.environ.get(key)
                if val:
                    launcher.setenv(key, val, True)
            launcher.spawnv(argv)
            return True
        except GLib.Error as exc:
            log.error("spawn failed argv=%s: %s", argv, exc.message)
            # Gio sometimes fails where a plain detached Popen still works.
            try:
                env = os.environ.copy()
                env["PATH"] = (
                    "/usr/local/bin:"
                    + str(Path.home() / ".local" / "bin")
                    + ":"
                    + env.get("PATH", "/usr/bin:/bin")
                )
                subprocess.Popen(  # noqa: S603
                    argv,
                    cwd=cwd,
                    env=env,
                    start_new_session=True,
                    stdin=subprocess.DEVNULL,
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL,
                )
                log.info("spawn via Popen argv=%s", argv)
                return True
            except OSError as exc2:
                log.error("Popen failed argv=%s: %s", argv, exc2)
                return False

    def _launch_argv(self, tool: WorkTool, path: str) -> list[str]:
        """Build argv for non-TTY tools (Files, editors, …)."""
        raw = [a.replace("{path}", path) for a in tool.argv]
        argv: list[str] = []
        for part in raw:
            if " " in part and not Path(part).exists():
                argv.extend(part.split())
            else:
                argv.append(part)
        return argv

    def _launch_via_terminal(self, tool: WorkTool, path: str) -> bool:
        """Open a real Terminal window running the tool in the project folder.

        Gemini and Codex need a TTY. gnome-terminal always draws a window on
        this desktop; a custom VTE host has failed silently more than once
        (window on a wrong session, or behind Search with no feedback).
        """
        binary = {
            "gemini": "gemini",
            "codex": "codex",
            "grok": "grok",
            "claude": "claude",
            "aider": "aider",
            "ollama": "ollama",
            "crush": "crush",
            "goose": "goose",
        }.get(tool.id)
        if not binary:
            return False
        resolved = shutil.which(binary)
        if not resolved:
            # npm tools live here even when GUI PATH is thin.
            for prefix in ("/usr/local/bin", str(Path.home() / ".local" / "bin")):
                candidate = Path(prefix) / binary
                if candidate.is_file() and os.access(candidate, os.X_OK):
                    resolved = str(candidate)
                    break
        if not resolved:
            log.error("terminal launch: binary missing tool=%s", tool.id)
            return False

        title = f"{tool.title} — {Path(path).name}"
        term = shutil.which("gnome-terminal") or shutil.which("kgx")
        if not term:
            log.error("terminal launch: no gnome-terminal/kgx")
            return False
        if "gnome-terminal" in term:
            # -- is required so gemini/codex flags are not eaten by the terminal.
            argv = [
                term,
                f"--title={title}",
                f"--working-directory={path}",
                "--",
                resolved,
            ]
        else:
            # kgx: run via a short shell so cwd sticks.
            argv = [
                term,
                f"--title={title}",
                "-e",
                f"bash -lc {shlex.quote(f'cd {path} && exec {resolved}')}",
            ]
        return self._spawn(argv, cwd=path)

    def _append_notices(self, outcome) -> None:
        """Show what the search knows about its own limits.

        The engine already works out why a search came back thin — the index is
        still downloading, a source errored, a capability is off — and returns
        it in Outcome.notes/errors. This window used to drop all of it on the
        floor, so someone who searched and got nothing was shown an empty list
        and no reason, while the CLI printed the explanation to a terminal
        nobody was looking at.

        That is the difference between "this is broken" and "this is not ready
        yet", and the machine already knew which.
        """
        for text in getattr(outcome, "errors", []) or []:
            self.results.append(self._notice_row(text, "dialog-warning-symbolic"))
        for text in getattr(outcome, "notes", []) or []:
            self.results.append(self._notice_row(text, "dialog-information-symbolic"))

    def _notice_row(self, text: str, icon: str) -> Gtk.Widget:
        row = Adw.ActionRow(title=GLib.markup_escape_text(text))
        row.set_title_lines(3)
        row.add_prefix(Gtk.Image.new_from_icon_name(icon))
        row.add_css_class("dim-label")
        # Not activatable: it is an explanation, and a row that looks clickable
        # and does nothing is worse than one that plainly does not.
        row.set_activatable(False)
        return row

    def _row(self, res) -> Gtk.Widget:
        row = Adw.ActionRow(title=GLib.markup_escape_text(res.title))
        snippet = " ".join((res.snippet or "").split())[:160]
        row.set_subtitle(GLib.markup_escape_text(snippet))
        row.set_subtitle_lines(2)

        badge = Gtk.Label(label=SOURCE_LABEL.get(res.source, res.source))
        badge.add_css_class("caption")
        badge.add_css_class("dim-label")
        badge.set_valign(Gtk.Align.CENTER)
        row.add_suffix(badge)
        row.add_suffix(Gtk.Image.new_from_icon_name("go-next-symbolic"))

        row.set_activatable(True)
        row.connect("activated", lambda *_a, r=res: self._open(r))
        return row

    def _web_row(self, query: str) -> Gtk.Widget:
        # Truncate. The title interpolates the query, and a stuck key or a
        # pasted paragraph turns one row into a wall of text taller than the
        # window — found exactly that way. The full query still goes to the
        # web search; only the label is shortened.
        shown = query if len(query) <= 48 else query[:48].rstrip() + "…"
        row = Adw.ActionRow(
            title=f"Search the web for “{GLib.markup_escape_text(shown)}”")
        row.set_title_lines(1)
        row.set_subtitle(
            "Opens a browser search for things that are not on this computer "
            "(school sites, work tools, and the open web)")
        row.set_subtitle_lines(2)
        row.add_prefix(Gtk.Image.new_from_icon_name("web-browser-symbolic"))
        row.add_suffix(Gtk.Image.new_from_icon_name("go-next-symbolic"))
        row.set_activatable(True)
        row.connect("activated", lambda *_a: self._open_web(query))
        return row

    def _open_web(self, query: str) -> None:
        try:
            Gtk.UriLauncher.new(WEB_SEARCH + GLib.uri_escape_string(query, None, True)) \
                .launch(self, None, None, None)
        except GLib.Error:
            pass

    def _open(self, res) -> None:
        target = res.url
        if not target:
            return
        # A local file has no scheme; handing a bare path to the URI opener
        # silently does nothing, which looks exactly like a dead row.
        if not target.startswith(("http://", "https://", "file://")):
            target = Gio.File.new_for_path(target).get_uri()
        try:
            Gtk.UriLauncher.new(target).launch(self, None, None, None)
        except GLib.Error:
            pass


class SearchApp(Adw.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID)

    def do_activate(self):
        (self.props.active_window or SearchWindow(self)).present()


if __name__ == "__main__":
    # X11 needs this, and X11 is exactly where this image ends up.
    #
    # GNOME binds a window to its launcher by WM_CLASS. Under Wayland that is the
    # GApplication id, which is what StartupWMClass in the .desktop already says.
    # Under X11 it comes from the program name instead — "teddyos-search-app" — so
    # the match fails, the running window does not light up its pinned dock tile,
    # and it appears a second time as a stray entry with a fallback icon.
    #
    # That was visible the moment the desktop came up on a machine with no GPU,
    # because a machine with no GPU is one running the X11 session. Setting prgname
    # to the application id makes both worlds agree.
    GLib.set_prgname(APP_ID)
    sys.exit(SearchApp().run(sys.argv))
