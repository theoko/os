        return row

    def _on_tool_activated(self, tool: WorkTool, project: Path) -> None:
        """Open the app, or start sign-in if it still needs an account."""
        status = self._credit_statuses.get(tool.id)
        if (
            tool.metered
            and status is not None
            and status.ok is False
            and "not on this computer" not in (status.label or "").lower()
        ):
            # Needs sign-in — never dump them into a failing TUI.
            self._notify(
                f"{tool.title} needs a quick sign-in first…",
                timeout=3,
            )
            if self._open_accounts(tool.id):
                return
        self._launch_tool(tool, project)

    def _open_accounts(
        self,
        focus_id: str | None = None,
        *,
        setup_all: bool = False,
    ) -> bool:
        """Open Getting you ready (sign-in walkthrough)."""
        exe = shutil.which("teddyos-accounts")
        if not exe:
            return False
        argv = [exe]
        if setup_all:
            argv.append("--setup-all")
        elif focus_id:
            argv.extend(["--connect", focus_id])
        # Don’t dismiss Search under the sign-in window; re-probe when back.
        self._hold_for_dialog = True
        self._reprobe_on_focus = True
        ok = self._spawn(argv, cwd=str(Path.home()))
        if not ok:
            self._hold_for_dialog = False
            self._reprobe_on_focus = False
        return ok

