    def _tool_icon(self, name: str) -> Gtk.Image:
        """Load a work-tool icon from the theme, with a file fallback.

        The live image installs teddyos-*.svg into hicolor. A guest that was
        upgraded without re-baking the icon cache still needs a picture — so
        we also try on-disk SVG/PNG. Symbolic names (folder-symbolic) stay
        theme-only. Never leave a blank square.
        """
        img = Gtk.Image()
        img.set_pixel_size(32)
        name = (name or "").strip() or "application-x-executable"
        theme = Gtk.IconTheme.get_for_display(self.get_display())
        if theme and theme.has_icon(name):
            img.set_from_icon_name(name)
            return img
        # Symbolic / generic GNOME names
        if name.endswith("-symbolic") or "/" not in name and not name.startswith("teddyos-"):
            if theme and theme.has_icon(name):
                img.set_from_icon_name(name)
                return img
            # folder → folder-symbolic fallback
            alt = f"{name}-symbolic" if not name.endswith("-symbolic") else name
            if theme and theme.has_icon(alt):
                img.set_from_icon_name(alt)
                return img
        for base in (
            Path("/usr/share/icons/hicolor/scalable/apps"),
            Path("/usr/share/icons/hicolor/48x48/apps"),
            Path("/usr/share/icons/hicolor/64x64/apps"),
            Path(__file__).resolve().parent.parent / "icons",
        ):
            for ext in (".svg", ".png"):
                path = base / f"{name}{ext}"
                if path.is_file():
                    try:
                        img.set_from_file(str(path))
                        return img
                    except GLib.Error:
                        continue
        img.set_from_icon_name("application-x-executable")
        return img

    def _credit_summary_line(self, ready: list) -> str:
        """One line of helper balances for the Get help card."""
        parts: list[str] = []
        for t in ready[:5]:
            st = self._credit_statuses.get(t.id)
            if st is None:
                continue
            lab = self._plain_status(st.label)
            # Shorten for the summary strip
            if lab.startswith("Needs sign-in"):
                lab = "needs sign-in"
            elif lab == "Out of uses for now":
                lab = "out of uses"
            elif lab in ("Ready · tap to open", "Tap to open"):
                lab = "ready"
            parts.append(f"{t.title}: {lab}")
        return " · ".join(parts)

    def _format_tool_subtitle(
        self, tool_id: str, credit_label: str, recent: bool | None = None
    ) -> str:
        if recent is None:
            recent = work_tools.is_recent(tool_id)
        label = self._plain_status(credit_label)
        if recent and label and "used this" not in label.lower():
            return f"{label} · used before"
        return label

    @staticmethod
    def _plain_status(label: str) -> str:
        """Map probe jargon to words a non-technical person understands.

        Preserve real balance / plan lines (e.g. “Max plan · ready”,
        “72% left”). Older code rewrote anything with “remaining” to a
        useless “Ready · tap to open”, which hid credit detection.
        """
        raw = (label or "").strip()
        if not raw:
            return "Tap to open"
        low = raw.lower()
        if "checking" in low:
            return "Checking…"
        if any(s in low for s in ("isn’t installed", "isn't installed", "not installed", "not on this computer")):
            return "Not on this computer"
        if "web app" in low:
            return raw[:72]
        if any(s in low for s in (
            "needs sign-in", "sign in", "not logged", "log in", "login",
            "not signed",
        )) and "plan" not in low and "web app" not in low:
            return "Needs sign-in · tap to connect"
        if any(s in low for s in (
            "too low", "out of uses", "out of", "no credit", "quota",
            "usage limit", "depleted", "credit balance is too low",
        )):
            return "Out of uses for now"
        # Real balance / plan / connected lines — keep them visible.
        if any(
            s in low
            for s in (
                "%", "plan", "connected", "chatgpt", "api key",
                "resets", "left", "remaining", "balance", "credits",
            )
        ):
            return raw[:72]
        if low in ("ready · tap to open", "ready", "tap to open"):
            return "Ready · tap to open"
        if "may need sign-in" in low:
            return raw[:72]
        # Keep short unknown labels; never dump raw CLI errors into the list.
        if len(raw) > 72:
            return "Tap to open"
        return raw

    def _begin_credit_probes(self, tools: list[WorkTool]) -> None:
        # Probe everything that is metered, plus free AI tools that still have
        # a probe (so "Installed · …" can replace "No credits needed" when
        # that is more honest).
        to_probe = [t for t in tools if t.is_ai]
        if not to_probe:
            return
        self._credit_generation += 1
        generation = self._credit_generation

        def work() -> None:
            statuses = {t.id: work_tools.probe_credits(t) for t in to_probe}
            GLib.idle_add(self._apply_credit_statuses, generation, statuses)

        threading.Thread(target=work, daemon=True).start()

    def _apply_credit_statuses(
        self,
        generation: int,
        statuses: dict[str, CreditStatus],
    ) -> bool:
        if generation != self._credit_generation:
            return False  # a newer goal already replaced the list
        self._credit_statuses = dict(statuses)
        for tool_id, status in statuses.items():
            row = self._tool_rows.get(tool_id)
            if row is None:
                continue
            self._credit_labels[tool_id] = status.label
            row.set_subtitle(GLib.markup_escape_text(
                self._format_tool_subtitle(tool_id, status.label)))
            # Dim and still clickable when empty: the person may want to open
            # Claude to top up or re-login. A hard-disabled row looks broken.
            if status.ok is False:
                row.add_css_class("dim-label")
            else:
                row.remove_css_class("dim-label")
        self._refresh_broadcast_ui()
        return False

    # Terminal AI tools that die without a TTY. Never bare-spawn these.
    _TTY_TOOLS = frozenset({
        "claude", "grok", "gemini", "codex", "copilot", "antigravity",
        "aider", "ollama", "crush", "goose",
    })

    def _notify(self, message: str, *, timeout: int = 3) -> None:
        """Short on-screen confirmation that a click did something."""
        try:
            toast = Adw.Toast.new(message)
            toast.set_timeout(timeout)
            self._toasts.add_toast(toast)
        except Exception:  # noqa: BLE001
            pass

    def _progress_mod(self):
        try:
            import progress as prog  # type: ignore
            return prog
        except Exception:  # noqa: BLE001
            return None

    def _refresh_progress_ui(self) -> None:
        """Update fluency strip: overall XP + per-persona levels."""
        prog = self._progress_mod()
        if prog is None or not hasattr(self, "_progress_bar"):
            return
        try:
            snap = prog.snapshot()
            # Prefer active persona meter when they have persona XP; else global.
            if (
                hasattr(prog, "persona_meter")
                and getattr(snap, "persona_xp", None)
                and snap.persona_xp
            ):
                frac, _cap = prog.persona_meter(snap.active_persona, snap)
                line = prog.progress_line(snap)
            elif hasattr(prog, "ultracode_meter"):
                frac, line = prog.ultracode_meter(snap)
            else:
                frac = (
                    min(1.0, max(0.0, snap.xp_into_level / snap.xp_for_level))
                    if snap.next_level_xp is not None and snap.xp_for_level > 0
                    else 1.0
                )
                line = prog.progress_line(snap)
            self._progress_bar.set_fraction(frac)
            self._progress_label.set_text(line)
            if hasattr(self, "_mission_label"):
                mission = ""
                if hasattr(prog, "daily_mission_line"):
                    mission = prog.daily_mission_line(snap) or ""
                elif getattr(snap, "mission_line", ""):
                    mission = snap.mission_line
                self._mission_label.set_text(mission)
                self._mission_label.set_visible(bool(mission))
            # Accent once any persona (esp. Ultracode) is part of their story.
            if (
                getattr(snap, "ultracode_asks", 0) > 0
                or getattr(snap, "switch_count", 0) > 0
                or bool(getattr(snap, "persona_levels", None))
                or getattr(snap, "combo", 0) >= 2
            ):
                self._progress_bar.add_css_class("accent")
            else:
                self._progress_bar.remove_css_class("accent")
        except Exception:  # noqa: BLE001
            pass

    def _celebrate(self, snap) -> None:
        """Toast the best progress event (badge / level / streak)."""
        prog = self._progress_mod()
        if prog is None or snap is None:
            return
        try:
            line = prog.format_toast(getattr(snap, "events", []) or [])
            if line:
                self._notify(line, timeout=4)
            self._refresh_progress_ui()
        except Exception:  # noqa: BLE001
            pass

    def _restore_pending_ask(self) -> bool:
        """Return from sign-in to the same job — project or messaging."""
        data = pending_ask.load()
        if not data:
            return False
        project = (data.get("project") or "").strip()
        prompt = (data.get("prompt") or "").strip()
        query = (data.get("query") or "").strip()
        kind = (data.get("kind") or "work").strip().lower()
        # Messaging / freeform: re-run the human Search words so action flags
        # rebuild (LinkedIn open, Draft my replies, etc.).
        if kind in ("linkedin", "whatsapp", "freeform") and query:
            self._user_query = query
            self._pending_task = prompt
            self.entry.set_text(query)
            self._run(query)
            pending_ask.clear()
            if kind in ("linkedin", "whatsapp"):
                self._notify(
                    "You’re signed in. AI will draft replies — tap “Draft my replies” "
                    "if it doesn’t start on its own.",
                    timeout=6,
                )
            elif prompt:
                self._notify(
                    "You’re signed in. Your question is ready — tap Get help.",
                    timeout=5,
                )
            else:
                self._notify(
                    "You’re signed in. Type what you need, then tap Get help.",
                    timeout=5,
                )
            return False
        if not project or not Path(project).is_dir():
            # Fallback: if we only have a query, re-run it.
            if query:
                self.entry.set_text(query)
                self._run(query)
                pending_ask.clear()
                self._notify(
                    "You’re signed in. Continue where you left off.",
                    timeout=5,
                )
                return False
            pending_ask.clear()
            return False
        # Project path: drive Search as if they typed work on <folder> again.
        name = Path(project).name
        self._pending_task = prompt
        self.entry.set_text(f"work on {name}")
        self._run(f"work on {name}")
        pending_ask.clear()
        if prompt:
            self._notify(
                "You’re signed in. Your question is ready — tap Get help.",
                timeout=5,
            )
        else:
            self._notify(
                "You’re signed in. Type what you need, then tap Get help.",
                timeout=5,
            )
        return False

    def _launch_tool(
        self,
        tool: WorkTool,
        project: Path,
        prompt: str | None = None,
    ) -> None:
        # Record before spawn so a crashy tool still counts as a choice.
        work_tools.record_use(tool.id)
        path = str(project)
        prompt = (prompt or "").strip() or None

        # Chat CLIs (Claude, Grok, Gemini, …) must NEVER open a terminal UI
        # for non-technical people. Always use the answers window
        # (teddyos-ask-all) which runs them headlessly in the background.
        if tool.id in self._TTY_TOOLS and work_tools.is_chat_helper(tool.id):
            if not prompt:
                self._prompt_then_ask(tool, project)
                return
            self._open_ask_all(project, prompt, [tool.id])
            return

        if prompt is None:
            self._notify(f"Opening {tool.title}…")

        # Non-chat tools: Files, Perplexity web, Cursor, editors, …
        ok = self._spawn(self._launch_argv(tool, path), cwd=path)
        if ok:
            GLib.timeout_add(250, self._yield_to_launched_app)
            return
        log.error("launch failed tool=%s project=%s", tool.id, path)
        self._notify(
            f"Couldn’t open {tool.title}. Try again in a moment.",
            timeout=5,
        )
        try:
            Gtk.UriLauncher.new(
                Gio.File.new_for_path(path).get_uri()
            ).launch(self, None, None, None)
        except GLib.Error:
            pass

    def _prompt_then_ask(self, tool: WorkTool, project: Path) -> None:
        """Ask what they need, then open the Answers window for one AI."""
        # Hold blur-close while the dialog has focus (parent is-active goes false).
        self._hold_for_dialog = True
        dialog = Adw.MessageDialog(
            transient_for=self,
            heading=f"Ask {tool.title}",
            body=(
                "What do you need help with? We’ll match how you sound — "
                "simple by default, or Ultracode / student / academic / writer / "
                "business / design / career and more."
            ),
        )
        entry = Gtk.Entry()
        entry.set_placeholder_text(
            "e.g. homework · resume · pitch deck · literature review · refactor api.ts"
        )
        entry.set_margin_top(8)
        pending = (getattr(self, "_pending_task", None) or "").strip()
        if pending:
            entry.set_text(pending)
        dialog.set_extra_child(entry)
        dialog.add_response("cancel", "Cancel")
        dialog.add_response("ask", "Get help")
        dialog.set_response_appearance("ask", Adw.ResponseAppearance.SUGGESTED)
        dialog.set_default_response("ask")
        dialog.set_close_response("cancel")

        def on_response(_d, response: str) -> None:
            self._hold_for_dialog = False
            # Dialog is gone; re-arm blur-close after focus settles.
            GLib.timeout_add(200, self._arm_blur_close)
            if response != "ask":
                return
            text = entry.get_text().strip()
            if not text:
                self._notify("Type what you need help with first.", timeout=3)
                return
            self._open_ask_all(project, text, [tool.id])

        dialog.connect("response", on_response)
        dialog.present()
        entry.grab_focus()

    def _open_ask_all(
        self, project: Path, prompt: str, tool_ids: list[str],
    ) -> None:
        ask = shutil.which("teddyos-ask-all")
        if not ask:
            self._notify(
                "Answers window isn’t available on this copy of teddyOS.",
                timeout=4,
            )
            return
        names = ", ".join(
            t.title for t in self._broadcast_tools if t.id in tool_ids
        ) or "your AIs"
        # Audience detect → Ultracode toast + fluency XP (gamification core).
        mode = ""
        prog = self._progress_mod()
        snap = None
        if prog is not None and hasattr(prog, "award_from_prompt"):
            try:
                snap = prog.award_from_prompt(prompt, tool_ids=tool_ids)
                if getattr(snap, "ultracode_asks", 0) > 0 or any(
                    getattr(e, "ultracode", False) for e in (snap.events or [])
                ):
                    # Fresh ultracode event this turn?
                    if any(getattr(e, "ultracode", False) for e in (snap.events or [])):
                        mode = " · Ultracode"
                # Detect from events if first unlock
                if any(
                    getattr(e, "badge_id", "") == "ultracode"
                    or (getattr(e, "kind", "") == "ultracode")
                    for e in (snap.events or [])
                ):
                    mode = " · Ultracode"
            except Exception:  # noqa: BLE001
                snap = None
        if not mode:
            try:
                sys.path.insert(0, "/usr/lib/teddyos")
                from audience import detect_audience, Audience  # type: ignore
                if detect_audience(prompt) is Audience.CODE:
                    mode = " · Ultracode"
            except Exception:  # noqa: BLE001
                pass
        self._notify(f"Asking {names}{mode}…", timeout=3)
        if snap is not None:
            GLib.timeout_add(900, lambda s=snap: (self._celebrate(s), False)[1])
        ok = self._spawn(
            [
                ask,
                "--project", str(project),
                "--prompt", prompt,
                "--tools", ",".join(tool_ids),
            ],
            cwd=str(project),
        )
        if ok:
            GLib.timeout_add(250, self._yield_to_launched_app)
        else:
            self._notify("Couldn’t open the answers window.", timeout=4)

    def _yield_to_launched_app(self) -> bool:
        """Dismiss Search once another window takes over (Answers, sign-in, …).

        Click-away already closes on focus loss; this is a fast path so the
        Answers window is never buried under Search for a beat.
        """
        try:
            self.close()
        except Exception:  # noqa: BLE001
            try:
                self.set_visible(False)
            except Exception:  # noqa: BLE001
                pass
        return False

    def _spawn(self, argv: list[str], *, cwd: str) -> bool:
        """Start a GUI/terminal child with the desktop session’s environment."""
        if not argv or not argv[0]:
            return False
        # Resolve bare names so a thin PATH cannot hide /usr/local/bin tools.
        if "/" not in argv[0]:
            found = shutil.which(argv[0])
            if not found:
                log.error("spawn: not on PATH: %s", argv[0])
                return False
            argv = [found, *argv[1:]]
        log.info("launch argv=%s cwd=%s", argv, cwd)
        try:
            launcher = Gio.SubprocessLauncher.new(Gio.SubprocessFlags.NONE)
            launcher.set_cwd(cwd)
            path_env = os.environ.get("PATH", "/usr/bin:/bin")
            for extra in ("/usr/local/bin", str(Path.home() / ".local" / "bin")):
                if extra not in path_env.split(":"):
                    path_env = f"{extra}:{path_env}"
            launcher.setenv("PATH", path_env, True)
            for key in (
                "DISPLAY", "WAYLAND_DISPLAY", "XDG_RUNTIME_DIR",
                "DBUS_SESSION_BUS_ADDRESS", "HOME", "USER", "LANG",
                "XAUTHORITY", "GDK_BACKEND",
            ):
                val = os.environ.get(key)
                if val:
                    launcher.setenv(key, val, True)
            launcher.spawnv(argv)
            return True
        except GLib.Error as exc:
            log.error("spawn failed argv=%s: %s", argv, exc.message)
            # Gio sometimes fails where a plain detached Popen still works.
            try:
                env = os.environ.copy()
                env["PATH"] = (
                    "/usr/local/bin:"
                    + str(Path.home() / ".local" / "bin")
                    + ":"
                    + env.get("PATH", "/usr/bin:/bin")
                )
                subprocess.Popen(  # noqa: S603
                    argv,
                    cwd=cwd,
                    env=env,
                    start_new_session=True,
                    stdin=subprocess.DEVNULL,
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL,
                )
                log.info("spawn via Popen argv=%s", argv)
                return True
            except OSError as exc2:
                log.error("Popen failed argv=%s: %s", argv, exc2)
                return False

    def _launch_argv(self, tool: WorkTool, path: str) -> list[str]:
        """Build argv for non-TTY tools (Files, editors, …)."""
        raw = [a.replace("{path}", path) for a in tool.argv]
        argv: list[str] = []
        for part in raw:
            if " " in part and not Path(part).exists():
                argv.extend(part.split())
            else:
                argv.append(part)
        return argv

    def _launch_via_terminal(
        self,
        tool: WorkTool,
        path: str,
        prompt_args: list[str] | None = None,
    ) -> bool:
        """Last-resort Terminal host if teddyos-agent is missing."""
        binary = {
            "gemini": "gemini",
            "codex": "codex",
            "grok": "grok",
            "claude": "claude",
            "copilot": "copilot",
            "antigravity": "agy",
            "aider": "aider",
            "ollama": "ollama",
            "crush": "crush",
            "goose": "goose",
        }.get(tool.id)
        if not binary:
            return False
        resolved = shutil.which(binary)
        if not resolved:
            for prefix in ("/usr/local/bin", str(Path.home() / ".local" / "bin")):
                candidate = Path(prefix) / binary
                if candidate.is_file() and os.access(candidate, os.X_OK):
                    resolved = str(candidate)
                    break
        if not resolved:
            log.error("terminal launch: binary missing tool=%s", tool.id)
            return False

        title = f"{tool.title} — {Path(path).name}"
        term = shutil.which("gnome-terminal") or shutil.which("kgx")
        if not term:
            log.error("terminal launch: no gnome-terminal/kgx")
            return False
        extra = list(prompt_args or [])
        if "gnome-terminal" in term:
            argv = [
                term,
                f"--title={title}",
                f"--working-directory={path}",
                "--",
                resolved,
                *extra,
            ]
        else:
            cmd = " ".join(shlex.quote(p) for p in [resolved, *extra])
            argv = [
                term,
                f"--title={title}",
                "-e",
                f"bash -lc {shlex.quote(f'cd {path} && exec {cmd}')}",
            ]
        return self._spawn(argv, cwd=path)

    def _append_notices(self, outcome) -> None:
        """Show what the search knows about its own limits.

        The engine already works out why a search came back thin — the index is
        still downloading, a source errored, a capability is off — and returns
        it in Outcome.notes/errors. This window used to drop all of it on the
        floor, so someone who searched and got nothing was shown an empty list
        and no reason, while the CLI printed the explanation to a terminal
        nobody was looking at.

        That is the difference between "this is broken" and "this is not ready
        yet", and the machine already knew which.
        """
        for text in getattr(outcome, "errors", []) or []:
            self.results.append(self._notice_row(text, "dialog-warning-symbolic"))
        for text in getattr(outcome, "notes", []) or []:
            self.results.append(self._notice_row(text, "dialog-information-symbolic"))

    def _notice_row(self, text: str, icon: str) -> Gtk.Widget:
        row = Adw.ActionRow(title=GLib.markup_escape_text(text))
        row.set_title_lines(3)
        row.add_prefix(Gtk.Image.new_from_icon_name(icon))
        row.add_css_class("dim-label")
        # Not activatable: it is an explanation, and a row that looks clickable
        # and does nothing is worse than one that plainly does not.
        row.set_activatable(False)
        return row

    def _row(self, res) -> Gtk.Widget:
        row = Adw.ActionRow(title=GLib.markup_escape_text(res.title))
        snippet = " ".join((res.snippet or "").split())[:160]
        row.set_subtitle(GLib.markup_escape_text(snippet))
        row.set_subtitle_lines(2)

        badge = Gtk.Label(label=SOURCE_LABEL.get(res.source, res.source))
        badge.add_css_class("caption")
        badge.add_css_class("dim-label")
        badge.set_valign(Gtk.Align.CENTER)
        row.add_suffix(badge)
        row.add_suffix(Gtk.Image.new_from_icon_name("go-next-symbolic"))

        row.set_activatable(True)
        row.connect("activated", lambda *_a, r=res: self._open(r))
        return row

    def _open_link_row(self, title: str, subtitle: str, url: str) -> Gtk.Widget:
        """One-tap open of a useful site (e.g. LinkedIn messages)."""
        row = Adw.ActionRow(title=GLib.markup_escape_text(title))
        row.set_subtitle(GLib.markup_escape_text(subtitle))
        row.set_subtitle_lines(2)
        row.add_prefix(Gtk.Image.new_from_icon_name("web-browser-symbolic"))
        row.add_suffix(Gtk.Image.new_from_icon_name("go-next-symbolic"))
        row.set_activatable(True)
        row.connect(
            "activated",
            lambda *_a, u=url: self._open_url(u),
        )
        return row

    def _open_url(self, url: str) -> None:
        try:
            Gtk.UriLauncher.new(url).launch(self, None, None, None)
        except GLib.Error:
            pass

    def _web_row(self, query: str) -> Gtk.Widget:
        # Truncate. The title interpolates the query, and a stuck key or a
        # pasted paragraph turns one row into a wall of text taller than the
        # window — found exactly that way. The full query still goes to the
        # web search; only the label is shortened.
        shown = query if len(query) <= 48 else query[:48].rstrip() + "…"
        row = Adw.ActionRow(
            title=f"Search the web for “{GLib.markup_escape_text(shown)}”")
        row.set_title_lines(1)
        row.set_subtitle(
            "Opens a browser search for things that are not on this computer "
            "(school sites, work tools, and the open web)")
        row.set_subtitle_lines(2)
        row.add_prefix(Gtk.Image.new_from_icon_name("web-browser-symbolic"))
        row.add_suffix(Gtk.Image.new_from_icon_name("go-next-symbolic"))
        row.set_activatable(True)
        row.connect("activated", lambda *_a: self._open_web(query))
        return row

    def _open_web(self, query: str) -> None:
        try:
            Gtk.UriLauncher.new(WEB_SEARCH + GLib.uri_escape_string(query, None, True)) \
                .launch(self, None, None, None)
        except GLib.Error:
            pass

    def _open(self, res) -> None:
        target = res.url
        if not target:
            return
        # A local file has no scheme; handing a bare path to the URI opener
        # silently does nothing, which looks exactly like a dead row.
        if not target.startswith(("http://", "https://", "file://")):
            target = Gio.File.new_for_path(target).get_uri()
        try:
            Gtk.UriLauncher.new(target).launch(self, None, None, None)
        except GLib.Error:
            pass


class SearchApp(Adw.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID)

    def do_activate(self):
        (self.props.active_window or SearchWindow(self)).present()


if __name__ == "__main__":
    # X11 needs this, and X11 is exactly where this image ends up.
    #
    # GNOME binds a window to its launcher by WM_CLASS. Under Wayland that is the
    # GApplication id, which is what StartupWMClass in the .desktop already says.
    # Under X11 it comes from the program name instead — "teddyos-search-app" — so
    # the match fails, the running window does not light up its pinned dock tile,
    # and it appears a second time as a stray entry with a fallback icon.
    #
    # That was visible the moment the desktop came up on a machine with no GPU,
    # because a machine with no GPU is one running the X11 session. Setting prgname
    # to the application id makes both worlds agree.
    GLib.set_prgname(APP_ID)
    sys.exit(SearchApp().run(sys.argv))
