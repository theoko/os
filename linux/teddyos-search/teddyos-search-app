    @staticmethod
    def _clone_error_plain(name: str, technical: str) -> str:
        """Turn git/gh noise into something a non-technical person can use."""
        low = (technical or "").lower()
        if "could not read username" in low or "authentication failed" in low:
            return (
                f"Couldn’t download “{name}” — GitHub needs you signed in first. "
                "Tap Sign in below, connect GitHub, then try again."
            )
        if "permission denied" in low or "403" in low or "not found" in low:
            return (
                f"Couldn’t download “{name}”. You may not have access to that "
                "project, or the name may be wrong. Check the name and try again."
            )
        if "timed out" in low or "network" in low or "could not resolve" in low:
            return (
                f"Couldn’t download “{name}”. Check your internet connection "
                "and try again."
            )
        if "exists and is not a git" in low:
            return (
                f"A folder named “{name}” is already on this computer, but it "
                "isn’t a project we can open. Rename or move that folder, then try again."
            )
        return (
            f"Couldn’t download “{name}”. Check your internet connection and "
            "that you still have access to the project, then try again."
        )

    def _clone_and_open(self, repo: git_projects.RemoteRepo) -> None:
        log.info("clone %s", repo.full_name)
        # Replace the list with a single status row while git runs.
        child = self.results.get_first_child()
        while child:
            nxt = child.get_next_sibling()
            self.results.remove(child)
            child = nxt
        self.results.append(self._notice_row(
            f"Downloading “{repo.name}” to this computer…",
            "emblem-synchronizing-symbolic",
        ))
        self.stack.set_visible_child_name("results")
        generation = self._generation

        def work() -> None:
            path, message = git_projects.clone_repo(repo)
            GLib.idle_add(
                self._after_clone, generation, repo, path, message,
            )

        threading.Thread(target=work, daemon=True).start()

    def _after_clone(
        self,
        generation: int,
        repo: git_projects.RemoteRepo,
        path: Path | None,
        message: str,
    ) -> bool:
        if generation != self._generation:
            return False
        child = self.results.get_first_child()
        while child:
            nxt = child.get_next_sibling()
            self.results.remove(child)
            child = nxt
        if path is None:
            log.warning("clone failed: %s", message)
            self.results.append(self._notice_row(
                self._clone_error_plain(repo.name, message),
                "dialog-warning-symbolic",
            ))
            # Offer Connect GitHub when the failure looks like missing auth.
            low = (message or "").lower()
            if any(
                s in low
                for s in (
                    "username", "authentication", "permission denied",
                    "could not read", "403", "401", "auth",
                )
            ):
                self.results.append(self._accounts_row())
            self.stack.set_visible_child_name("results")
            return False

        log.info("cloned %s → %s (%s)", repo.full_name, path, message)
        tools = work_tools.available_work_tools()
        rows: list[Gtk.Widget] = []
        self._tool_rows = {}
        self._credit_labels = {}
        self._credit_statuses = {}
        where = str(path).replace(str(Path.home()), "~")
        self.results.append(self._notice_row(
            f"“{repo.name}” is ready on this computer ({where}). "
            "Choose how you want to open it.",
            "emblem-ok-symbolic",
        ))
        self._append_project_tools(rows, [path], tools)
        for row in rows:
            self.results.append(row)
        self._begin_credit_probes(tools)
        self.stack.set_visible_child_name("results")
        return False

    def _tool_row(
        self, tool: WorkTool, project: Path, *, recent: bool = False
    ) -> Gtk.Widget:
        row = Adw.ActionRow(title=GLib.markup_escape_text(tool.title))
