    def _rebuild_advanced_options(self, *, ready: bool, probing: bool) -> None:
        """First-timers only see the big Continue card — no jargon list."""
        box = getattr(self, "_advanced_box", None)
        tools_pack = getattr(self, "_advanced_tools", None)
        if box is None or tools_pack is None:
            return
        # Clear
        child = box.get_first_child()
        while child is not None:
            nxt = child.get_next_sibling()
            box.remove(child)
            child = nxt

        if probing or not ready:
            # Keep the screen calm. Advanced picks appear only after setup.
            note = Gtk.Label(
                label=(
                    "You can open the project folder anytime from Files "
                    "in the bar at the bottom."
                ),
                wrap=True,
                xalign=0.0,
            )
            note.add_css_class("dim-label")
            note.add_css_class("caption")
            note.set_margin_top(8)
            note.set_margin_start(4)
            note.set_margin_end(4)
            box.append(note)
            return

        chat_tools, other_ai, open_with, project, recent = tools_pack

        def _section(title: str, tools: list) -> None:
            if not tools:
                return
            lab = Gtk.Label(label=title, xalign=0.0)
            lab.add_css_class("heading")
            lab.set_margin_top(12)
            lab.set_margin_bottom(4)
            box.append(lab)
            lb = Gtk.ListBox(selection_mode=Gtk.SelectionMode.NONE)
            lb.add_css_class("boxed-list")
            for tool in tools:
                lb.append(self._tool_row(
                    tool, project, recent=tool.id in recent and tool.is_ai,
                ))
            box.append(lb)

        # Subtle extras only after someone is signed in — not the first path.
        _section("Or pick one by name", chat_tools)
        _section("Apps", other_ai)
        _section("Also", open_with)

