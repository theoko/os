_MAX_CHARS = 24_000


def format_answer_for_display(text: str) -> str:
    """Turn model Markdown into clean reading text for a Gtk.Label.

    Answers cards use plain labels (not a browser). Raw ``##`` / ``**bold**``
    looks broken — especially in “Keeping it simple.” Strip common Markdown
    while keeping structure: section titles, bullets, paragraphs.
    """
    raw = (text or "").replace("\r\n", "\n").replace("\r", "\n")
    if not raw.strip():
        return ""

    def _inline(s: str) -> str:
        s = re.sub(r"\*\*(.+?)\*\*", r"\1", s)
        s = re.sub(r"__(.+?)__", r"\1", s)
        s = re.sub(r"(?<!\*)\*(?!\*)(.+?)(?<!\*)\*(?!\*)", r"\1", s)
        s = re.sub(r"(?<!_)_(?!_)(.+?)(?<!_)_(?!_)", r"\1", s)
        s = re.sub(r"`([^`]+)`", r"\1", s)
        s = re.sub(r"\[([^\]]+)\]\([^)]+\)", r"\1", s)
        return s

    out: list[str] = []
    in_fence = False
    for line in raw.split("\n"):
        stripped = line.strip()
        if stripped.startswith("```"):
            in_fence = not in_fence
            continue
        if in_fence:
            out.append(line)
            continue

        hm = re.match(r"^(#{1,6})\s+(.*)$", line)
        if hm:
            title = _inline(hm.group(2).strip())
            if title:
                if out and out[-1] != "":
                    out.append("")
                out.append(title)
                out.append("")
            continue

        bm = re.match(r"^(\s*)[-*+]\s+(.*)$", line)
        if bm:
            out.append(f"{bm.group(1)}• {_inline(bm.group(2).strip())}")
            continue

        nm = re.match(r"^(\s*)(\d+)\.\s+(.*)$", line)
        if nm:
            out.append(f"{nm.group(1)}{nm.group(2)}. {_inline(nm.group(3).strip())}")
            continue

        # Horizontal rule → blank line
        if re.match(r"^(\s*[-*_]\s*){3,}$", stripped):
            if out and out[-1] != "":
                out.append("")
            continue

        out.append(_inline(line))

    text_out = "\n".join(out)
    text_out = re.sub(r"\n{3,}", "\n\n", text_out)
    return text_out.strip()


def _model_prompt(tool_id: str, prompt: str) -> str:
    """User-facing prompt → model-facing string (audience-shaped when useful)."""
    return shape_prompt_for_tool(tool_id, (prompt or "").strip())


_LAST_HELP = Path.home() / ".config" / "teddyos" / "last-help.json"
_HISTORY_MAX_AGE_S = 45 * 60  # 45 minutes — long enough for a follow-up


def _load_last_help() -> dict | None:
    try:
        import json
        import time

        data = json.loads(_LAST_HELP.read_text())
        ts = float(data.get("ts") or 0)
        if time.time() - ts > _HISTORY_MAX_AGE_S:
            return None
        if not (data.get("prompt") and data.get("answer")):
            return None
        return data
    except (OSError, ValueError, TypeError):
        return None


def _save_last_help(*, prompt: str, answer: str, tool_id: str = "") -> None:
    try:
        import json
        import time

        _LAST_HELP.parent.mkdir(parents=True, exist_ok=True)
        _LAST_HELP.write_text(
            json.dumps(
                {
                    "prompt": (prompt or "")[:2000],
                    "answer": (answer or "")[:4000],
                    "tool_id": tool_id or "",
                    "ts": time.time(),
                },
                indent=2,
            )
            + "\n"
        )
    except OSError:
        pass


def _looks_like_followup(text: str) -> bool:
    """Short emotional / referential lines that need prior context."""
    t = (text or "").strip()
    if not t or len(t) > 120:
        return False
    words = t.split()
    if len(words) > 18:
        return False
    low = t.lower()
    # Explicit project goals are new topics.
    if any(s in low for s in ("work on ", "i wanna work", "clone ", "github.com")):
        return False
    cues = (
        "that's sad", "thats sad", "that is sad", "so sad", "ugh", "damn",
        "why", "how come", "really", "ok but", "okay but", "and then",
        "what about", "tell me more", "go on", "continue", "thanks",
        "thank you", "got it", "makes sense", "that sucks", "oh no",
        "hmm", "huh", "wait", "so what", "then what", "can you",
        "help me", "please", "same", "more", "explain",
    )
    if any(low == c or low.startswith(c + " ") or low.startswith(c + ",") for c in cues):
        return True
    # Very short replies often continue a thread.
    return len(words) <= 6


def _thread_prompt(user_prompt: str, *, prior_q: str, prior_a: str) -> str:
    """Model-facing text that includes the last exchange (UI still shows user only)."""
    pq = (prior_q or "").strip()[:1500]
    pa = (prior_a or "").strip()[:2500]
    u = (user_prompt or "").strip()
    if not pq or not pa:
        return u
    return (
        "You are continuing a conversation. The person can see your earlier "
        "answer; do not claim you lack context.\n\n"
        f"Earlier they asked:\n{pq}\n\n"
        f"You answered:\n{pa}\n\n"
        f"They now say:\n{u}\n\n"
        "Respond helpfully to their latest message, using that context. "
        "Plain language. No Markdown."
    )


# id → (title, build_argv(prompt) -> list[str])
def _headless_argv(
    tool_id: str, prompt: str, project: str = "",
) -> list[str] | None:
    """One-shot CLI that prints an answer and exits. cwd is the project."""
    # UI still shows the original text; only the model-facing string is shaped.
    # *prompt* may already include thread context from the caller.
    text = _model_prompt(tool_id, prompt)
    if not text:
        return None
    if tool_id == "claude":
        exe = shutil.which("claude")
        if not exe:
            return None
        # Headless -p must not wait on interactive permission prompts — those
        # hang forever and only surface as “Execution error” / a 3‑minute
        # timeout. Skip checks in this sandboxed guest path (same idea as
        # antigravity --dangerously-skip-permissions).
        #
        # Also force plain-text first answers: Ultracode prompts that say
        # “read files / make the edit” send Claude Code into a tool loop that
        # often ends as “Execution error” with no answer. Get help needs a
        # spoken reply in-window; file edits can be a follow-up.
        text = (
            "Answer in plain text only for this turn. Do not use tools, "
            "shell, or file edits. If you need files, name paths. "
            "Be concrete and helpful.\n\n"
            + text
        )
        cmd = [
            exe, "-p", text,
            "--dangerously-skip-permissions",
            "--permission-mode", "bypassPermissions",
        ]
        if project:
            cmd.extend(["--add-dir", project])
        return cmd
    if tool_id == "gemini":
        exe = shutil.which("gemini") or _find("gemini")
        return [exe, "-p", text] if exe else None
    if tool_id == "codex":
        exe = shutil.which("codex") or _find("codex")
        # Non-interactive; allow writing inside the project folder only.
        return (
            [exe, "exec", "--sandbox", "workspace-write", text]
            if exe else None
        )
    if tool_id == "grok":
        exe = shutil.which("grok") or _find("grok")
        # -p / --single: print response and exit
        return [exe, "-p", text] if exe else None
    if tool_id == "copilot":
        exe = shutil.which("copilot") or _find("copilot")
        if not exe:
            return None
        # Non-interactive (-p) requires auto-approved tools or Copilot only
        # replies "permission denied" and does nothing useful.
        cmd = [
            exe,
            "-p", text,
            "--allow-all-tools",
            "--allow-all-paths",
        ]
        if project:
            cmd.extend(["-C", project, "--add-dir", project])
        return cmd
    if tool_id == "antigravity":
        exe = shutil.which("agy") or _find("agy") or shutil.which("antigravity")
        if not exe:
            return None
        # Allow tools in print mode so the agent can actually answer.
        cmd = [exe, "-p", text, "--dangerously-skip-permissions"]
        return cmd
    if tool_id == "aider":
        # Aider is interactive-first; skip one-shot for now.
        return None
    return None


def _find(name: str) -> str | None:
    for prefix in ("/usr/local/bin", str(Path.home() / ".local" / "bin")):
        p = Path(prefix) / name
        if p.is_file() and os.access(p, os.X_OK):
            return str(p)
    return None


_TITLES = {
    "claude": "Claude",
    "grok": "Grok",
    "gemini": "Gemini",
    "codex": "Codex",
    "copilot": "Copilot",
    "antigravity": "Antigravity",
    "aider": "Aider",
}


def _parse() -> argparse.Namespace:
    p = argparse.ArgumentParser(description="Ask several AIs in one window")
    p.add_argument("--project", required=True, help="Project directory")
    p.add_argument("--prompt", required=True, help="Question / task")
    p.add_argument(
        "--tools",
        required=True,
        help="Comma-separated tool ids (claude,grok,gemini,codex)",
    )
    return p.parse_args()


class ToolCard(Gtk.Box):
    """One AI’s status + answer inside the shared window."""

    def __init__(
        self,
        tool_id: str,
        project: str,
        prompt: str,
        *,
        parent: Gtk.Window | None = None,
        on_done=None,
        on_rerun=None,
    ):
        super().__init__(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        self.tool_id = tool_id
        self.project = project
        self.prompt = prompt
        self.title = _TITLES.get(tool_id, tool_id.title())
        self._parent = parent
        self._on_done = on_done
        # Called as on_rerun(tool_id, prompt) to re-run headless in this window.
        self._on_rerun = on_rerun
        self._busy = False
        # Progress counter only for the first finish — re-asks must not re-count.
        self._reported_done = False
        # Last successful body (for “across all answers” review). Empty on error.
        self.answer_text = ""
        self.had_error = False
        self.add_css_class("card")
        self.set_margin_top(4)
        self.set_margin_bottom(8)
        self.set_margin_start(2)
        self.set_margin_end(2)

        head = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        head.set_margin_top(12)
        head.set_margin_start(14)
        head.set_margin_end(14)

        name = Gtk.Label(label=self.title, xalign=0.0, hexpand=True)
        name.add_css_class("heading")
        head.append(name)

        self.spinner = Gtk.Spinner()
        self.spinner.start()
        head.append(self.spinner)

        self.status = Gtk.Label(label="Thinking…", xalign=1.0)
        self.status.add_css_class("dim-label")
        self.status.add_css_class("caption")
        head.append(self.status)
        self.append(head)

        self.body = Gtk.Label(
            label="Please wait — this can take a minute.",
            wrap=True,
            xalign=0.0,
            selectable=True,
        )
        self.body.add_css_class("dim-label")
        self.body.set_margin_start(14)
        self.body.set_margin_end(14)
        self.body.set_margin_bottom(8)
        self.body.set_wrap_mode(Pango.WrapMode.WORD_CHAR)
        self.append(self.body)

        self.actions = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        self.actions.set_margin_start(14)
        self.actions.set_margin_end(14)
        self.actions.set_margin_bottom(12)
        self.actions.set_visible(False)
        self.append(self.actions)

    def set_working(self) -> None:
        self._busy = True
        self.answer_text = ""
        self.had_error = False
        self.spinner.set_visible(True)
        self.spinner.start()
        self.status.set_text("Thinking…")
        self.body.add_css_class("dim-label")
        self.body.set_text("Please wait — this can take a minute.")
        # Hide buttons while a run is in flight so double-taps don't stack.
        self.actions.set_visible(False)

    def set_answer(self, text: str) -> None:
        self._busy = False
        self.had_error = False
        self.spinner.stop()
        self.spinner.set_visible(False)
        self.status.set_text("Done")
        self.body.remove_css_class("dim-label")
        # Keep raw for synthesis; show a cleaned version in the card.
        raw = (text or "").strip() or "No answer came back."
        if len(raw) > _MAX_CHARS:
            raw = raw[:_MAX_CHARS] + "\n\n… (cut short here)"
        self.answer_text = raw
        self.body.set_text(format_answer_for_display(raw) or raw)
        # Persist for follow-ups from Search (“that’s sad”) within ~45 min.
        try:
            _save_last_help(
                prompt=self.prompt, answer=raw, tool_id=self.tool_id,
            )
        except Exception:  # noqa: BLE001
            pass
        self._add_continue(failed=False)
        self._notify_done_once()

    def set_error(self, message: str) -> None:
        self._busy = False
        self.had_error = True
        self.answer_text = ""
        self.spinner.stop()
        self.spinner.set_visible(False)
        self.status.set_text("Couldn’t finish")
        self.body.remove_css_class("dim-label")
        self.body.set_text(format_answer_for_display(message) or (message or ""))
        self._add_continue(failed=True)
        self._notify_done_once()

    def _notify_done_once(self) -> None:
        if self._reported_done or self._on_done is None:
            return
        self._reported_done = True
        self._on_done()

    def _add_continue(self, failed: bool = False) -> None:
        child = self.actions.get_first_child()
        while child:
            nxt = child.get_next_sibling()
            self.actions.remove(child)
            child = nxt
        # Always re-run inside this window. Spawning a second teddyos-ask-all
        # is a no-op: GApplication single-instance only re-presents this window
        # and ignores the new argv (so “something else” looked broken).
        if failed:
            retry = Gtk.Button(label=f"Ask {self.title} again")
            retry.connect("clicked", self._retry_same)
            self.actions.append(retry)
        else:
            other = Gtk.Button(label=f"Ask {self.title} something else")
            other.add_css_class("suggested-action")
            other.connect("clicked", self._ask_something_else)
            self.actions.append(other)
            again = Gtk.Button(label="Ask the same thing again")
            again.connect("clicked", self._retry_same)
            self.actions.append(again)
        self.actions.set_visible(True)

    def _retry_same(self, *_a) -> None:
        """Retry the last prompt on this card (or open sign-in if needed)."""
        if self._busy:
            return
        body = ""
        try:
            body = (self.body.get_text() or "").lower()
        except Exception:  # noqa: BLE001
            pass
        if any(
            s in body
            for s in ("sign-in", "sign in", "not signed", "finish sign-in")
        ):
            accounts = shutil.which("teddyos-accounts")
            if accounts:
                try:
                    subprocess.Popen(  # noqa: S603
                        [accounts, "--connect", self.tool_id],
                        start_new_session=True,
                        stdin=subprocess.DEVNULL,
                        stdout=subprocess.DEVNULL,
                        stderr=subprocess.DEVNULL,
                    )
                    return
                except OSError as exc:
                    log.error("open accounts failed: %s", exc)
        self._kick_rerun(self.prompt)

    def _ask_something_else(self, *_a) -> None:
        """Collect a new question, then re-run this card in place."""
        if self._busy:
            return
        dialog = Adw.MessageDialog(
            transient_for=self._parent,
            heading=f"Ask {self.title}",
            body="What else do you need help with?",
        )
        entry = Gtk.Entry()
        entry.set_placeholder_text("Type a new question…")
        entry.set_margin_top(8)
        # Seed with previous prompt so they can edit rather than start blank.
        if self.prompt:
            entry.set_text(self.prompt)
            entry.select_region(0, -1)
        dialog.set_extra_child(entry)
        dialog.add_response("cancel", "Cancel")
        dialog.add_response("ask", "Get help")
        dialog.set_response_appearance("ask", Adw.ResponseAppearance.SUGGESTED)
        dialog.set_default_response("ask")
        dialog.set_close_response("cancel")

        def on_response(_d, response: str) -> None:
            if response != "ask":
                return
            text = (entry.get_text() or "").strip()
            if not text:
                return
            self._kick_rerun(text)

        dialog.connect("response", on_response)
        dialog.present()
        entry.grab_focus()

    def _kick_rerun(self, prompt: str) -> None:
        prompt = (prompt or "").strip()
        if not prompt or self._on_rerun is None:
            return
        # Keep the prior answer so the re-run can pass thread context.
        prior_q = self.prompt
        prior_a = self.answer_text
        self.prompt = prompt
        log.info("rerun in-window tool=%s prompt_len=%d", self.tool_id, len(prompt))
        self.set_working()
        self._on_rerun(self.tool_id, prompt, prior_q=prior_q, prior_a=prior_a)


