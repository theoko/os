#!/usr/bin/env python3
"""Ask every ready AI one question — in a single window.

"Send to all" used to open Claude, Grok, Gemini, and Codex as four separate
app windows. That is a bad experience for anyone who is not already living
in a terminal: windows stack, focus fights, and nobody knows which one to
read first.

This window runs each helper in the background (one-shot / print mode),
shows progress, and lays answers out as cards. If someone wants to keep
chatting with one answer, one button opens that helper alone.

Usage:
  teddyos-ask-all --project /path/to/proj --prompt "explain the risk code" \\
      --tools claude,grok,gemini,codex
"""

from __future__ import annotations

import argparse
import os
import shutil
import subprocess
import sys
import threading
from pathlib import Path

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
from gi.repository import Adw, GLib, Gtk, Pango  # noqa: E402

try:
    sys.path.insert(0, "/usr/lib/teddyos")
    from logutil import get_logger
    log = get_logger("ask-all")
except Exception:  # noqa: BLE001
    import logging
    log = logging.getLogger("teddyos.ask-all")

APP_ID = "com.teddyos.AskAll"

# How long we wait for one helper before giving up (seconds).
_TIMEOUT = 180
# Soft cap so a runaway log dump cannot freeze the UI.
_MAX_CHARS = 24_000

# id → (title, build_argv(prompt) -> list[str])
def _headless_argv(
    tool_id: str, prompt: str, project: str = "",
) -> list[str] | None:
    """One-shot CLI that prints an answer and exits. cwd is the project."""
    text = (prompt or "").strip()
    if not text:
        return None
    if tool_id == "claude":
        exe = shutil.which("claude")
        return [exe, "-p", text] if exe else None
    if tool_id == "gemini":
        exe = shutil.which("gemini") or _find("gemini")
        return [exe, "-p", text] if exe else None
    if tool_id == "codex":
        exe = shutil.which("codex") or _find("codex")
        # Non-interactive; allow writing inside the project folder only.
        return (
            [exe, "exec", "--sandbox", "workspace-write", text]
            if exe else None
        )
    if tool_id == "grok":
        exe = shutil.which("grok") or _find("grok")
        # -p / --single: print response and exit
        return [exe, "-p", text] if exe else None
    if tool_id == "copilot":
        exe = shutil.which("copilot") or _find("copilot")
        if not exe:
            return None
        # Non-interactive (-p) requires auto-approved tools or Copilot only
        # replies "permission denied" and does nothing useful.
        cmd = [
            exe,
            "-p", text,
            "--allow-all-tools",
            "--allow-all-paths",
        ]
        if project:
            cmd.extend(["-C", project, "--add-dir", project])
        return cmd
    if tool_id == "antigravity":
        exe = shutil.which("agy") or _find("agy") or shutil.which("antigravity")
        if not exe:
            return None
        # Allow tools in print mode so the agent can actually answer.
        cmd = [exe, "-p", text, "--dangerously-skip-permissions"]
        return cmd
    if tool_id == "aider":
        # Aider is interactive-first; skip one-shot for now.
        return None
    return None


def _find(name: str) -> str | None:
    for prefix in ("/usr/local/bin", str(Path.home() / ".local" / "bin")):
        p = Path(prefix) / name
        if p.is_file() and os.access(p, os.X_OK):
            return str(p)
    return None


_TITLES = {
    "claude": "Claude",
    "grok": "Grok",
    "gemini": "Gemini",
    "codex": "Codex",
    "copilot": "Copilot",
    "antigravity": "Antigravity",
    "aider": "Aider",
}


def _parse() -> argparse.Namespace:
    p = argparse.ArgumentParser(description="Ask several AIs in one window")
    p.add_argument("--project", required=True, help="Project directory")
    p.add_argument("--prompt", required=True, help="Question / task")
    p.add_argument(
        "--tools",
        required=True,
        help="Comma-separated tool ids (claude,grok,gemini,codex)",
    )
    return p.parse_args()


class ToolCard(Gtk.Box):
    """One AI’s status + answer inside the shared window."""

    def __init__(
        self,
        tool_id: str,
        project: str,
        prompt: str,
        *,
        parent: Gtk.Window | None = None,
        on_done=None,
        on_rerun=None,
    ):
        super().__init__(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        self.tool_id = tool_id
        self.project = project
        self.prompt = prompt
        self.title = _TITLES.get(tool_id, tool_id.title())
        self._parent = parent
        self._on_done = on_done
        # Called as on_rerun(tool_id, prompt) to re-run headless in this window.
        self._on_rerun = on_rerun
        self._busy = False
        # Progress counter only for the first finish — re-asks must not re-count.
        self._reported_done = False
        self.add_css_class("card")
        self.set_margin_top(4)
        self.set_margin_bottom(8)
        self.set_margin_start(2)
        self.set_margin_end(2)

        head = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        head.set_margin_top(12)
        head.set_margin_start(14)
        head.set_margin_end(14)

        name = Gtk.Label(label=self.title, xalign=0.0, hexpand=True)
        name.add_css_class("heading")
        head.append(name)

        self.spinner = Gtk.Spinner()
        self.spinner.start()
        head.append(self.spinner)

        self.status = Gtk.Label(label="Thinking…", xalign=1.0)
        self.status.add_css_class("dim-label")
        self.status.add_css_class("caption")
        head.append(self.status)
        self.append(head)

        self.body = Gtk.Label(
            label="Please wait — this can take a minute.",
            wrap=True,
            xalign=0.0,
            selectable=True,
        )
        self.body.add_css_class("dim-label")
        self.body.set_margin_start(14)
        self.body.set_margin_end(14)
        self.body.set_margin_bottom(8)
        self.body.set_wrap_mode(Pango.WrapMode.WORD_CHAR)
        self.append(self.body)

        self.actions = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        self.actions.set_margin_start(14)
        self.actions.set_margin_end(14)
        self.actions.set_margin_bottom(12)
        self.actions.set_visible(False)
        self.append(self.actions)

    def set_working(self) -> None:
        self._busy = True
        self.spinner.set_visible(True)
        self.spinner.start()
        self.status.set_text("Thinking…")
        self.body.add_css_class("dim-label")
        self.body.set_text("Please wait — this can take a minute.")
        # Hide buttons while a run is in flight so double-taps don't stack.
        self.actions.set_visible(False)

    def set_answer(self, text: str) -> None:
        self._busy = False
        self.spinner.stop()
        self.spinner.set_visible(False)
        self.status.set_text("Done")
        self.body.remove_css_class("dim-label")
        cleaned = (text or "").strip() or "No answer came back."
        if len(cleaned) > _MAX_CHARS:
            cleaned = cleaned[:_MAX_CHARS] + "\n\n… (cut short here)"
        self.body.set_text(cleaned)
        self._add_continue(failed=False)
        self._notify_done_once()

    def set_error(self, message: str) -> None:
        self._busy = False
        self.spinner.stop()
        self.spinner.set_visible(False)
        self.status.set_text("Couldn’t finish")
        self.body.remove_css_class("dim-label")
        self.body.set_text(message)
        self._add_continue(failed=True)
        self._notify_done_once()

    def _notify_done_once(self) -> None:
        if self._reported_done or self._on_done is None:
            return
        self._reported_done = True
        self._on_done()

    def _add_continue(self, failed: bool = False) -> None:
        child = self.actions.get_first_child()
        while child:
            nxt = child.get_next_sibling()
            self.actions.remove(child)
            child = nxt
        # Always re-run inside this window. Spawning a second teddyos-ask-all
        # is a no-op: GApplication single-instance only re-presents this window
        # and ignores the new argv (so “something else” looked broken).
        if failed:
            retry = Gtk.Button(label=f"Ask {self.title} again")
            retry.connect("clicked", self._retry_same)
            self.actions.append(retry)
        else:
            other = Gtk.Button(label=f"Ask {self.title} something else")
            other.add_css_class("suggested-action")
            other.connect("clicked", self._ask_something_else)
            self.actions.append(other)
            again = Gtk.Button(label="Ask the same thing again")
            again.connect("clicked", self._retry_same)
            self.actions.append(again)
        self.actions.set_visible(True)

    def _retry_same(self, *_a) -> None:
        """Retry the last prompt on this card (or open sign-in if needed)."""
        if self._busy:
            return
        body = ""
        try:
            body = (self.body.get_text() or "").lower()
        except Exception:  # noqa: BLE001
            pass
        if any(
            s in body
            for s in ("sign-in", "sign in", "not signed", "finish sign-in")
        ):
            accounts = shutil.which("teddyos-accounts")
            if accounts:
                try:
                    subprocess.Popen(  # noqa: S603
                        [accounts, "--connect", self.tool_id],
                        start_new_session=True,
                        stdin=subprocess.DEVNULL,
                        stdout=subprocess.DEVNULL,
                        stderr=subprocess.DEVNULL,
                    )
                    return
                except OSError as exc:
                    log.error("open accounts failed: %s", exc)
        self._kick_rerun(self.prompt)

    def _ask_something_else(self, *_a) -> None:
        """Collect a new question, then re-run this card in place."""
        if self._busy:
            return
        dialog = Adw.MessageDialog(
            transient_for=self._parent,
            heading=f"Ask {self.title}",
            body="What else do you need help with?",
        )
        entry = Gtk.Entry()
        entry.set_placeholder_text("Type a new question…")
        entry.set_margin_top(8)
        # Seed with previous prompt so they can edit rather than start blank.
        if self.prompt:
            entry.set_text(self.prompt)
            entry.select_region(0, -1)
        dialog.set_extra_child(entry)
        dialog.add_response("cancel", "Cancel")
        dialog.add_response("ask", "Get help")
        dialog.set_response_appearance("ask", Adw.ResponseAppearance.SUGGESTED)
        dialog.set_default_response("ask")
        dialog.set_close_response("cancel")

        def on_response(_d, response: str) -> None:
            if response != "ask":
                return
            text = (entry.get_text() or "").strip()
            if not text:
                return
            self._kick_rerun(text)

        dialog.connect("response", on_response)
        dialog.present()
        entry.grab_focus()

    def _kick_rerun(self, prompt: str) -> None:
        prompt = (prompt or "").strip()
        if not prompt or self._on_rerun is None:
            return
        self.prompt = prompt
        log.info("rerun in-window tool=%s prompt_len=%d", self.tool_id, len(prompt))
        self.set_working()
        self._on_rerun(self.tool_id, prompt)


class AskAllWindow(Adw.ApplicationWindow):
    def __init__(
        self,
        app: Adw.Application,
        project: str,
        prompt: str,
        tool_ids: list[str],
    ):
        project_name = os.path.basename(project.rstrip("/")) or "project"
        super().__init__(
            application=app,
            title=f"Help — {project_name}",
        )
        self.set_default_size(760, 720)
        self._project = project
        self._prompt = prompt
        self._cards: dict[str, ToolCard] = {}
        self._total = 0
        self._finished = 0

        header = Adw.HeaderBar()
        header.set_title_widget(Adw.WindowTitle(
            title="Here’s your help",
            subtitle=f"For “{project_name}”",
        ))

        you_asked = Gtk.Label(label="You asked", xalign=0.0)
        you_asked.add_css_class("caption")
        you_asked.add_css_class("dim-label")
        you_asked.set_margin_top(8)
        you_asked.set_margin_start(4)
        you_asked.set_margin_end(4)

        self._prompt_label = Gtk.Label(
            label=prompt,
            wrap=True,
            xalign=0.0,
            selectable=True,
        )
        self._prompt_label.add_css_class("title-4")
        self._prompt_label.set_margin_top(2)
        self._prompt_label.set_margin_bottom(8)
        self._prompt_label.set_margin_start(4)
        self._prompt_label.set_margin_end(4)

        self._progress = Gtk.Label(
            label="Getting answers… sit tight.",
            wrap=True,
            xalign=0.0,
        )
        self._progress.add_css_class("dim-label")
        self._progress.set_margin_bottom(12)
        self._progress.set_margin_start(4)
        self._progress.set_margin_end(4)

        cards_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        runnable: list[str] = []
        for tid in tool_ids:
            card = ToolCard(
                tid,
                project,
                prompt,
                parent=self,
                on_done=self._mark_done,
                on_rerun=self._rerun_one,
            )
            self._cards[tid] = card
            cards_box.append(card)
            if _headless_argv(tid, prompt, project):
                runnable.append(tid)
                self._total += 1
            else:
                card.set_error(
                    f"{card.title} can’t do a quick answer on this computer. "
                    f"Close this window and open {card.title} from Search instead."
                )

        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        outer.set_margin_top(8)
        outer.set_margin_bottom(16)
        outer.set_margin_start(18)
        outer.set_margin_end(18)
        outer.append(you_asked)
        outer.append(self._prompt_label)
        outer.append(self._progress)
        outer.append(cards_box)

        scroller = Gtk.ScrolledWindow(vexpand=True, hexpand=True)
        scroller.set_child(Adw.Clamp(maximum_size=720, child=outer))

        toolbar = Adw.ToolbarView()
        toolbar.add_top_bar(header)
        toolbar.set_content(scroller)
        self.set_content(toolbar)

        if self._total:
            self._progress.set_text(
                f"Getting answers from {self._total} "
                f"{'place' if self._total == 1 else 'places'}… "
                "they appear below as they finish."
            )
        else:
            self._progress.set_text(
                "Nothing could start. Close this, go back to Search, "
                "and tap Continue to finish sign-in."
            )

        for tid in runnable:
            threading.Thread(
                target=self._run_one,
                args=(tid,),
                daemon=True,
            ).start()

    def _mark_done(self) -> None:
        self._finished += 1
        if self._finished >= self._total and self._total:
            self._progress.set_text(
                "All done. Read the answers below. "
                "Tap a button under any answer to ask again or something else."
            )
        elif self._total:
            self._progress.set_text(
                f"{self._finished} of {self._total} finished…"
            )

    def _rerun_one(self, tool_id: str, prompt: str) -> None:
        """In-window re-ask (same or new prompt) — does not spawn a second app."""
        prompt = (prompt or "").strip()
        self._prompt = prompt
        # Keep “You asked” in sync so a new question isn’t still titled with the old one.
        if prompt and getattr(self, "_prompt_label", None) is not None:
            self._prompt_label.set_text(prompt)
        name = _TITLES.get(tool_id, tool_id)
        self._progress.set_text(
            f"Asking {name}…"
            if prompt
            else f"Asking {name} again…"
        )
        threading.Thread(
            target=self._run_one,
            args=(tool_id, prompt),
            daemon=True,
        ).start()

    def _run_one(self, tool_id: str, prompt: str | None = None) -> None:
        prompt = prompt if prompt is not None else self._prompt
        argv = _headless_argv(tool_id, prompt, self._project)
        title = _TITLES.get(tool_id, tool_id)
        if not argv:
            GLib.idle_add(
                self._cards[tool_id].set_error,
                f"{title} isn’t available for a quick answer.",
            )
            return
        log.info("headless start tool=%s argv0=%s", tool_id, argv[0])
        env = os.environ.copy()
        path = env.get("PATH", "/usr/bin:/bin")
        for extra in ("/usr/local/bin", str(Path.home() / ".local" / "bin")):
            if extra not in path.split(":"):
                path = extra + ":" + path
        env["PATH"] = path
        env["TERM"] = env.get("TERM") or "xterm-256color"
        # Prefer non-interactive; some tools honor these.
        env["CI"] = "1"
        env["NO_COLOR"] = "1"
        # Copilot non-interactive without this often only says "permission denied".
        env["COPILOT_ALLOW_ALL"] = "1"
        try:
            proc = subprocess.run(  # noqa: S603
                argv,
                cwd=self._project,
                env=env,
                capture_output=True,
                text=True,
                timeout=_TIMEOUT,
            )
            out = (proc.stdout or "").strip()
            err = (proc.stderr or "").strip()
            # Prefer stdout; some tools print the answer on stderr when broken.
            text = out or err
            if proc.returncode != 0 and not out:
                msg = self._friendly_error(title, err or out or f"exit {proc.returncode}")
                log.warning(
                    "headless fail tool=%s code=%s err=%s",
                    tool_id, proc.returncode, (err or "")[:200],
                )
                GLib.idle_add(self._cards[tool_id].set_error, msg)
                return
            if not text:
                GLib.idle_add(
                    self._cards[tool_id].set_error,
                    f"{title} finished without an answer. "
                    "Try asking again in a moment.",
                )
                return
            GLib.idle_add(self._cards[tool_id].set_answer, text)
        except subprocess.TimeoutExpired:
            GLib.idle_add(
                self._cards[tool_id].set_error,
                f"{title} is taking too long. Try a shorter question, or "
                "ask again in a moment.",
            )
        except OSError as exc:
            log.error("headless oserror tool=%s: %s", tool_id, exc)
            GLib.idle_add(
                self._cards[tool_id].set_error,
                f"Couldn’t start {title} on this computer.",
            )

    @staticmethod
    def _friendly_error(title: str, raw: str) -> str:
        low = (raw or "").lower()
        if any(
            s in low
            for s in (
                "auth", "login", "sign in", "not logged", "api key",
                "unauthorized", "401", "please run", "not authenticated",
            )
        ):
            return (
                f"{title} needs a quick sign-in first. "
                "Go back to Search, tap Continue, finish sign-in, then ask again."
            )
        if "permission denied" in low or "permissions" in low and "denied" in low:
            return (
                f"{title} couldn’t work on this project. "
                "Try signing in again from Search, or ask again in a moment."
            )
        if any(
            s in low
            for s in ("credit", "quota", "rate limit", "usage limit", "too low")
        ):
            return (
                f"{title} is out of free uses for now. "
                "Try another answer above, or try again later."
            )
        if "403" in low:
            return (
                f"{title} was refused access. "
                "Go back to Search, sign in again, then retry."
            )
        return (
            f"{title} couldn’t answer this time. "
            "Try again, or finish sign-in from Search if you haven’t yet."
        )


class AskAllApp(Adw.Application):
    def __init__(self, project: str, prompt: str, tool_ids: list[str]):
        super().__init__(application_id=APP_ID)
        self._project = project
        self._prompt = prompt
        self._tool_ids = tool_ids

    def do_activate(self):
        win = self.props.active_window
        if win is None:
            win = AskAllWindow(
                self, self._project, self._prompt, self._tool_ids,
            )
            # Dock / alt-tab: friendly answers icon, not a generic gear.
            try:
                win.set_icon_name("teddyos-answers")
            except Exception:  # noqa: BLE001
                pass
        win.present()


def main() -> int:
    args = _parse()
    project = os.path.abspath(os.path.expanduser(args.project))
    if not os.path.isdir(project):
        print(f"not a directory: {project}", file=sys.stderr)
        return 2
    prompt = (args.prompt or "").strip()
    if not prompt:
        print("prompt is empty", file=sys.stderr)
        return 2
    tools = [t.strip().lower() for t in args.tools.split(",") if t.strip()]
    if not tools:
        print("no tools", file=sys.stderr)
        return 2
    GLib.set_prgname(APP_ID)
    # Also advertise a human name so the shell doesn't only show the app id.
    try:
        GLib.set_application_name("Answers")
    except Exception:  # noqa: BLE001
        pass
    log.info("start project=%s tools=%s prompt_len=%d", project, tools, len(prompt))
    app = AskAllApp(project, prompt, tools)
    return app.run([sys.argv[0]])


if __name__ == "__main__":
    sys.exit(main())
