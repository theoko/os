    def _refresh_audience_chip(self, audience, *, animate: bool = False) -> None:
        """Update mode chip; switch animation when persona changes."""
        prev_code = self._last_was_ultracode
        prev_val = getattr(self, "_last_audience_value", "") or ""
        self._audience = audience
        is_code = is_code_audience(audience)
        try:
            new_val = getattr(audience, "value", str(audience))
        except Exception:  # noqa: BLE001
            new_val = "code" if is_code else "plain"
        try:
            label = audience_chip_label(audience)
            hint = audience_chip_hint(audience)
            header = audience_header_title(audience)
        except Exception:  # noqa: BLE001
            label = "Ultracode" if is_code else "Keeping it simple"
            hint = (
                "You sound like you know code — we’ll help make the change."
                if is_code
                else "Plain language only — no terminal steps or code jargon."
            )
            header = "Ultracode" if is_code else "Here’s your help"
        self._chip.set_text(label)
        # Level line: “Level 2 · LinkedIn”
        try:
            import progress as prog  # type: ignore
            if hasattr(prog, "persona_level_line"):
                self._level_chip.set_text(prog.persona_level_line(audience))
                self._level_chip.set_visible(True)
            else:
                self._level_chip.set_visible(False)
        except Exception:  # noqa: BLE001
            try:
                self._level_chip.set_visible(False)
            except Exception:  # noqa: BLE001
                pass
        self._chip_hint.set_text(hint)
        # Drop any prior persona class (teddyos-audience-*).
        try:
            for cls in list(getattr(self._chip, "get_css_classes", lambda: [])() or []):
                if isinstance(cls, str) and cls.startswith("teddyos-audience-"):
                    self._chip.remove_css_class(cls)
        except Exception:  # noqa: BLE001
            for cls in (
                "teddyos-audience-code", "teddyos-audience-plain",
                "teddyos-audience-academic", "teddyos-audience-student",
                "teddyos-audience-writer", "teddyos-audience-business",
            ):
                self._chip.remove_css_class(cls)
        try:
            self._chip.add_css_class(audience_css_class(audience))
        except Exception:  # noqa: BLE001
            self._chip.add_css_class(
                "teddyos-audience-code" if is_code else "teddyos-audience-plain"
            )
        try:
            self._header_title.set_title(header)
            if is_code:
                self._header_title.set_subtitle(
                    f"Coding help for “{self._project_name}”"
                )
            else:
                self._header_title.set_subtitle(
                    f"For “{self._project_name}”"
                )
        except Exception:  # noqa: BLE001
            pass

        switched = bool(prev_val and prev_val != new_val)
        entering_ultra = is_code and (animate or not prev_code or switched)
        if entering_ultra:
            self._play_ultracode_switch()
        elif switched and animate:
            self._play_persona_switch(prev_val, new_val, label)
        elif not is_code:
            self._clear_ultracode_flash()
        self._last_was_ultracode = is_code
        self._last_audience_value = new_val

    def _toast_progress(self, message: str) -> None:
        """Best-effort toast for XP / badge celebrations."""
        try:
            # Prefer a transient toast if Adw.ToastOverlay is parented later;
            # for now log + update chip subtitle-style progress.
            log.info("progress: %s", message)
            if getattr(self, "_chip_hint", None) is not None:
                prev = self._chip_hint.get_text() or ""
                self._chip_hint.set_text(f"{message}  ·  {prev}"[:160])
        except Exception:  # noqa: BLE001
            pass

    def _play_persona_switch(self, prev: str, new: str, label: str) -> None:
        """Lighter burst when switching between non-code personas (or out of code)."""
        log.info("persona switch %s -> %s", prev, new)
        try:
            self.add_css_class("teddyos-mode-flash")
            GLib.timeout_add(
                500,
                lambda: (self.remove_css_class("teddyos-mode-flash"), False)[1],
            )
        except Exception:  # noqa: BLE001
            pass
        burst = getattr(self, "_ultracode_burst", None)
        if burst is None:
            return
        burst.set_visible(True)
        burst.set_opacity(0.0)
        title = (label or new or "MODE").upper()[:22]
        self._ultracode_title.set_text(title)
        self._ultracode_sub.set_text("Mode switched — help matches this ask")

        def fade(widget: Gtk.Widget, start: float, end: float, ms: int) -> None:
            try:
                target = Adw.PropertyAnimationTarget.new(widget, "opacity")
                anim = Adw.TimedAnimation.new(widget, start, end, ms, target)
                anim.set_easing(Adw.Easing.EASE_OUT_CUBIC)
                self._ultracode_anims.append(anim)
                anim.play()
            except Exception:  # noqa: BLE001
                widget.set_opacity(end)

        fade(self._chip, 0.35, 1.0, 200)
        fade(burst, 0.0, 1.0, 240)

        def fade_out() -> bool:
            fade(burst, 1.0, 0.0, 320)
            return False

        def hide() -> bool:
            try:
                burst.set_visible(False)
            except Exception:  # noqa: BLE001
                pass
            return False

        GLib.timeout_add(700, fade_out)
        GLib.timeout_add(1100, hide)

    def _play_ultracode_switch(self) -> None:
        """Short burst + pulse when we flip into Ultracode."""
        log.info("ultracode switch on")
        try:
            self.add_css_class("teddyos-ultracode-flash")
        except Exception:  # noqa: BLE001
            pass
        # Badge: first Ultracode unlock
        try:
            import progress as prog  # type: ignore
            snap = prog.award(badge="ultracode")
            line = prog.format_toast(snap.events)
            if line:
                GLib.timeout_add(
                    400, lambda l=line: (self._toast_progress(l), False)[1],
                )
        except Exception:  # noqa: BLE001
            pass
        burst = getattr(self, "_ultracode_burst", None)
        if burst is None:
            return
        burst.set_visible(True)
        burst.set_opacity(0.0)
        self._ultracode_title.set_text("ULTRACODE")
        self._ultracode_sub.set_text("You know code — let’s make the change")

        def fade(widget: Gtk.Widget, start: float, end: float, ms: int) -> None:
            try:
                target = Adw.PropertyAnimationTarget.new(widget, "opacity")
                anim = Adw.TimedAnimation.new(widget, start, end, ms, target)
                anim.set_easing(Adw.Easing.EASE_OUT_CUBIC)
                self._ultracode_anims.append(anim)
                anim.play()
            except Exception:  # noqa: BLE001
                widget.set_opacity(end)

        # Chip pulse: dim → bright twice.
        fade(self._chip, 0.35, 1.0, 220)

        fade(burst, 0.0, 1.0, 280)

        def mid_pulse() -> bool:
            fade(self._chip, 0.45, 1.0, 200)
            return False

        def fade_out_burst() -> bool:
            fade(burst, 1.0, 0.0, 360)
            return False

        def hide_burst() -> bool:
            burst.set_visible(False)
            burst.set_opacity(0.0)
            self._clear_ultracode_flash()
            return False

        GLib.timeout_add(320, mid_pulse)
        GLib.timeout_add(720, fade_out_burst)
        GLib.timeout_add(1100, hide_burst)

    def _clear_ultracode_flash(self) -> None:
        try:
            self.remove_css_class("teddyos-ultracode-flash")
        except Exception:  # noqa: BLE001
