    def _mark_done(self) -> None:
        self._finished += 1
        if self._finished >= self._total and self._total:
            ok_n = sum(
                1 for c in self._cards.values()
                if (c.answer_text or "").strip() and not c.had_error
            )
            if ok_n >= 2:
                self._progress.set_text(
                    "Everyone answered. Reading all the answers together…"
                )
                self._start_synthesis()
            elif ok_n == 1:
                self._progress.set_text(
                    "All done. Read the answer below. "
                    "Tap a button under it to ask again or something else."
                )
                if getattr(self, "_synth_card", None) is not None:
                    self._synth_card.set_visible(False)
            else:
                self._progress.set_text(
                    "None of the AIs could answer this time. "
                    "Try sign-in from Search, or ask again in a moment."
                )
                if getattr(self, "_synth_card", None) is not None:
                    self._synth_card.set_visible(False)
        elif self._total:
            self._progress.set_text(
                f"{self._finished} of {self._total} finished… "
                "then we’ll look across every answer."
            )

    def _collect_answers(self) -> dict[str, str]:
        out: dict[str, str] = {}
        for tid, card in self._cards.items():
            text = (card.answer_text or "").strip()
            if text and not card.had_error:
                out[tid] = text
        return out

    def _pick_reviewer(self, answers: dict[str, str]) -> str | None:
        """Prefer Claude for the combined take, else any helper that answered."""
        prefer = (
            "claude", "grok", "copilot", "gemini", "codex", "antigravity",
        )
        for tid in prefer:
            if tid in answers and _headless_argv(tid, "ping", self._project):
                return tid
        for tid in answers:
            if _headless_argv(tid, "ping", self._project):
                return tid
        return None

    @staticmethod
    def _review_prompt(user_q: str, answers: dict[str, str]) -> str:
        """Build the meta-prompt that examines every AI’s output."""
        chunks: list[str] = []
        for tid, text in answers.items():
            title = _TITLES.get(tid, tid.title())
            body = text if len(text) <= 5000 else text[:5000] + "\n… (cut)"
            chunks.append(f"### {title}\n{body}")
        joined = "\n\n".join(chunks)
        return (
            "Several AI helpers each answered the same question about this "
            "project. Read every answer carefully, then write ONE combined "
            "take for the person.\n\n"
            f"## Original question\n{user_q}\n\n"
            f"## Answers to compare\n{joined}\n\n"
            "## What you must do\n"
            "- Open with the best short answer (match how technical the "
            "question is).\n"
            "- Say where the helpers agree.\n"
            "- Flag any important disagreements or risky advice.\n"
            "- Give exactly one concrete next step.\n"
            "- Do not invent project facts that none of the answers mention; "
            "if you add your own check, label it clearly.\n"
            "- Keep the whole combined take concise (a few short paragraphs)."
        )

    def _start_synthesis(self) -> None:
        if self._synth_started:
            return
        answers = self._collect_answers()
        if len(answers) < 2:
            return
        reviewer = self._pick_reviewer(answers)
        if not reviewer:
            self._synth_card.set_visible(False)
            self._progress.set_text(
                "All done. Read the answers below."
            )
            return
        self._synth_started = True
        self._synth_card.set_visible(True)
        self._synth_spinner.set_visible(True)
        self._synth_spinner.start()
        self._synth_status.set_text("Reading…")
        self._synth_body.add_css_class("dim-label")
        self._synth_body.set_text(
            "Comparing what each AI said and writing one clear takeaway…"
        )
        log.info(
            "synthesis start reviewer=%s n_answers=%d",
            reviewer, len(answers),
        )
        threading.Thread(
            target=self._run_synthesis,
            args=(reviewer, dict(answers), self._prompt),
            daemon=True,
        ).start()

    def _run_synthesis(
        self,
        reviewer: str,
        answers: dict[str, str],
        user_q: str,
    ) -> None:
        review = self._review_prompt(user_q, answers)
        argv = _headless_argv(reviewer, review, self._project)
        if not argv:
            GLib.idle_add(self._synth_fail, "Couldn’t start the combined review.")
            return
        env = os.environ.copy()
        path = env.get("PATH", "/usr/bin:/bin")
        for extra in ("/usr/local/bin", str(Path.home() / ".local" / "bin")):
            if extra not in path.split(":"):
                path = extra + ":" + path
        env["PATH"] = path
        env["TERM"] = env.get("TERM") or "xterm-256color"
        env["CI"] = "1"
        env["NO_COLOR"] = "1"
        env["COPILOT_ALLOW_ALL"] = "1"
        try:
            proc = subprocess.run(  # noqa: S603
                argv,
                cwd=self._project,
                env=env,
                capture_output=True,
                text=True,
                timeout=_TIMEOUT,
            )
            out = (proc.stdout or "").strip()
            err = (proc.stderr or "").strip()
            text = out or err
            if proc.returncode != 0 and not out:
                GLib.idle_add(
                    self._synth_fail,
                    "Couldn’t finish the combined review. "
                    "Read the individual answers below.",
                )
                return
            if not text:
                GLib.idle_add(
                    self._synth_fail,
                    "The combined review came back empty. "
                    "Read the individual answers below.",
                )
                return
            if len(text) > _MAX_CHARS:
                text = text[:_MAX_CHARS] + "\n\n… (cut short here)"
            GLib.idle_add(self._synth_ok, text, reviewer)
        except subprocess.TimeoutExpired:
            GLib.idle_add(
                self._synth_fail,
                "The combined review is taking too long. "
                "Read the individual answers below.",
            )
        except OSError:
            GLib.idle_add(
                self._synth_fail,
                "Couldn’t start the combined review.",
            )

    def _synth_ok(self, text: str, reviewer: str) -> bool:
        self._synth_spinner.stop()
        self._synth_spinner.set_visible(False)
        who = _TITLES.get(reviewer, reviewer)
        self._synth_status.set_text(f"Done · via {who}")
        self._synth_body.remove_css_class("dim-label")
        self._synth_body.set_text(format_answer_for_display(text) or (text or ""))
        self._progress.set_text(
            "All done. Start with “Across all answers”, "
            "then open any single AI below if you want more detail."
        )
        log.info("synthesis ok reviewer=%s chars=%d", reviewer, len(text))
        try:
            import progress as prog  # type: ignore
            snap = prog.award_synthesis()
            line = prog.format_toast(snap.events)
            if line:
                self._toast_progress(line)
        except Exception:  # noqa: BLE001
            pass
        return False

    def _synth_fail(self, message: str) -> bool:
        self._synth_spinner.stop()
        self._synth_spinner.set_visible(False)
        self._synth_status.set_text("Skipped")
        self._synth_body.remove_css_class("dim-label")
        self._synth_body.set_text(message)
        self._progress.set_text(
            "All done. Read the individual answers below."
        )
        log.warning("synthesis fail: %s", message)
        return False

    def _rerun_one(
        self,
        tool_id: str,
        prompt: str,
        prior_q: str = "",
        prior_a: str = "",
    ) -> None:
        """In-window re-ask (same or new prompt) — does not spawn a second app."""
        prompt = (prompt or "").strip()
        self._prompt = prompt
        # Keep “You asked” + mode chip in sync with the new question.
        if prompt and getattr(self, "_prompt_label", None) is not None:
            self._prompt_label.set_text(prompt)
        try:
            aud = detect_audience(prompt)
        except Exception:  # noqa: BLE001
            aud = Audience.PLAIN
        # Re-detect on every re-ask; animate on any persona switch.
        self._refresh_audience_chip(aud, animate=True)
        # Award persona XP / level-ups for the new ask (debounced with Search).
        try:
            import progress as prog  # type: ignore
            if hasattr(prog, "award_from_prompt") and prompt:
                snap = prog.award_from_prompt(prompt, multi_ai=False)
                line = prog.format_toast(getattr(snap, "events", []) or [])
                if line:
                    GLib.timeout_add(
                        350,
                        lambda l=line: (self._toast_progress(l), False)[1],
                    )
                # Refresh level chip after award
                if hasattr(prog, "persona_level_line") and getattr(
                    self, "_level_chip", None,
                ) is not None:
                    self._level_chip.set_text(prog.persona_level_line(aud))
        except Exception:  # noqa: BLE001
            pass
        name = _TITLES.get(tool_id, tool_id)
        self._progress.set_text(
            f"Asking {name}…"
            if prompt
            else f"Asking {name} again…"
        )
        threading.Thread(
            target=self._run_one,
            args=(tool_id, prompt, prior_q, prior_a),
            daemon=True,
        ).start()

    def _run_one(
        self,
        tool_id: str,
        prompt: str | None = None,
        prior_q: str = "",
        prior_a: str = "",
    ) -> None:
        prompt = prompt if prompt is not None else self._prompt
        model_text = prompt
        # Prefer in-window prior; else last-help file for follow-ups from Search.
        pq, pa = (prior_q or "").strip(), (prior_a or "").strip()
        if not (pq and pa):
            last = _load_last_help()
            if last and _looks_like_followup(prompt or ""):
                pq = (last.get("prompt") or "").strip()
                pa = (last.get("answer") or "").strip()
        if pq and pa and (prompt or "").strip() != pq:
            model_text = _thread_prompt(prompt or "", prior_q=pq, prior_a=pa)
            log.info(
                "thread context tool=%s prior_q_len=%d prior_a_len=%d",
                tool_id, len(pq), len(pa),
            )
        argv = _headless_argv(tool_id, model_text, self._project)
        title = _TITLES.get(tool_id, tool_id)
        if not argv:
            GLib.idle_add(
                self._cards[tool_id].set_error,
                f"{title} isn’t available for a quick answer.",
            )
            return
        try:
            aud = detect_audience(prompt)
            aud_s = getattr(aud, "value", aud)
        except Exception:  # noqa: BLE001
            aud_s = "?"
        log.info(
            "headless start tool=%s audience=%s argv0=%s",
            tool_id, aud_s, argv[0],
        )
        env = os.environ.copy()
        path = env.get("PATH", "/usr/bin:/bin")
        for extra in ("/usr/local/bin", str(Path.home() / ".local" / "bin")):
            if extra not in path.split(":"):
                path = extra + ":" + path
        env["PATH"] = path
        env["TERM"] = env.get("TERM") or "xterm-256color"
        # Prefer non-interactive; some tools honor these.
        env["CI"] = "1"
        env["NO_COLOR"] = "1"
        # Copilot non-interactive without this often only says "permission denied".
        env["COPILOT_ALLOW_ALL"] = "1"
        try:
            proc = subprocess.run(  # noqa: S603
                argv,
                cwd=self._project,
                env=env,
                capture_output=True,
                text=True,
                timeout=_TIMEOUT,
            )
            out = (proc.stdout or "").strip()
            err = (proc.stderr or "").strip()
            # Prefer stdout; some tools print the answer on stderr when broken.
            text = out or err
            if proc.returncode != 0 and not out:
                msg = self._friendly_error(title, err or out or f"exit {proc.returncode}")
                log.warning(
                    "headless fail tool=%s code=%s err=%s",
                    tool_id, proc.returncode, (err or "")[:200],
                )
                GLib.idle_add(self._cards[tool_id].set_error, msg)
                return
            if not text:
                log.warning("headless empty tool=%s code=%s", tool_id, proc.returncode)
                GLib.idle_add(
                    self._cards[tool_id].set_error,
                    f"{title} finished without an answer. "
                    "Try asking again in a moment.",
                )
                return
            # Claude sometimes prints only "Execution error" when tools fail.
            if text.strip().lower() in ("execution error", "error") or (
                len(text) < 40 and "execution error" in text.lower()
            ):
                log.warning("headless execution-error tool=%s text=%r", tool_id, text[:80])
                GLib.idle_add(
                    self._cards[tool_id].set_error,
                    f"{title} hit a problem working in this folder. "
                    "Try a more specific ask (for example “what is this repo?”), "
                    "or open Claude from Connect and try again.",
                )
                return
            log.info("headless ok tool=%s chars=%d", tool_id, len(text))
            GLib.idle_add(self._cards[tool_id].set_answer, text)
        except subprocess.TimeoutExpired:
            log.warning("headless timeout tool=%s after=%ss", tool_id, _TIMEOUT)
            GLib.idle_add(
                self._cards[tool_id].set_error,
                f"{title} is taking too long. Try a shorter question "
                "(for example “what does this project do?”), or ask again "
                "in a moment.",
            )
        except OSError as exc:
            log.error("headless oserror tool=%s: %s", tool_id, exc)
            GLib.idle_add(
                self._cards[tool_id].set_error,
                f"Couldn’t start {title} on this computer.",
            )

    @staticmethod
    def _friendly_error(title: str, raw: str) -> str:
        low = (raw or "").lower()
        if any(
            s in low
            for s in (
                "auth", "login", "sign in", "not logged", "api key",
                "unauthorized", "401", "please run", "not authenticated",
            )
        ):
            return (
                f"{title} needs a quick sign-in first. "
                "Go back to Search, tap Continue, finish sign-in, then ask again."
            )
        if "permission denied" in low or "permissions" in low and "denied" in low:
            return (
                f"{title} couldn’t work on this project. "
                "Try signing in again from Search, or ask again in a moment."
            )
        if any(
            s in low
            for s in ("credit", "quota", "rate limit", "usage limit", "too low")
        ):
            return (
                f"{title} is out of free uses for now. "
                "Try another answer above, or try again later."
            )
        if "403" in low:
            return (
                f"{title} was refused access. "
                "Go back to Search, sign in again, then retry."
            )
        return (
            f"{title} couldn’t answer this time. "
            "Try again, or finish sign-in from Search if you haven’t yet."
        )


class AskAllApp(Adw.Application):
    def __init__(self, project: str, prompt: str, tool_ids: list[str]):
        super().__init__(application_id=APP_ID)
        self._project = project
        self._prompt = prompt
        self._tool_ids = tool_ids

    def do_activate(self):
        win = self.props.active_window
        if win is None:
            win = AskAllWindow(
                self, self._project, self._prompt, self._tool_ids,
            )
            # Dock / alt-tab: friendly answers icon, not a generic gear.
            try:
                win.set_icon_name("teddyos-answers")
            except Exception:  # noqa: BLE001
                pass
        win.present()


def main() -> int:
    args = _parse()
    project = os.path.abspath(os.path.expanduser(args.project))
    if not os.path.isdir(project):
        print(f"not a directory: {project}", file=sys.stderr)
        return 2
    prompt = (args.prompt or "").strip()
    if not prompt:
        print("prompt is empty", file=sys.stderr)
        return 2
    tools = [t.strip().lower() for t in args.tools.split(",") if t.strip()]
    if not tools:
        print("no tools", file=sys.stderr)
        return 2
    GLib.set_prgname(APP_ID)
    # Also advertise a human name so the shell doesn't only show the app id.
    try:
        GLib.set_application_name("Answers")
    except Exception:  # noqa: BLE001
        pass
    log.info("start project=%s tools=%s prompt_len=%d", project, tools, len(prompt))
    app = AskAllApp(project, prompt, tools)
    return app.run([sys.argv[0]])


if __name__ == "__main__":
    sys.exit(main())
