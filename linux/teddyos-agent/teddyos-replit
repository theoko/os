#!/usr/bin/env python3
"""Open Replit as a simple browser window.

Replit Agent is web-first for non-technical people: describe an app, it
builds it. A desktop AppImage may exist on some machines; this launcher
always works when Chromium is present.
"""

from __future__ import annotations

import os
import shutil
import subprocess
import sys

# Agent entry is the plain-language path; logged-in users land in their hub.
URL = "https://replit.com/"
CLASS = "teddyos-replit"
DATA = os.path.expanduser("~/.config/teddyos-replit")


def main() -> int:
    # Prefer a native desktop binary if the person installed one.
    for name in ("replit", "Replit", "replit-desktop"):
        native = shutil.which(name)
        if native:
            try:
                subprocess.Popen(  # noqa: S603
                    [native],
                    start_new_session=True,
                    stdin=subprocess.DEVNULL,
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL,
                )
                return 0
            except OSError:
                pass

    chromium = (
        shutil.which("chromium")
        or shutil.which("chromium-browser")
        or shutil.which("google-chrome")
        or shutil.which("google-chrome-stable")
    )
    if not chromium:
        print("no browser available for Replit", file=sys.stderr)
        return 1
    os.makedirs(DATA, exist_ok=True)
    argv = [
        chromium,
        f"--app={URL}",
        f"--class={CLASS}",
        f"--user-data-dir={DATA}",
    ]
    try:
        subprocess.Popen(  # noqa: S603
            argv,
            start_new_session=True,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
    except OSError as exc:
        print(exc, file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
