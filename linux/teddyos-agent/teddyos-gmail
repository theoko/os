    def _select_provider(self, pid: str) -> None:
        btn = self._provider_buttons.get(pid)
        if btn is not None:
            btn.set_active(True)
        self._provider_id = pid
        self._other_entry.set_sensitive(pid == "other")
        if pid == "other":
            self._other_entry.grab_focus()

    def _on_provider_toggled(self, btn: Gtk.CheckButton, pid: str) -> None:
        if btn.get_active():
            self._provider_id = pid
            self._other_entry.set_sensitive(pid == "other")

    def _on_other_url_changed(self, entry: Gtk.Entry) -> None:
        self._custom_url = entry.get_text().strip()

    def _resolved_provider(self) -> tuple[dict, str] | None:
        p = _provider_by_id(self._provider_id) or PROVIDERS[0]
        if p["id"] == "other":
            url = self._custom_url.strip()
            if not url:
                return None
            if not url.startswith(("http://", "https://")):
                url = "https://" + url
            return p, url
        return p, p["url"]

    def _dots_for(self, step: int) -> str:
        return " ".join("●" if i == step else "○" for i in range(4))

    def _show_step(self, step: int) -> None:
        self._step = step
        names = ("intro", "control", "choose", "open")
        self._stack.set_visible_child_name(names[step])

        # Update dots on simple pages (first two have a child named dots)
        for page_name in ("intro", "control"):
            page = self._stack.get_child_by_name(page_name)
            if page is None:
                continue
            child = page.get_first_child()
            while child is not None:
                if child.get_name() == "dots" and isinstance(child, Gtk.Label):
                    child.set_text(self._dots_for(step))
                child = child.get_next_sibling()

        if step == self.STEP_CHOOSE:
            self._choose_dots.set_text(self._dots_for(step))
            self._primary.set_label("Continue")
            self._secondary.set_label("Back")
            self._later.set_visible(False)
            self._phone_btn.set_visible(False)
            self._phone_box.set_visible(False)
            self._stop_phone_link()
        elif step == self.STEP_OPEN:
            p = _provider_by_id(self._provider_id) or PROVIDERS[0]
            self._open_title.set_text(f"Open {p['label']}")
            if p["id"] == "other":
                self._open_body.set_text(
                    "Open on this computer, or link from your phone with a QR "
                    "(same Wi‑Fi).\n\n"
                    "Your password stays on the email site — teddyOS never stores it."
                )
            else:
                self._open_body.set_text(
                    f"Open {p['label']} on this computer, or scan a QR to continue "
                    "on your phone (same Wi‑Fi).\n\n"
                    "Sign in once if needed. AI never sends mail for you."
                )
            self._open_dots.set_text(self._dots_for(step))
            self._primary.set_label(f"Open on this computer")
            self._secondary.set_label("Back")
            self._later.set_visible(False)
            self._phone_btn.set_visible(True)
            self._phone_box.set_visible(False)
        elif step == self.STEP_INTRO:
            self._primary.set_label("Show me how")
            self._secondary.set_label("Skip for now")
            self._later.set_visible(True)
            self._phone_btn.set_visible(False)
            self._phone_box.set_visible(False)
            self._stop_phone_link()
        else:
            self._primary.set_label("Next")
            self._secondary.set_label("Back")
            self._later.set_visible(False)
            self._phone_btn.set_visible(False)
            self._phone_box.set_visible(False)
            self._stop_phone_link()

    def _on_key(self, _c, keyval, _code, _state) -> bool:
        if keyval == Gdk.KEY_Escape:
            self._finish(open_inbox=False)
            return True
        if keyval in (Gdk.KEY_Return, Gdk.KEY_KP_Enter, Gdk.KEY_Right):
            self._on_primary()
            return True
        if keyval == Gdk.KEY_Left and self._step > 0:
            self._show_step(self._step - 1)
            return True
        return False

    def _on_primary(self, *_args) -> None:
        if self._step == self.STEP_INTRO:
            self._show_step(self.STEP_CONTROL)
        elif self._step == self.STEP_CONTROL:
            self._show_step(self.STEP_CHOOSE)
        elif self._step == self.STEP_CHOOSE:
            if self._provider_id == "other" and not self._custom_url.strip():
                self._other_entry.grab_focus()
                self._other_entry.add_css_class("error")
                return
            self._other_entry.remove_css_class("error")
            self._show_step(self.STEP_OPEN)
        else:
            self._finish(open_inbox=True)

    def _on_secondary(self, *_args) -> None:
        if self._step == self.STEP_INTRO:
            self._finish(open_inbox=False)
            return
        self._show_step(self._step - 1)

    def _start_phone_link(self, *_a) -> None:
        """LAN page + QR so the phone can open the same webmail (same Wi‑Fi)."""
        resolved = self._resolved_provider()
        if resolved is None:
            self._show_step(self.STEP_CHOOSE)
            self._other_entry.grab_focus()
            return
        p, url = resolved
        if phone_auth is None:
            self._phone_label.set_text(
                "Phone link isn’t available right now. Use Open on this computer."
            )
            self._phone_box.set_visible(True)
            return
        self._stop_phone_link()
        try:
            srv = phone_auth.PhonePairServer(
                title=f"{p['label']} on your phone",
                open_url=url,
                blurb=(
                    f"Open {p['label']} here to sign in or read mail on your phone. "
                    "Then continue on the computer if you also want it there."
                ),
            )
            pair_url = srv.start()
            self._pair_server = srv
        except OSError:
            self._phone_label.set_text(
                "Couldn’t start phone link. Use Open on this computer instead."
            )
            self._phone_box.set_visible(True)
            return
        path = phone_auth.qr_temp_png(pair_url)
        if path is not None:
            self._qr_path = path
            try:
                self._phone_qr.set_from_file(str(path))
                self._phone_qr.set_visible(True)
            except GLib.Error:
                self._phone_qr.set_visible(False)
        else:
            self._phone_qr.set_visible(False)
        self._phone_label.set_text(
            f"Scan with your phone (same Wi‑Fi).\n{pair_url}\n\n"
            "Then you can also open it on this computer."
        )
        self._phone_box.set_visible(True)
        self._phone_btn.set_label("Refresh phone QR")

    def _stop_phone_link(self) -> None:
        if self._pair_server is not None:
            try:
                self._pair_server.stop()
            except Exception:  # noqa: BLE001
                pass
            self._pair_server = None
        if self._qr_path is not None:
            try:
                self._qr_path.unlink(missing_ok=True)
            except OSError:
                pass
            self._qr_path = None

    def _finish(self, *, open_inbox: bool) -> None:
        if open_inbox:
            resolved = self._resolved_provider()
            if resolved is None:
                # No URL for Other — bounce back to picker.
                self._show_step(self.STEP_CHOOSE)
                self._other_entry.grab_focus()
                return
            p, url = resolved
            _save_state(
                {
                    "provider_id": p["id"],
                    "custom_url": self._custom_url if p["id"] == "other" else "",
                }
            )
            _open_mail_app(url=url, profile=p["profile"], class_name=p["class"])
        self._stop_phone_link()
        self.close()


class App(Adw.Application):
    def __init__(self) -> None:
        super().__init__(
            application_id=APP_ID,
            flags=Gio.ApplicationFlags.FLAGS_NONE,
        )

    def do_activate(self) -> None:  # noqa: N802
        win = self.props.active_window
        if win is None:
            win = GuideWindow(self)
        win.present()


def main() -> int:
    if not os.environ.get("DISPLAY") and not os.environ.get("WAYLAND_DISPLAY"):
        st = _load_state()
        p = _provider_by_id(st.get("provider_id") or "gmail") or PROVIDERS[0]
        url = p["url"]
        if p["id"] == "other":
            url = (st.get("custom_url") or "").strip()
            if url and not url.startswith(("http://", "https://")):
                url = "https://" + url
        if url:
            _open_mail_app(url=url, profile=p["profile"], class_name=p["class"])
        return 0
    return App().run(None)


if __name__ == "__main__":
    sys.exit(main())
