import os
import shutil
import subprocess
import sys
from pathlib import Path

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
from gi.repository import Adw, Gdk, Gio, GLib, Gtk  # noqa: E402

sys.path.insert(0, "/usr/lib/teddyos")
sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "teddyos-search"))
try:
    import phone_auth
except Exception:  # noqa: BLE001
    phone_auth = None  # type: ignore

APP_ID = "com.teddyos.Gmail"
STATE = Path.home() / ".config" / "teddyos" / "email-provider.json"
APPS_ROOT = Path.home() / ".local/share/teddyos-apps"

# id, label, web URL, profile folder, chromium --class
PROVIDERS: list[dict] = [
    {
