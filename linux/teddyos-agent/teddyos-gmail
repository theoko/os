#!/usr/bin/env python3
"""Email — open your inbox fast. First time: pick a provider. After that: open."""

from __future__ import annotations

import json
import os
import shutil
import subprocess
import sys
from pathlib import Path

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
from gi.repository import Adw, Gdk, Gio, GLib, Gtk  # noqa: E402

sys.path.insert(0, "/usr/lib/teddyos")
try:
    import phone_auth
except Exception:  # noqa: BLE001
    phone_auth = None  # type: ignore

APP_ID = "com.teddyos.Gmail"
STATE = Path.home() / ".config" / "teddyos" / "email-provider.json"
APPS_ROOT = Path.home() / ".local/share/teddyos-apps"

PROVIDERS = [
    {"id": "gmail", "label": "Gmail", "hint": "Google",
     "url": "https://mail.google.com/", "profile": "gmail", "class": "teddyos-gmail"},
    {"id": "outlook", "label": "Outlook", "hint": "Microsoft / Hotmail / Live",
     "url": "https://outlook.live.com/mail/", "profile": "outlook", "class": "teddyos-outlook"},
    {"id": "yahoo", "label": "Yahoo Mail", "hint": "Yahoo",
     "url": "https://mail.yahoo.com/", "profile": "yahoo", "class": "teddyos-yahoo"},
    {"id": "icloud", "label": "iCloud Mail", "hint": "Apple",
     "url": "https://www.icloud.com/mail", "profile": "icloud", "class": "teddyos-icloud"},
    {"id": "proton", "label": "Proton Mail", "hint": "Proton",
     "url": "https://mail.proton.me/", "profile": "proton", "class": "teddyos-proton"},
    {"id": "other", "label": "Other email", "hint": "Any webmail link",
     "url": "", "profile": "other-mail", "class": "teddyos-other-mail"},
]


def _load_state():
    try:
        return json.loads(STATE.read_text())
    except (OSError, ValueError, TypeError):
        return {}


def _save_state(data):
    try:
        STATE.parent.mkdir(parents=True, exist_ok=True)
        STATE.write_text(json.dumps(data, indent=2) + "\n")
    except OSError:
        pass


def _provider_by_id(pid):
    for p in PROVIDERS:
        if p["id"] == pid:
            return p
    return None


def _url_for_state(st):
    p = _provider_by_id(st.get("provider_id") or "")
    if p is None:
        return None
    if p["id"] == "other":
        url = (st.get("custom_url") or "").strip()
        if not url:
            return None
        if not url.startswith(("http://", "https://")):
            url = "https://" + url
        return p, url
    return p, p["url"]


def _open_mail_app(*, url, profile, class_name):
    chromium = (
        shutil.which("chromium")
        or shutil.which("chromium-browser")
        or shutil.which("google-chrome")
        or shutil.which("google-chrome-stable")
    )
    if not chromium or not url:
        return
    data = APPS_ROOT / profile
    data.mkdir(parents=True, exist_ok=True)
    argv = [
        chromium, f"--app={url}", f"--class={class_name}",
        f"--user-data-dir={data}", "--password-store=basic",
        "--ozone-platform-hint=auto",
    ]
    try:
        subprocess.Popen(
            argv, start_new_session=True,
            stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        )
    except OSError:
        pass


def _open_saved_inbox():
    resolved = _url_for_state(_load_state())
    if resolved is None:
        return False
    p, url = resolved
    _open_mail_app(url=url, profile=p["profile"], class_name=p["class"])
    return True


class SetupWindow(Adw.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title="Email")
        self.set_default_size(480, 560)
        self.set_resizable(False)
        st = _load_state()
        self._provider_id = st.get("provider_id") or "gmail"
        self._custom_url = st.get("custom_url") or ""
        self._qr_path = None

        css = Gtk.CssProvider()
        css.load_from_data(b"""
            .teddyos-guide-title { font-size: 24px; font-weight: 700; }
            .teddyos-provider-row { padding: 10px 12px; border-radius: 12px; }
            .teddyos-provider-row:hover { background: alpha(@accent_bg_color, 0.12); }
            window { background: #fbfbfa; }
        """)
        Gtk.StyleContext.add_provider_for_display(
            self.get_display(), css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )

        title = Gtk.Label(label="Email", wrap=True, justify=Gtk.Justification.CENTER)
        title.add_css_class("teddyos-guide-title")
        title.set_margin_top(8)

        trust = Gtk.Label(
            label="AI only drafts replies. You always send.\n"
            "Passwords stay on the email site — never in teddyOS.",
            wrap=True, justify=Gtk.Justification.CENTER, max_width_chars=40,
        )
        trust.add_css_class("dim-label")
        trust.add_css_class("caption")
        trust.set_margin_top(6)
        trust.set_margin_bottom(10)

        ask = Gtk.Label(label="Which email do you use?", wrap=True, justify=Gtk.Justification.CENTER)
        ask.add_css_class("heading")
        ask.set_margin_bottom(6)

        first_radio = None
        self._provider_buttons = {}
        list_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        for p in PROVIDERS:
            row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
            row.add_css_class("teddyos-provider-row")
            radio = Gtk.CheckButton()
            if first_radio is None:
                first_radio = radio
            else:
                radio.set_group(first_radio)
            if p["id"] == self._provider_id:
                radio.set_active(True)
            radio.connect("toggled", self._on_provider_toggled, p["id"])
            self._provider_buttons[p["id"]] = radio
            labels = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1, hexpand=True)
            name = Gtk.Label(label=p["label"], xalign=0)
            name.add_css_class("heading")
            hint = Gtk.Label(label=p["hint"], xalign=0)
            hint.add_css_class("caption")
            hint.add_css_class("dim-label")
            labels.append(name)
            labels.append(hint)
            click = Gtk.GestureClick()
            click.connect("released", lambda _g, _n, _x, _y, pid=p["id"]: self._select_provider(pid))
            row.add_controller(click)
            row.append(radio)
            row.append(labels)
            list_box.append(row)

        scroller = Gtk.ScrolledWindow(vexpand=True, min_content_height=200)
        scroller.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        scroller.set_child(list_box)

        self._other_entry = Gtk.Entry(placeholder_text="https://mail.example.com  (Other only)", hexpand=True)
        self._other_entry.set_margin_top(8)
        if self._custom_url:
            self._other_entry.set_text(self._custom_url)
        self._other_entry.set_sensitive(self._provider_id == "other")
        self._other_entry.connect("changed", self._on_other_url_changed)

        self._primary = Gtk.Button(label="Open Email")
        self._primary.add_css_class("suggested-action")
        self._primary.add_css_class("pill")
        self._primary.set_size_request(280, -1)
        self._primary.set_halign(Gtk.Align.CENTER)
        self._primary.set_margin_top(14)
        self._primary.connect("clicked", self._open_computer)

        self._phone_btn = Gtk.Button(label="Open on my phone")
        self._phone_btn.add_css_class("flat")
        self._phone_btn.set_halign(Gtk.Align.CENTER)
        self._phone_btn.set_margin_top(4)
        self._phone_btn.connect("clicked", self._show_phone_qr)

        self._phone_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6, halign=Gtk.Align.CENTER)
        self._phone_box.set_visible(False)
        self._phone_box.set_margin_top(8)
        self._phone_qr = Gtk.Image(pixel_size=160, halign=Gtk.Align.CENTER)
        self._phone_label = Gtk.Label(wrap=True, justify=Gtk.Justification.CENTER, max_width_chars=38)
        self._phone_label.add_css_class("dim-label")
        self._phone_label.add_css_class("caption")
        self._phone_box.append(self._phone_qr)
        self._phone_box.append(self._phone_label)

        self._status = Gtk.Label(label="", wrap=True, justify=Gtk.Justification.CENTER, max_width_chars=40)
        self._status.add_css_class("dim-label")
        self._status.add_css_class("caption")
        self._status.set_visible(False)

        body = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        body.set_margin_start(20)
        body.set_margin_end(20)
        body.set_margin_top(4)
        body.set_margin_bottom(12)
        for w in (title, trust, ask, scroller, self._other_entry, self._primary, self._phone_btn, self._phone_box, self._status):
            body.append(w)

        toolbar = Adw.ToolbarView()
        header = Adw.HeaderBar()
        header.set_title_widget(Adw.WindowTitle(title="Email", subtitle=""))
        close_btn = Gtk.Button(label="Close")
        close_btn.add_css_class("flat")
        close_btn.connect("clicked", lambda *_: self.close())
        header.pack_end(close_btn)
        toolbar.add_top_bar(header)
        toolbar.set_content(Adw.Clamp(maximum_size=460, child=body))
        self.set_content(toolbar)

        esc = Gtk.EventControllerKey()
        esc.connect("key-pressed", self._on_key)
        self.add_controller(esc)

    def _select_provider(self, pid):
        btn = self._provider_buttons.get(pid)
        if btn is not None:
            btn.set_active(True)
        self._provider_id = pid
        self._other_entry.set_sensitive(pid == "other")
        self._hide_phone_qr()
        if pid == "other":
            self._other_entry.grab_focus()

    def _on_provider_toggled(self, btn, pid):
        if btn.get_active():
            self._provider_id = pid
            self._other_entry.set_sensitive(pid == "other")
            self._hide_phone_qr()

    def _on_other_url_changed(self, entry):
        self._custom_url = entry.get_text().strip()

    def _resolved(self):
        p = _provider_by_id(self._provider_id) or PROVIDERS[0]
        if p["id"] == "other":
            url = self._custom_url.strip()
            if not url:
                return None
            if not url.startswith(("http://", "https://")):
                url = "https://" + url
            return p, url
        return p, p["url"]

    def _persist(self, p):
        _save_state({
            "provider_id": p["id"],
            "custom_url": self._custom_url if p["id"] == "other" else "",
            "setup_done": True,
        })

    def _open_computer(self, *_a):
        resolved = self._resolved()
        if resolved is None:
            self._flash("Paste a webmail link for Other email.")
            self._other_entry.grab_focus()
            return
        p, url = resolved
        self._persist(p)
        _open_mail_app(url=url, profile=p["profile"], class_name=p["class"])
        self.close()

    def _show_phone_qr(self, *_a):
        resolved = self._resolved()
        if resolved is None:
            self._flash("Pick a provider (or paste a link for Other).")
            return
        p, url = resolved
        if phone_auth is None:
            self._flash("Phone QR is not available. Use Open Email.")
            return
        self._persist(p)
        self._hide_phone_qr()
        path = phone_auth.qr_temp_png(url)
        if path is not None:
            self._qr_path = path
            try:
                self._phone_qr.set_from_file(str(path))
                self._phone_qr.set_visible(True)
            except GLib.Error:
                self._phone_qr.set_visible(False)
        else:
            self._phone_qr.set_visible(False)
        self._phone_label.set_text(
            f"Scan to open {p['label']} on your phone.\n"
            "Any network is fine.\n\n"
            "This does not sign in Email on this computer — "
            "use Open Email for that."
        )
        self._phone_box.set_visible(True)
        self._phone_btn.set_label("Refresh phone QR")

    def _hide_phone_qr(self):
        self._phone_box.set_visible(False)
        self._phone_btn.set_label("Open on my phone")
        if self._qr_path is not None:
            try:
                self._qr_path.unlink(missing_ok=True)
            except OSError:
                pass
            self._qr_path = None

    def _flash(self, msg):
        self._status.set_text(msg)
        self._status.set_visible(True)

    def _on_key(self, _c, keyval, _code, _state):
        if keyval == Gdk.KEY_Escape:
            self.close()
            return True
        if keyval in (Gdk.KEY_Return, Gdk.KEY_KP_Enter):
            self._open_computer()
            return True
        return False

    def do_close_request(self):
        self._hide_phone_qr()
        return False


class App(Adw.Application):
    def __init__(self, *, force_setup=False):
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.FLAGS_NONE)
        self._force_setup = force_setup

    def do_activate(self):
        # Returning users: open inbox immediately (dock feels instant).
        if not self._force_setup and _url_for_state(_load_state()) is not None:
            if _open_saved_inbox():
                GLib.idle_add(self.quit)
                return
        win = self.props.active_window
        if win is None:
            win = SetupWindow(self)
        win.present()


def main(argv=None):
    argv = list(argv if argv is not None else sys.argv)
    force_setup = "--setup" in argv or "--guide" in argv
    argv = [a for a in argv if a not in ("--setup", "--guide")]

    if not os.environ.get("DISPLAY") and not os.environ.get("WAYLAND_DISPLAY"):
        if not force_setup:
            _open_saved_inbox()
        return 0

    return App(force_setup=force_setup).run(argv)


if __name__ == "__main__":
    sys.exit(main())
