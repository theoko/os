        sub.add_css_class("dim-label")
        sub.set_margin_top(6)
        sub.set_margin_bottom(12)

        self._provider_group = Gtk.CheckButton()  # invisible radio root
        self._provider_group.set_visible(False)

        list_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        list_box.set_margin_start(8)
        list_box.set_margin_end(8)
        self._provider_buttons: dict[str, Gtk.CheckButton] = {}

        first_radio: Gtk.CheckButton | None = None
        for p in PROVIDERS:
            row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
            row.add_css_class("teddyos-provider-row")
            radio = Gtk.CheckButton(label="")
            if first_radio is None:
                first_radio = radio
            else:
                radio.set_group(first_radio)
            if p["id"] == self._provider_id:
                radio.set_active(True)
            radio.connect("toggled", self._on_provider_toggled, p["id"])
            self._provider_buttons[p["id"]] = radio

            labels = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2, hexpand=True)
            name = Gtk.Label(label=p["label"], xalign=0)
