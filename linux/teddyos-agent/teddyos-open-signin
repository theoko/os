#!/usr/bin/env python3
"""Open a sign-in URL in Chromium — never Firefox by accident.

OAuth helpers (Antigravity, Claude, …) call $BROWSER or xdg-open. On this
image the dock web apps already use Chromium; dropping people into a random
Firefox window feels broken and off-brand. This launcher is what we set as
BROWSER during Connect so every vendor sign-in lands in one familiar place.
"""

from __future__ import annotations

import os
import shutil
import subprocess
import sys


def _browser() -> str | None:
    for name in (
        "chromium",
        "chromium-browser",
        "google-chrome-stable",
        "google-chrome",
    ):
        hit = shutil.which(name)
        if hit:
            return hit
    return None


def main(argv: list[str]) -> int:
    if len(argv) < 2 or not argv[1].strip():
        print("usage: teddyos-open-signin <url>", file=sys.stderr)
        return 2
    url = argv[1].strip()
    # Some tools pass: browser %s  or  browser -- URL
    for a in argv[1:]:
        if a.startswith("http://") or a.startswith("https://"):
            url = a
            break

    chromium = _browser()
    if not chromium:
        # Last resort — still better than failing silently.
        try:
            subprocess.Popen(  # noqa: S603
                ["xdg-open", url],
                start_new_session=True,
                stdin=subprocess.DEVNULL,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
            )
            return 0
        except OSError:
            return 1

    # App window: no tabs, no “which browser is this?”, matches Perplexity/Web.
    data = os.path.expanduser("~/.config/teddyos-signin")
    os.makedirs(data, exist_ok=True)
    cmd = [
        chromium,
        f"--app={url}",
        f"--user-data-dir={data}",
        "--class=teddyos-signin",
        "--new-window",
    ]
    try:
        subprocess.Popen(  # noqa: S603
            cmd,
            start_new_session=True,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
    except OSError as exc:
        print(exc, file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
