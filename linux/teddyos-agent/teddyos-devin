#!/usr/bin/env python3
"""Open Devin (Cognition) as a simple browser window.

Devin is a web product for most people (app.devin.ai). There is also a
CLI, but non-technical users should never have to find a curl installer.
One window, own profile, no address-bar homework.
"""

from __future__ import annotations

import os
import shutil
import subprocess
import sys

URL = "https://app.devin.ai/"
CLASS = "teddyos-devin"
DATA = os.path.expanduser("~/.config/teddyos-devin")


def main() -> int:
    chromium = (
        shutil.which("chromium")
        or shutil.which("chromium-browser")
        or shutil.which("google-chrome")
        or shutil.which("google-chrome-stable")
    )
    if not chromium:
        print("no browser available for Devin", file=sys.stderr)
        return 1
    os.makedirs(DATA, exist_ok=True)
    argv = [
        chromium,
        f"--app={URL}",
        f"--class={CLASS}",
        f"--user-data-dir={DATA}",
    ]
    try:
        subprocess.Popen(  # noqa: S603
            argv,
            start_new_session=True,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
    except OSError as exc:
        print(exc, file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
