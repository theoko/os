#!/usr/bin/env python3
"""Connect your helpers — sign in without ever seeing a terminal.

Vendors use browser OAuth. We start their login command in the background
(hidden), open any URL they print, and show only plain-language status.
No VTE, no monospaced dump, no “CLI”.
"""

from __future__ import annotations

import os
import re
import shutil
import subprocess
import sys
import threading
from pathlib import Path

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
from gi.repository import Adw, GLib, Gtk  # noqa: E402

sys.path.insert(0, "/usr/lib/teddyos")
try:
    import accounts as acc
    from logutil import get_logger
    log = get_logger("accounts")
except Exception:  # noqa: BLE001
    import logging
    log = logging.getLogger("teddyos.accounts")
    acc = None  # type: ignore

APP_ID = "com.teddyos.Accounts"

_URL_RE = re.compile(r"https?://[^\s\"'<>]+", re.I)
# Device / user codes: XXXX-XXXX or similar
_CODE_RE = re.compile(
    r"\b([A-Z0-9]{4,5}-[A-Z0-9]{4,5})\b|\benter code[:\s]+([A-Z0-9-]{6,})\b",
    re.I,
)


def _open_signin_url(url: str) -> None:
    """Always Chromium app window — never a random Firefox tab."""
    opener = shutil.which("teddyos-open-signin")
    if opener:
        argv = [opener, url]
    else:
        chromium = (
            shutil.which("chromium")
            or shutil.which("chromium-browser")
        )
        if chromium:
            data = os.path.expanduser("~/.config/teddyos-signin")
            os.makedirs(data, exist_ok=True)
            argv = [
                chromium,
                f"--app={url}",
                f"--user-data-dir={data}",
                "--class=teddyos-signin",
                "--new-window",
            ]
        else:
            argv = ["xdg-open", url]
    try:
        subprocess.Popen(  # noqa: S603
            argv,
            start_new_session=True,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
    except OSError as exc:
        log.error("open sign-in url failed: %s", exc)


class SignInWindow(Adw.ApplicationWindow):
    """Friendly sign-in — spinner, hint, optional code, no terminal."""

    def __init__(
        self,
        app: Adw.Application,
        account: "acc.Account",
        argv: list[str],
    ):
        super().__init__(
            application=app,
            title=f"Sign in to {account.title}",
        )
        self.set_default_size(480, 360)
        self._account = account
        self._proc: subprocess.Popen | None = None
        self._opened_urls: set[str] = set()

        header = Adw.HeaderBar()
        header.set_title_widget(Adw.WindowTitle(
            title=f"Sign in to {account.title}",
            subtitle="A browser window should open",
        ))

        self._status = Adw.StatusPage(
            icon_name="network-workgroup-symbolic",
            title=f"Connecting {account.title}…",
            description=account.connect_hint,
        )

        self._spinner = Gtk.Spinner()
        self._spinner.start()
        self._spinner.set_halign(Gtk.Align.CENTER)
        self._spinner.set_margin_bottom(8)

        self._code_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        self._code_box.set_halign(Gtk.Align.CENTER)
        self._code_box.set_visible(False)
        code_caption = Gtk.Label(label="If the browser asks for a code, use this:")
        code_caption.add_css_class("dim-label")
        self._code_label = Gtk.Label(label="")
        self._code_label.add_css_class("title-1")
        self._code_label.set_selectable(True)
        self._code_box.append(code_caption)
        self._code_box.append(self._code_label)

        self._link_btn = Gtk.Button(label="Open sign-in page again")
        self._link_btn.set_halign(Gtk.Align.CENTER)
        self._link_btn.set_visible(False)
        self._link_btn.connect("clicked", self._reopen_link)
        self._last_url = ""

        done = Gtk.Button(label="I’m done signing in")
        done.add_css_class("suggested-action")
        done.add_css_class("pill")
        done.set_halign(Gtk.Align.CENTER)
        done.set_margin_top(16)
        done.connect("clicked", self._finish)

        extras = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        extras.set_halign(Gtk.Align.CENTER)
        extras.append(self._spinner)
        extras.append(self._code_box)
        extras.append(self._link_btn)
        extras.append(done)
        self._status.set_child(extras)

        toolbar = Adw.ToolbarView()
        toolbar.add_top_bar(header)
        toolbar.set_content(self._status)
        self.set_content(toolbar)

        log.info("connect start id=%s argv=%s", account.id, argv)
        threading.Thread(
            target=self._run_login, args=(argv,), daemon=True,
        ).start()

    def _run_login(self, argv: list[str]) -> None:
        env = os.environ.copy()
        path = env.get("PATH", "/usr/bin:/bin")
        for extra in ("/usr/local/bin", str(Path.home() / ".local" / "bin")):
            if extra not in path.split(":"):
                path = extra + ":" + path
        env["PATH"] = path
        env["TERM"] = "dumb"
        env["NO_COLOR"] = "1"
        # Force Chromium for every helper that shells out to $BROWSER / xdg-open.
        # Firefox is installed for general browsing but OAuth in a random FF
        # window confuses people on a Chromium-first desktop.
        signin = shutil.which("teddyos-open-signin")
        if signin:
            env["BROWSER"] = signin
        else:
            env["BROWSER"] = (
                shutil.which("chromium")
                or shutil.which("chromium-browser")
                or "xdg-open"
            )
        # Some tools (Electron/Google) respect these too.
        env["CHROME_PATH"] = (
            shutil.which("chromium")
            or shutil.which("chromium-browser")
            or env.get("CHROME_PATH", "")
        )
        try:
            self._proc = subprocess.Popen(  # noqa: S603
                argv,
                cwd=os.path.expanduser("~"),
                env=env,
                stdin=subprocess.DEVNULL,
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
                text=True,
                bufsize=1,
            )
        except OSError as exc:
            log.error("connect spawn failed: %s", exc)
            GLib.idle_add(
                self._fail,
                f"Couldn’t start sign-in for {self._account.title}.",
            )
            return

        assert self._proc.stdout is not None
        buf = []
        try:
            for line in self._proc.stdout:
                buf.append(line)
                self._handle_line(line)
        except Exception as exc:  # noqa: BLE001
            log.error("connect read: %s", exc)
        code = self._proc.wait()
        log.info("connect exit id=%s code=%s", self._account.id, code)
        GLib.idle_add(self._login_process_finished, code, "".join(buf)[-800:])

    def _handle_line(self, line: str) -> None:
        for m in _URL_RE.finditer(line):
            url = m.group(0).rstrip(").,;]")
            if url not in self._opened_urls and "localhost" not in url:
                self._opened_urls.add(url)
                GLib.idle_add(self._show_url, url)
                _open_signin_url(url)
        for m in _CODE_RE.finditer(line):
            code = m.group(1) or m.group(2)
            if code:
                GLib.idle_add(self._show_code, code)

    def _show_url(self, url: str) -> bool:
        self._last_url = url
        self._link_btn.set_visible(True)
        self._status.set_title("Browser should be open")
        self._status.set_description(
            self._account.connect_hint
            + "\n\nIf nothing opened, tap “Open sign-in page again”."
        )
        return False

    def _show_code(self, code: str) -> bool:
        self._code_box.set_visible(True)
        self._code_label.set_text(code)
        self._status.set_title("Enter this code in the browser")
        return False

    def _reopen_link(self, *_a) -> None:
        if self._last_url:
            _open_signin_url(self._last_url)

    def _login_process_finished(self, code: int, tail: str) -> bool:
        self._spinner.stop()
        self._spinner.set_visible(False)
        if code == 0:
            self._status.set_icon_name("emblem-ok-symbolic")
            self._status.set_title(f"{self._account.title} is ready")
            self._status.set_description(
                "You’re signed in. Close this window and go back to Search."
            )
        else:
            # Many OAuth CLIs exit non-zero while still succeeding via browser.
            if self._opened_urls:
                self._status.set_title("Finish in the browser")
                self._status.set_description(
                    "Complete sign-in in the browser window, then tap "
                    "“I’m done signing in”."
                )
            else:
                self._status.set_icon_name("dialog-information-symbolic")
                self._status.set_title("Still need to sign in?")
                self._status.set_description(
                    self._account.connect_hint
                    + " Tap Connect again if nothing happened."
                )
        return False

    def _fail(self, message: str) -> bool:
        self._spinner.stop()
        self._spinner.set_visible(False)
        self._status.set_icon_name("dialog-warning-symbolic")
        self._status.set_title("Couldn’t start sign-in")
        self._status.set_description(message)
        return False

    def _finish(self, *_a) -> None:
        if self._proc and self._proc.poll() is None:
            try:
                self._proc.terminate()
            except OSError:
                pass
        self.close()


class AccountsWindow(Adw.ApplicationWindow):
    def __init__(self, app: Adw.Application, focus_id: str | None = None):
        super().__init__(application=app, title="Connect your helpers")
        self.set_default_size(560, 640)
        self._rows: dict[str, Adw.ActionRow] = {}
        self._focus_id = focus_id

        header = Adw.HeaderBar()
        header.set_title_widget(Adw.WindowTitle(
            title="Connect your helpers",
            subtitle="Sign in once · browser only · no terminal",
        ))
        refresh = Gtk.Button(icon_name="view-refresh-symbolic")
        refresh.set_tooltip_text("Check again")
        refresh.connect("clicked", lambda *_: self._reload_statuses())
        header.pack_end(refresh)

        intro = Gtk.Label(
            label=(
                "Each helper needs its own account. Tap Connect — a browser "
                "opens. Sign in there, then come back. You only do this once "
                "per helper. You never need a terminal."
            ),
            wrap=True,
            xalign=0.0,
        )
        intro.add_css_class("dim-label")
        intro.set_margin_top(8)
        intro.set_margin_bottom(12)
        intro.set_margin_start(4)
        intro.set_margin_end(4)

        self.list = Gtk.ListBox(selection_mode=Gtk.SelectionMode.NONE)
        self.list.add_css_class("boxed-list")

        if acc is None:
            self.list.append(Adw.ActionRow(
                title="Couldn’t load account list",
                subtitle="Try reinstalling teddyOS",
            ))
        else:
            for account in acc.all_accounts():
                self.list.append(self._row(account))

        clamp = Adw.Clamp(maximum_size=520)
        inner = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        inner.set_margin_top(8)
        inner.set_margin_bottom(24)
        inner.set_margin_start(18)
        inner.set_margin_end(18)
        inner.append(intro)
        inner.append(self.list)
        clamp.set_child(inner)

        scroller = Gtk.ScrolledWindow(vexpand=True)
        scroller.set_child(clamp)

        self._toasts = Adw.ToastOverlay()
        self._toasts.set_child(scroller)

        toolbar = Adw.ToolbarView()
        toolbar.add_top_bar(header)
        toolbar.set_content(self._toasts)
        self.set_content(toolbar)

        self._reload_statuses()
        if focus_id:
            GLib.idle_add(self._flash_focus, focus_id)

    def _row(self, account: "acc.Account") -> Gtk.Widget:
        row = Adw.ActionRow(title=account.title)
        row.set_subtitle(account.blurb)
        row.set_subtitle_lines(2)
        icon = Gtk.Image()
        icon.set_pixel_size(28)
        theme = Gtk.IconTheme.get_for_display(self.get_display())
        if theme and theme.has_icon(account.icon):
            icon.set_from_icon_name(account.icon)
        else:
            path = (
                Path("/usr/share/icons/hicolor/scalable/apps")
                / f"{account.icon}.svg"
            )
            if path.is_file():
                icon.set_from_file(str(path))
            else:
                icon.set_from_icon_name("system-users-symbolic")
        row.add_prefix(icon)

        btn = Gtk.Button(label="Connect")
        btn.add_css_class("suggested-action")
        btn.set_valign(Gtk.Align.CENTER)
        btn.connect("clicked", lambda *_a, a=account: self._connect(a))
        row.add_suffix(btn)
        self._rows[account.id] = row
        row._connect_btn = btn  # type: ignore[attr-defined]
        return row

    def _flash_focus(self, account_id: str) -> bool:
        row = self._rows.get(account_id)
        if row is not None:
            row.grab_focus()
        return False

    def _reload_statuses(self) -> None:
        if acc is None:
            return

        def work() -> None:
            results = {}
            for account in acc.all_accounts():
                results[account.id] = (
                    acc.is_installed(account),
                    acc.status_for(account),
                )
            GLib.idle_add(self._apply_statuses, results)

        threading.Thread(target=work, daemon=True).start()

    def _apply_statuses(self, results: dict) -> bool:
        for account_id, (installed, status) in results.items():
            row = self._rows.get(account_id)
            if row is None:
                continue
            account = acc.get_account(account_id)
            blurb = account.blurb if account else ""
            if not installed:
                line = "Not on this computer"
                btn_label = "Unavailable"
                sensitive = False
                row.add_css_class("dim-label")
            else:
                line = status.label
                btn_label = "Connected" if status.ok is True else "Connect"
                sensitive = True
                row.remove_css_class("dim-label")
            row.set_subtitle(f"{line}\n{blurb}")
            btn = getattr(row, "_connect_btn", None)
            if btn is not None:
                btn.set_label(btn_label)
                btn.set_sensitive(sensitive)
                if status.ok is True:
                    btn.remove_css_class("suggested-action")
                else:
                    btn.add_css_class("suggested-action")
        return False

    def _connect(self, account: "acc.Account") -> None:
        argv = acc.resolve_connect_argv(account)
        if not argv:
            self._toast(f"{account.title} isn’t available on this computer.")
            return
        if account.id == "perplexity":
            try:
                subprocess.Popen(  # noqa: S603
                    argv,
                    start_new_session=True,
                    stdin=subprocess.DEVNULL,
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL,
                )
                self._toast("Perplexity opened — sign in there if you want.")
            except OSError:
                self._toast("Couldn’t open Perplexity.")
            return

        log.info("open sign-in id=%s argv=%s", account.id, argv)
        win = SignInWindow(self.get_application(), account, argv)
        win.present()
        win.connect("close-request", self._after_sign_in)

    def _after_sign_in(self, *_a) -> bool:
        GLib.timeout_add(800, self._reload_after_delay)
        return False

    def _reload_after_delay(self) -> bool:
        self._reload_statuses()
        self._toast("Checked your connections.")
        return False

    def _toast(self, message: str) -> None:
        log.info("ui: %s", message)
        try:
            toast = Adw.Toast.new(message)
            toast.set_timeout(4)
            self._toasts.add_toast(toast)
        except Exception:  # noqa: BLE001
            pass


class AccountsApp(Adw.Application):
    def __init__(self, focus_id: str | None = None):
        super().__init__(application_id=APP_ID)
        self._focus_id = focus_id

    def do_activate(self):
        win = self.props.active_window
        if win is None:
            win = AccountsWindow(self, focus_id=self._focus_id)
        win.present()


def main(argv: list[str] | None = None) -> int:
    argv = list(argv if argv is not None else sys.argv)
    focus = None
    if len(argv) >= 3 and argv[1] in ("--connect", "connect"):
        focus = argv[2].lower().strip()
        argv = [argv[0]]
    elif len(argv) >= 2 and not argv[1].startswith("-"):
        focus = argv[1].lower().strip()
        argv = [argv[0]]
    GLib.set_prgname(APP_ID)
    log.info("start focus=%s", focus)
    return AccountsApp(focus_id=focus).run(argv)


if __name__ == "__main__":
    sys.exit(main())
