#!/usr/bin/env python3
"""Connect your helpers — calm setup, browser sign-in, never a terminal.

Flow for one helper:
  1. Soft “Let’s set you up” animation (skip anytime)
  2. Plain status while OAuth runs in the background
  3. Chromium sign-in window if the vendor needs the browser
  4. “I’m done” → back to the list

No VTE, no CLI, no random Firefox.
"""

from __future__ import annotations

import os
import re
import shutil
import subprocess
import sys
import threading
from pathlib import Path

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
from gi.repository import Adw, Gdk, GLib, Gtk  # noqa: E402

sys.path.insert(0, "/usr/lib/teddyos")
try:
    import accounts as acc
    from logutil import get_logger
    log = get_logger("accounts")
except Exception:  # noqa: BLE001
    import logging
    log = logging.getLogger("teddyos.accounts")
    acc = None  # type: ignore

APP_ID = "com.teddyos.Accounts"

_URL_RE = re.compile(r"https?://[^\s\"'<>]+", re.I)
_CODE_RE = re.compile(
    r"\b([A-Z0-9]{4,5}-[A-Z0-9]{4,5})\b"
    r"|\bone-time code[:\s]+([A-Z0-9-]{6,})\b"
    r"|\benter code[:\s]+([A-Z0-9-]{6,})\b"
    r"|\buser code[:\s]+([A-Z0-9-]{6,})\b",
    re.I,
)

# Vendor device pages where we can pre-fill the code in the URL.
_DEVICE_URL_FOR_ACCOUNT = {
    "github": "https://github.com/login/device",
    "copilot": "https://github.com/login/device",
}


def animations_enabled() -> bool:
    settings = Gtk.Settings.get_default()
    if settings is None:
        return True
    return bool(settings.get_property("gtk-enable-animations"))


def _open_signin_url(url: str) -> None:
    """Chromium app window — never a random Firefox tab."""
    opener = shutil.which("teddyos-open-signin")
    if opener:
        argv = [opener, url]
    else:
        chromium = (
            shutil.which("chromium")
            or shutil.which("chromium-browser")
        )
        if chromium:
            data = os.path.expanduser("~/.config/teddyos-signin")
            os.makedirs(data, exist_ok=True)
            argv = [
                chromium,
                f"--app={url}",
                f"--user-data-dir={data}",
                "--class=teddyos-signin",
                "--new-window",
            ]
        else:
            argv = ["xdg-open", url]
    try:
        subprocess.Popen(  # noqa: S603
            argv,
            start_new_session=True,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
    except OSError as exc:
        log.error("open sign-in url failed: %s", exc)


class SignInWindow(Adw.ApplicationWindow):
    """Let’s set you up → then quiet status while the browser does the work."""

    BEAT_IN, BEAT_HOLD, BEAT_OUT, BEAT_REST = 480, 1100, 380, 160

    def __init__(
        self,
        app: Adw.Application,
        account: "acc.Account",
        argv: list[str],
    ):
        super().__init__(
            application=app,
            title=f"Set up {account.title}",
        )
        self.set_default_size(520, 480)
        self._account = account
        self._argv = argv
        self._proc: subprocess.Popen | None = None
        self._opened_urls: set[str] = set()
        self._last_url = ""
        self._last_code = ""
        self._intro_over = False
        self._login_started = False
        self._anims: list[Adw.TimedAnimation] = []
        self._device_opened = False

        # Soft look
        css = Gtk.CssProvider()
        css.load_from_data(b"""
            .teddyos-setup-title { font-size: 28px; font-weight: 600; }
            .teddyos-setup-line { font-size: 22px; font-weight: 500; }
            .teddyos-setup-code { font-size: 32px; font-weight: 700; letter-spacing: 2px; }
            window { background: #fbfbfa; }
        """)
        Gtk.StyleContext.add_provider_for_display(
            self.get_display(), css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION,
        )

        self._header = Adw.HeaderBar(show_title=False)
        self._header.set_opacity(0.0)

        # --- main status page (revealed after intro) ---
        self._title = Gtk.Label(
            label=f"Setting up {account.title}",
            wrap=True,
            justify=Gtk.Justification.CENTER,
        )
        self._title.add_css_class("teddyos-setup-title")

        self._body = Gtk.Label(
            label="Just a moment…",
            wrap=True,
            justify=Gtk.Justification.CENTER,
        )
        self._body.add_css_class("dim-label")
        self._body.set_max_width_chars(40)

        self._spinner = Gtk.Spinner()
        self._spinner.set_size_request(36, 36)
        self._spinner.set_halign(Gtk.Align.CENTER)

        self._code_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        self._code_box.set_halign(Gtk.Align.CENTER)
        self._code_box.set_visible(False)
        code_cap = Gtk.Label(label="Your code (already copied — you usually don’t need it):")
        code_cap.add_css_class("dim-label")
        self._code_label = Gtk.Label(label="")
        self._code_label.add_css_class("teddyos-setup-code")
        self._code_label.set_selectable(True)
        self._code_box.append(code_cap)
        self._code_box.append(self._code_label)

        self._link_btn = Gtk.Button(label="Open sign-in page again")
        self._link_btn.add_css_class("flat")
        self._link_btn.set_halign(Gtk.Align.CENTER)
        self._link_btn.set_visible(False)
        self._link_btn.connect("clicked", self._reopen_link)

        self._done = Gtk.Button(label="I’m done")
        self._done.add_css_class("suggested-action")
        self._done.add_css_class("pill")
        self._done.set_halign(Gtk.Align.CENTER)
        self._done.set_sensitive(False)
        self._done.connect("clicked", self._finish)

        page_col = Gtk.Box(
            orientation=Gtk.Orientation.VERTICAL,
            spacing=18,
            valign=Gtk.Align.CENTER,
            halign=Gtk.Align.CENTER,
            margin_start=40,
            margin_end=40,
        )
        page_col.append(self._title)
        page_col.append(self._body)
        page_col.append(self._spinner)
        page_col.append(self._code_box)
        page_col.append(self._link_btn)
        page_col.append(self._done)
        page_col.set_opacity(0.0)
        self._page = page_col

        # --- intro layer ---
        self._intro_icon = Gtk.Image()
        self._intro_icon.set_pixel_size(56)
