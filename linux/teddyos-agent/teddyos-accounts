            Path("/usr/share/icons/hicolor/scalable/apps")
            / f"{account.icon}.svg"
        )
        if icon_path.is_file():
            self._intro_icon.set_from_file(str(icon_path))
        elif Gtk.IconTheme.get_for_display(self.get_display()).has_icon(account.icon):
            self._intro_icon.set_from_icon_name(account.icon)
        else:
            self._intro_icon.set_from_icon_name("emblem-ok-symbolic")
        self._intro_icon.set_opacity(0.0)

        self._intro_line = Gtk.Label(
            wrap=True, justify=Gtk.Justification.CENTER,
        )
        self._intro_line.add_css_class("teddyos-setup-line")
        self._intro_line.set_max_width_chars(32)
        self._intro_line.set_opacity(0.0)

        intro_col = Gtk.Box(
            orientation=Gtk.Orientation.VERTICAL,
            spacing=28,
            valign=Gtk.Align.CENTER,
            halign=Gtk.Align.CENTER,
            margin_start=40,
            margin_end=40,
        )
        intro_col.append(self._intro_icon)
        intro_col.append(self._intro_line)
        self._intro_col = intro_col

        skip = Gtk.Button(label="Skip")
        skip.add_css_class("flat")
        skip.set_halign(Gtk.Align.END)
        skip.set_valign(Gtk.Align.END)
        skip.set_margin_end(16)
        skip.set_margin_bottom(16)
        skip.set_opacity(0.0)
        skip.connect("clicked", lambda *_: self._intro_finish())
        self._skip = skip

        stack = Gtk.Overlay()
        stack.set_child(self._page)
        stack.add_overlay(intro_col)
        stack.add_overlay(skip)

        toolbar = Adw.ToolbarView()
        toolbar.add_top_bar(self._header)
        toolbar.set_content(stack)
        self.set_content(toolbar)

        log.info("connect start id=%s argv=%s", account.id, argv)

        if animations_enabled():
            self._start_intro()
        else:
            self._intro_finish()

    # --- intro --------------------------------------------------------------

    def _beats(self) -> list[str]:
        name = self._account.title
        return [
            "Let’s set you up.",
            f"We’ll connect {name} in a moment.",
            "A page may open — just approve. We’ll handle any codes.",
        ]

    def _start_intro(self) -> None:
        self._fade(self._intro_icon, 1.0, 700, Adw.Easing.EASE_OUT_CUBIC)
        self._later(800, lambda: self._fade(self._skip, 0.55, 400))
        self._later(500, lambda: self._beat(0))

    def _beat(self, i: int) -> None:
        if self._intro_over:
            return
        beats = self._beats()
        if i >= len(beats):
            self._intro_finish()
            return
        self._intro_line.set_text(beats[i])
        self._fade(self._intro_line, 1.0, self.BEAT_IN, Adw.Easing.EASE_OUT_CUBIC)
        out_at = self.BEAT_IN + self.BEAT_HOLD
        if i == len(beats) - 1:
            self._later(out_at, lambda: self._beat(i + 1))
        else:
            self._later(
                out_at,
                lambda: self._fade(
                    self._intro_line, 0.0, self.BEAT_OUT, Adw.Easing.EASE_IN_CUBIC,
                ),
            )
            self._later(
                out_at + self.BEAT_OUT + self.BEAT_REST,
                lambda: self._beat(i + 1),
            )

    def _intro_finish(self) -> None:
        if self._intro_over:
            return
        self._intro_over = True
        self._fade(self._intro_col, 0.0, 360, Adw.Easing.EASE_IN_CUBIC)
        self._fade(self._skip, 0.0, 240, Adw.Easing.EASE_IN_CUBIC)
        self._later(280, lambda: self._fade(self._page, 1.0, 480, Adw.Easing.EASE_OUT_CUBIC))
        self._later(280, lambda: self._fade(self._header, 1.0, 400, Adw.Easing.EASE_OUT_CUBIC))
        self._later(700, self._begin_login_ui)
        self._later(720, lambda: (
            self._intro_col.set_visible(False),
            self._skip.set_visible(False),
        ))

    def _begin_login_ui(self) -> bool:
        self._spinner.start()
        self._body.set_text(
            f"Getting {self._account.title} ready…\n"
            "A sign-in page may open next."
        )
        self._done.set_sensitive(True)
        self._start_login_process()
        return False

    def _fade(
        self,
        widget: Gtk.Widget,
        to: float,
        ms: int,
        easing: Adw.Easing = Adw.Easing.EASE_IN_OUT_CUBIC,
    ) -> None:
        target = Adw.PropertyAnimationTarget.new(widget, "opacity")
        anim = Adw.TimedAnimation.new(
            widget, widget.get_opacity(), to, ms, target,
        )
        anim.set_easing(easing)
        self._anims.append(anim)
        anim.play()

    def _later(self, ms: int, fn) -> None:
        def once() -> bool:
            fn()
            return False
        GLib.timeout_add(ms, once)

    # --- login process (background, no terminal) ----------------------------

    def _start_login_process(self) -> None:
        if self._login_started:
            return
        self._login_started = True
        threading.Thread(
            target=self._run_login, args=(self._argv,), daemon=True,
        ).start()

    def _run_login(self, argv: list[str]) -> None:
        env = os.environ.copy()
        path = env.get("PATH", "/usr/bin:/bin")
        for extra in ("/usr/local/bin", str(Path.home() / ".local" / "bin")):
            if extra not in path.split(":"):
                path = extra + ":" + path
        env["PATH"] = path
        env["TERM"] = "dumb"
        env["NO_COLOR"] = "1"
        signin = shutil.which("teddyos-open-signin")
        env["BROWSER"] = signin or (
            shutil.which("chromium")
            or shutil.which("chromium-browser")
            or "xdg-open"
        )
        env["CHROME_PATH"] = (
            shutil.which("chromium")
            or shutil.which("chromium-browser")
            or ""
        )
        # gh also honours GH_BROWSER for the web step.
        env["GH_BROWSER"] = env["BROWSER"]
        try:
            # Pseudo-TTY so tools that refuse "non-interactive" still run the
            # browser flow instead of hanging on a prompt nobody can see.
            self._proc = subprocess.Popen(  # noqa: S603
                argv,
                cwd=os.path.expanduser("~"),
                env=env,
                stdin=subprocess.PIPE,
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
                text=True,
                bufsize=1,
            )
            # Nudge past "Press Enter to open …" style gates.
            try:
                if self._proc.stdin:
                    self._proc.stdin.write("\n")
                    self._proc.stdin.flush()
            except OSError:
                pass
        except OSError as exc:
            log.error("connect spawn failed: %s", exc)
            GLib.idle_add(
                self._set_status,
                "Couldn’t start",
                f"Something went wrong starting {self._account.title}. Try again.",
                False,
            )
            return

        assert self._proc.stdout is not None
        try:
            for line in self._proc.stdout:
                self._handle_line(line)
        except Exception as exc:  # noqa: BLE001
            log.error("connect read: %s", exc)
        code = self._proc.wait()
        log.info("connect exit id=%s code=%s", self._account.id, code)
        GLib.idle_add(self._login_process_finished, code)

    def _handle_line(self, line: str) -> None:
        code = None
        for m in _CODE_RE.finditer(line):
            code = next((g for g in m.groups() if g), None)
            if code:
                break
        urls = [
            m.group(0).rstrip(").,;]")
            for m in _URL_RE.finditer(line)
            if "localhost" not in m.group(0)
        ]
        if code:
            GLib.idle_add(self._on_code, code, urls[0] if urls else "")
        for url in urls:
            if url not in self._opened_urls:
                # Prefer opening once with code baked in (handled in _on_code).
                if code and self._account.id in _DEVICE_URL_FOR_ACCOUNT:
                    self._opened_urls.add(url)
                    continue
                self._opened_urls.add(url)
                GLib.idle_add(self._on_url, url)
                _open_signin_url(url)

    def _copy_text(self, text: str) -> None:
        try:
            clip = self.get_clipboard()
            clip.set(text)
        except Exception:  # noqa: BLE001
            try:
                subprocess.run(
                    ["wl-copy"],
                    input=text,
                    text=True,
                    check=False,
                    timeout=2,
                )
            except (OSError, subprocess.TimeoutExpired):
                pass

    def _device_url(self, code: str, base: str = "") -> str:
        """URL that should not require typing the code by hand."""
        known = _DEVICE_URL_FOR_ACCOUNT.get(self._account.id, "")
        base = (base or known or "").rstrip("/")
        if not base:
            return ""
        # GitHub accepts user_code on the device page.
        if "github.com/login/device" in base and "user_code=" not in base:
            return f"https://github.com/login/device?user_code={code}"
        if "user_code=" in base:
            return base
        sep = "&" if "?" in base else "?"
        return f"{base}{sep}user_code={code}"

    def _on_url(self, url: str) -> bool:
        self._last_url = url
        self._link_btn.set_visible(True)
        if self._last_code and not self._device_opened:
            # Upgrade to pre-filled device URL when code arrived first.
            filled = self._device_url(self._last_code, url)
            if filled:
                self._last_url = filled
                _open_signin_url(filled)
                self._device_opened = True
        self._set_status(
            "Sign in is open",
            f"Finish in the window we opened for {self._account.title}, "
            "then tap I’m done. You shouldn’t need to type anything.",
            spinning=True,
        )
        return False

    def _on_code(self, code: str, url_hint: str = "") -> bool:
        self._last_code = code
        self._code_box.set_visible(True)
        self._code_label.set_text(code)
        self._copy_text(code)

        filled = self._device_url(code, url_hint or self._last_url)
        if filled and not self._device_opened:
            self._last_url = filled
            self._opened_urls.add(filled)
            _open_signin_url(filled)
            self._device_opened = True
            self._link_btn.set_visible(True)
            self._set_status(
                "Almost done — just approve",
                f"We opened {self._account.title} sign-in and filled in your "
                "code. In the browser, sign in if needed and click Approve. "
                "Then come back and tap I’m done.",
                spinning=True,
            )
        else:
            self._link_btn.set_visible(True)
            self._set_status(
                "Code ready",
                "We copied the code for you. Tap “Open sign-in page again” "
                "if the browser didn’t open, then Approve.",
                spinning=True,
            )
        return False

    def _set_status(self, title: str, body: str, spinning: bool = True) -> bool:
        self._title.set_text(title)
        self._body.set_text(body)
        if spinning:
            self._spinner.start()
            self._spinner.set_visible(True)
        else:
            self._spinner.stop()
            self._spinner.set_visible(False)
        return False

    def _login_process_finished(self, code: int) -> bool:
        self._spinner.stop()
        self._spinner.set_visible(False)
        if code == 0 or self._opened_urls:
            # So later `git clone` HTTPS works without a password prompt.
            if self._account.id == "github" and shutil.which("gh"):
                try:
                    subprocess.run(
                        ["gh", "auth", "setup-git"],
                        capture_output=True,
                        timeout=15,
                        check=False,
                    )
                except (OSError, subprocess.TimeoutExpired):
                    pass
            self._title.set_text(f"{self._account.title} is ready")
            self._body.set_text(
                "You’re all set. Tap I’m done, then go back to Search."
            )
        else:
            self._title.set_text("Still need a moment?")
            self._body.set_text(
                f"If nothing opened, tap “Open sign-in again”. "
                f"Or close this and try Connect on {self._account.title} once more."
            )
            self._link_btn.set_visible(True)
        self._done.set_sensitive(True)
        self._done.add_css_class("suggested-action")
        return False

    def _reopen_link(self, *_a) -> None:
        if self._last_code:
            filled = self._device_url(self._last_code, self._last_url)
            if filled:
                self._copy_text(self._last_code)
                _open_signin_url(filled)
                return
        if self._last_url:
            _open_signin_url(self._last_url)
            return
        self._login_started = False
        self._start_login_process()

    def _finish(self, *_a) -> None:
        if self._proc and self._proc.poll() is None:
            try:
                self._proc.terminate()
            except OSError:
                pass
        self.close()


class AccountsWindow(Adw.ApplicationWindow):
    def __init__(self, app: Adw.Application, focus_id: str | None = None):
        super().__init__(application=app, title="Connect your helpers")
        self.set_default_size(560, 640)
        self._rows: dict[str, Adw.ActionRow] = {}
        self._focus_id = focus_id
        self._anims: list[Adw.TimedAnimation] = []
        self._welcome_done = False

        css = Gtk.CssProvider()
        css.load_from_data(b"""
            .teddyos-setup-line { font-size: 22px; font-weight: 500; }
            window { background: #fbfbfa; }
        """)
        Gtk.StyleContext.add_provider_for_display(
            self.get_display(), css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION,
        )

        header = Adw.HeaderBar()
        header.set_title_widget(Adw.WindowTitle(
            title="Connect your helpers",
            subtitle="One-time sign-in · no technical steps",
        ))
        refresh = Gtk.Button(icon_name="view-refresh-symbolic")
        refresh.set_tooltip_text("Check again")
        refresh.connect("clicked", lambda *_: self._reload_statuses())
        header.pack_end(refresh)
        self._header = header

        intro = Gtk.Label(
            label=(
                "Each helper needs its own account. Tap Connect — we’ll walk "
                "you through a short setup. A sign-in page may open; finish "
                "there, then come back."
            ),
            wrap=True,
            xalign=0.0,
        )
        intro.add_css_class("dim-label")
        intro.set_margin_top(8)
        intro.set_margin_bottom(12)
        intro.set_margin_start(4)
        intro.set_margin_end(4)

        self.list = Gtk.ListBox(selection_mode=Gtk.SelectionMode.NONE)
        self.list.add_css_class("boxed-list")

        if acc is None:
            self.list.append(Adw.ActionRow(
                title="Couldn’t load account list",
                subtitle="Try reinstalling teddyOS",
            ))
        else:
            for account in acc.all_accounts():
                self.list.append(self._row(account))

        clamp = Adw.Clamp(maximum_size=520)
        inner = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        inner.set_margin_top(8)
        inner.set_margin_bottom(24)
        inner.set_margin_start(18)
        inner.set_margin_end(18)
        inner.append(intro)
        inner.append(self.list)
        clamp.set_child(inner)

        scroller = Gtk.ScrolledWindow(vexpand=True)
        scroller.set_child(clamp)

        self._toasts = Adw.ToastOverlay()
        self._toasts.set_child(scroller)

        self._main = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        toolbar = Adw.ToolbarView()
        toolbar.add_top_bar(header)
        toolbar.set_content(self._toasts)
        self._main.append(toolbar)

        # Optional welcome wash when opening the list (not a deep-link connect).
        if focus_id is None and animations_enabled():
            self._main.set_opacity(0.0)
            overlay = Gtk.Overlay()
            overlay.set_child(self._main)
            welcome = self._welcome_layer()
            overlay.add_overlay(welcome)
            self.set_content(overlay)
            self._run_welcome(welcome)
        else:
            self.set_content(self._main)
            self._welcome_done = True

        self._reload_statuses()
        if focus_id and acc and acc.get_account(focus_id):
            # Deep-link: go straight into that helper’s setup after a tick.
            GLib.timeout_add(200, lambda: (self._connect(acc.get_account(focus_id)), False)[1])

    def _welcome_layer(self) -> Gtk.Widget:
        line = Gtk.Label(
            label="Let’s set you up.",
            wrap=True,
            justify=Gtk.Justification.CENTER,
        )
        line.add_css_class("teddyos-setup-line")
        line.set_opacity(0.0)
        self._welcome_line = line

        icon = Gtk.Image.new_from_icon_name("system-users-symbolic")
        icon.set_pixel_size(48)
        icon.add_css_class("dim-label")
        icon.set_opacity(0.0)
        self._welcome_icon = icon

        col = Gtk.Box(
            orientation=Gtk.Orientation.VERTICAL,
            spacing=24,
            valign=Gtk.Align.CENTER,
            halign=Gtk.Align.CENTER,
        )
        col.append(icon)
        col.append(line)
        self._welcome_col = col
        return col

    def _run_welcome(self, layer: Gtk.Widget) -> None:
        def fade(w, to, ms, easing=Adw.Easing.EASE_OUT_CUBIC):
            t = Adw.PropertyAnimationTarget.new(w, "opacity")
            a = Adw.TimedAnimation.new(w, w.get_opacity(), to, ms, t)
            a.set_easing(easing)
            self._anims.append(a)
            a.play()

        def later(ms, fn):
            GLib.timeout_add(ms, lambda: (fn(), False)[1])

        fade(self._welcome_icon, 1.0, 600)
        later(500, lambda: (
            self._welcome_line.set_text("Let’s set you up."),
            fade(self._welcome_line, 1.0, 450),
        ))
        later(500 + 450 + 1000, lambda: fade(self._welcome_line, 0.0, 350, Adw.Easing.EASE_IN_CUBIC))
        later(500 + 450 + 1000 + 400, lambda: (
            self._welcome_line.set_text("Connect the helpers you want to use."),
            fade(self._welcome_line, 1.0, 450),
        ))
        later(500 + 450 + 1000 + 400 + 450 + 1100, lambda: (
            fade(self._welcome_col, 0.0, 380, Adw.Easing.EASE_IN_CUBIC),
            fade(self._main, 1.0, 500),
        ))
        later(500 + 450 + 1000 + 400 + 450 + 1100 + 500, lambda: (
            self._welcome_col.set_visible(False),
            setattr(self, "_welcome_done", True),
        ))

    def _row(self, account: "acc.Account") -> Gtk.Widget:
        row = Adw.ActionRow(title=account.title)
        row.set_subtitle(account.blurb)
        row.set_subtitle_lines(2)
        icon = Gtk.Image()
        icon.set_pixel_size(28)
        theme = Gtk.IconTheme.get_for_display(self.get_display())
        if theme and theme.has_icon(account.icon):
            icon.set_from_icon_name(account.icon)
        else:
            path = (
                Path("/usr/share/icons/hicolor/scalable/apps")
                / f"{account.icon}.svg"
            )
            if path.is_file():
                icon.set_from_file(str(path))
            else:
                icon.set_from_icon_name("system-users-symbolic")
        row.add_prefix(icon)

        btn = Gtk.Button(label="Connect")
        btn.add_css_class("suggested-action")
        btn.set_valign(Gtk.Align.CENTER)
        btn.connect("clicked", lambda *_a, a=account: self._connect(a))
        row.add_suffix(btn)
        self._rows[account.id] = row
        row._connect_btn = btn  # type: ignore[attr-defined]
        return row

    def _reload_statuses(self) -> None:
        if acc is None:
            return

        def work() -> None:
            results = {}
            for account in acc.all_accounts():
                results[account.id] = (
                    acc.is_installed(account),
                    acc.status_for(account),
                )
            GLib.idle_add(self._apply_statuses, results)

        threading.Thread(target=work, daemon=True).start()

    def _apply_statuses(self, results: dict) -> bool:
        for account_id, (installed, status) in results.items():
            row = self._rows.get(account_id)
            if row is None:
                continue
            account = acc.get_account(account_id)
            blurb = account.blurb if account else ""
            if not installed:
                line = "Not on this computer"
                btn_label = "Unavailable"
                sensitive = False
                row.add_css_class("dim-label")
            else:
                line = status.label
                # Only "Connected" when we know for sure. Unknown → still Connect.
                if status.ok is True:
                    btn_label = "Connected"
                else:
                    btn_label = "Connect"
                sensitive = True
                row.remove_css_class("dim-label")
            row.set_subtitle(f"{line}\n{blurb}")
            btn = getattr(row, "_connect_btn", None)
            if btn is not None:
                btn.set_label(btn_label)
                btn.set_sensitive(sensitive)
                if status.ok is True:
                    btn.remove_css_class("suggested-action")
                else:
                    btn.add_css_class("suggested-action")
        return False

    def _connect(self, account: "acc.Account | None") -> None:
        if account is None:
            return
        argv = acc.resolve_connect_argv(account)
        if not argv:
            self._toast(f"{account.title} isn’t available on this computer.")
            return
        if account.id == "perplexity":
            try:
                subprocess.Popen(  # noqa: S603
                    argv,
                    start_new_session=True,
                    stdin=subprocess.DEVNULL,
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL,
                )
                self._toast("Perplexity opened — sign in there if you want.")
            except OSError:
                self._toast("Couldn’t open Perplexity.")
            return

        log.info("open sign-in id=%s argv=%s", account.id, argv)
        win = SignInWindow(self.get_application(), account, argv)
        win.present()
        win.connect("close-request", self._after_sign_in)

    def _after_sign_in(self, *_a) -> bool:
        GLib.timeout_add(800, self._reload_after_delay)
        return False

    def _reload_after_delay(self) -> bool:
        self._reload_statuses()
        self._toast("Checked your connections.")
        return False

    def _toast(self, message: str) -> None:
        log.info("ui: %s", message)
        try:
            toast = Adw.Toast.new(message)
            toast.set_timeout(4)
            self._toasts.add_toast(toast)
        except Exception:  # noqa: BLE001
            pass


class AccountsApp(Adw.Application):
    def __init__(self, focus_id: str | None = None):
        super().__init__(application_id=APP_ID)
        self._focus_id = focus_id

    def do_activate(self):
        win = self.props.active_window
        if win is None:
            win = AccountsWindow(self, focus_id=self._focus_id)
        win.present()


def main(argv: list[str] | None = None) -> int:
    argv = list(argv if argv is not None else sys.argv)
    focus = None
    if len(argv) >= 3 and argv[1] in ("--connect", "connect"):
        focus = argv[2].lower().strip()
        argv = [argv[0]]
    elif len(argv) >= 2 and not argv[1].startswith("-"):
        focus = argv[1].lower().strip()
        argv = [argv[0]]
    GLib.set_prgname(APP_ID)
    log.info("start focus=%s", focus)
    return AccountsApp(focus_id=focus).run(argv)


if __name__ == "__main__":
    sys.exit(main())
