#!/usr/bin/env python3
"""Open Perplexity as a simple browser window.

Perplexity is a web product for most people. Dropping them into a CLI or
asking them to find perplexity.ai is the wrong path. This is a thin
launcher: one window, signed-in session kept, no address bar clutter.
"""

from __future__ import annotations

import os
import shutil
import subprocess
import sys


URL = "https://www.perplexity.ai/"
CLASS = "teddyos-perplexity"
DATA = os.path.expanduser("~/.config/teddyos-perplexity")


def main() -> int:
    chromium = (
        shutil.which("chromium")
        or shutil.which("chromium-browser")
        or shutil.which("google-chrome")
        or shutil.which("google-chrome-stable")
    )
    if not chromium:
        print("no browser available for Perplexity", file=sys.stderr)
        return 1
    os.makedirs(DATA, exist_ok=True)
    argv = [
        chromium,
        f"--app={URL}",
        f"--class={CLASS}",
        f"--user-data-dir={DATA}",
    ]
    try:
        subprocess.Popen(  # noqa: S603
            argv,
            start_new_session=True,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
    except OSError as exc:
        print(exc, file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
