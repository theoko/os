#!/usr/bin/env python3
"""Run a terminal AI tool in a real window.

Claude, Gemini, and Codex are all interactive terminal programs. Spawning them
with Gio.Subprocess from Search gives them no TTY — they print
"stdin is not a terminal" and exit. The person sees a click that does nothing.

This window is a thin VTE host: title, icon colour via the header, project
folder as the working directory, one program, no shell prompt. Same idea as
teddyos-claude, shared so every AI helper opens the same way.

Usage:
  teddyos-agent gemini
  teddyos-agent gemini /path/to/project
  teddyos-agent codex ~/Projects/tsearch-revival
  teddyos-agent claude .
"""

from __future__ import annotations

import os
import shutil
import sys
from pathlib import Path

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
gi.require_version("Vte", "3.91")
from gi.repository import Adw, Gdk, GLib, Gtk, Pango, Vte  # noqa: E402

try:
    sys.path.insert(0, "/usr/lib/teddyos")
    from logutil import get_logger
    log = get_logger("agent")
except Exception:  # noqa: BLE001
    import logging
    log = logging.getLogger("teddyos.agent")

APP_ID = "com.teddyos.Agent"

# id → (binary name, window title, missing-copy)
TOOLS: dict[str, tuple[str, str, str]] = {
    "claude": (
        "claude",
        "Claude",
        "Claude isn’t installed on this copy of teddyOS.",
    ),
    "grok": (
        "grok",
        "Grok",
        "Grok isn’t installed on this copy of teddyOS.",
    ),
    "gemini": (
        "gemini",
        "Gemini",
        "Gemini isn’t installed on this copy of teddyOS.",
    ),
    "codex": (
        "codex",
        "Codex",
        "Codex isn’t installed on this copy of teddyOS.",
    ),
    "aider": (
        "aider",
        "Aider",
        "Aider isn’t installed on this copy of teddyOS.",
    ),
    "ollama": (
        "ollama",
        "Ollama",
        "Ollama isn’t installed on this copy of teddyOS.",
    ),
}


def _parse_argv(argv: list[str]) -> tuple[str, str, list[str]]:
    """Return (tool_id, cwd, extra_args for the tool)."""
    home = os.path.expanduser("~")
    if len(argv) < 2 or argv[1] in ("-h", "--help"):
        names = ", ".join(sorted(TOOLS))
        print(f"usage: teddyos-agent <tool> [project-dir]\n  tools: {names}",
              file=sys.stderr)
        sys.exit(0 if len(argv) > 1 else 2)
    tool = argv[1].lower().strip()
    cwd = home
    extra: list[str] = []
    for arg in argv[2:]:
        if arg.startswith("-"):
            extra.append(arg)
            continue
        path = os.path.expanduser(arg)
        if os.path.isdir(path) and cwd == home:
            cwd = os.path.abspath(path)
        else:
            extra.append(arg)
    return tool, cwd, extra


class AgentWindow(Adw.ApplicationWindow):
    def __init__(
        self,
        app: Adw.Application,
        tool_id: str,
        cwd: str,
        extra: list[str],
    ):
        meta = TOOLS.get(tool_id)
        title = meta[1] if meta else tool_id.title()
        base = os.path.basename(cwd.rstrip("/")) or title
        if cwd != os.path.expanduser("~"):
            win_title = f"{title} — {base}"
        else:
            win_title = title
        super().__init__(application=app, title=win_title)
        self.set_default_size(900, 620)
        self._cwd = cwd
        self._tool_id = tool_id
        self._extra = extra

        header = Adw.HeaderBar()
        header.set_title_widget(Adw.WindowTitle(
            title=title,
            subtitle=cwd if cwd != os.path.expanduser("~") else "",
        ))

        if not meta:
            content = Adw.StatusPage(
                icon_name="dialog-information-symbolic",
                title="Unknown helper",
                description=f"teddyOS doesn’t know how to open “{tool_id}”.",
            )
        else:
            binary, _title, missing = meta
            exe = shutil.which(binary)
            content = (
                self._terminal(exe, binary)
                if exe
                else Adw.StatusPage(
                    icon_name="dialog-information-symbolic",
                    title=f"{_title} isn’t available",
                    description=missing + " Reinstalling teddyOS usually brings it back.",
                )
            )

        toolbar = Adw.ToolbarView()
        toolbar.add_top_bar(header)
        toolbar.set_content(content)
        self.set_content(toolbar)

    def _terminal(self, exe: str, binary: str) -> Gtk.Widget:
        term = Vte.Terminal()
        term.set_scrollback_lines(10000)
        term.set_font(Pango.FontDescription("monospace 11"))
        term.set_cursor_blink_mode(Vte.CursorBlinkMode.OFF)
        term.set_margin_top(10)
        term.set_margin_bottom(10)
        term.set_margin_start(12)
        term.set_margin_end(12)

        fg, bg = Gdk.RGBA(), Gdk.RGBA()
        fg.parse("#2c2c2a")
        bg.parse("#fbfbfa")
        term.set_colors(fg, bg, None)

        # Do NOT auto-close on exit. Gemini/Codex often exit immediately with
        # "please sign in" — closing the window made the click look like a no-op.
        term.connect("child-exited", self._on_child_exited)

        # Important: do NOT pass the project path as a CLI argument. Gemini and
        # Codex treat a bare argument as a prompt, not a working directory.
        # The folder is the process cwd — that is what "open this project" means.
        # Use `node` + script for .js shims: some desktops spawn shebangs badly.
        cmd = self._cmd_for(exe, binary)
        if binary == "ollama" and not self._extra:
            cmd = [exe, "run", "llama3.2"]

        log.info("spawn tool=%s cwd=%s cmd=%s", self._tool_id, self._cwd, cmd)

        path_env = os.environ.get(
            "PATH",
            "/usr/local/bin:/usr/bin:/bin",
        )
        # GUI apps often get a thin PATH without /usr/local/bin — where npm
        # puts gemini/codex/node.
        for extra in ("/usr/local/bin", str(Path.home() / ".local" / "bin")):
            if extra not in path_env.split(":"):
                path_env = extra + ":" + path_env

        env = [
            f"TERM=xterm-256color",
            f"HOME={os.path.expanduser('~')}",
            f"PATH={path_env}",
            f"PWD={self._cwd}",
            f"COLORTERM=truecolor",
            f"USER={os.environ.get('USER', '')}",
            f"LANG={os.environ.get('LANG', 'C.UTF-8')}",
        ]
        # Pass through auth tokens if the desktop session has them — GUI
        # launches often drop a login shell's env otherwise.
        for key in (
            "ANTHROPIC_API_KEY",
            "GEMINI_API_KEY",
            "GOOGLE_API_KEY",
            "OPENAI_API_KEY",
            "GOOGLE_GENAI_USE_VERTEXAI",
            "GOOGLE_GENAI_USE_GCA",
            "DBUS_SESSION_BUS_ADDRESS",
            "XDG_RUNTIME_DIR",
            "DISPLAY",
            "WAYLAND_DISPLAY",
        ):
            val = os.environ.get(key)
            if val:
                env.append(f"{key}={val}")

        term.spawn_async(
            Vte.PtyFlags.DEFAULT,
            self._cwd,
            cmd,
            env,
            GLib.SpawnFlags.DEFAULT,
            None, None,
            -1, None, self._on_spawn_finished, None,
        )

        self._term = term
        scroller = Gtk.ScrolledWindow(vexpand=True, hexpand=True)
        scroller.set_child(term)
        return scroller

    def _cmd_for(self, exe: str, binary: str) -> list[str]:
        """Prefer `node script.js` for npm shims so spawn never depends on #!."""
        try:
            real = os.path.realpath(exe)
        except OSError:
            real = exe
        # Some installs leave a shell wrapper; follow one more hop.
        if not real.endswith((".js", ".cjs", ".mjs")):
            try:
                with open(exe, "rb") as fh:
                    head = fh.read(120)
                if b"node" in head and b".js" in head:
                    real = os.path.realpath(exe)
            except OSError:
                pass
        if real.endswith((".js", ".cjs", ".mjs")):
            node = (
                shutil.which("node")
                or ("/usr/local/bin/node" if os.path.isfile("/usr/local/bin/node") else None)
                or "/usr/bin/node"
            )
            return [node, real, *self._extra]
        return [exe, *self._extra]

    def _on_spawn_finished(self, _terminal, pid: int, error=None, *_rest) -> None:
        if error is not None:
            msg = error.message if hasattr(error, "message") else str(error)
            log.error("spawn failed tool=%s: %s", self._tool_id, msg)
            # Surface the failure in the window instead of a blank flash.
            page = Adw.StatusPage(
                icon_name="dialog-warning-symbolic",
                title="Couldn’t start",
                description=(
                    "Something went wrong opening this helper. "
                    "Try again, or open Terminal and ask for help."
                ),
            )
            # Replace content if still alive.
            try:
                child = self.get_content()
                if isinstance(child, Adw.ToolbarView):
                    child.set_content(page)
            except Exception:
                pass

    def _on_child_exited(self, _terminal, _status: int) -> None:
        # Keep the window open so sign-in / error text stays readable.
        log.info("child exited tool=%s status=%s", self._tool_id, _status)


class AgentApp(Adw.Application):
    def __init__(self, tool_id: str, cwd: str, extra: list[str]):
        # Unique id per tool so Claude and Gemini can stay open together.
        super().__init__(application_id=f"com.teddyos.Agent.{tool_id}")
        self._tool_id = tool_id
        self._cwd = cwd
        self._extra = extra

    def do_activate(self):
        win = self.props.active_window
        if win is None:
            win = AgentWindow(
                self, self._tool_id, self._cwd, self._extra,
            )
        win.set_visible(True)
        win.present()
        # Raise after present — on some Wayland sessions a first present()
        # alone leaves the window behind the Search dialog.
        GLib.idle_add(lambda: (win.present(), False)[1])


if __name__ == "__main__":
    tool_id, cwd, extra = _parse_argv(sys.argv)
    GLib.set_prgname(f"com.teddyos.Agent.{tool_id}")
    log.info("start tool=%s cwd=%s", tool_id, cwd)
    app = AgentApp(tool_id, cwd, extra)
    sys.exit(app.run([sys.argv[0]]))
