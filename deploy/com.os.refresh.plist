<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.os.refresh</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/theodorekonstantopoulos/Desktop/os/scripts/refresh-index.sh</string>
  </array>
  <!-- Daily at 08:00. The teddy corpus is crawled around 07:00 ET, so this
       picks up a fresh crawl without polling the site. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>8</integer>
    <key>Minute</key><integer>0</integer>
  </dict>
  <!-- Do not run on load: installing a timer should not immediately reach out
       to the network or walk the disk. -->
  <key>RunAtLoad</key>
  <false/>
  <key>StandardOutPath</key>
  <string>/Users/theodorekonstantopoulos/Desktop/os/.refresh.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/theodorekonstantopoulos/Desktop/os/.refresh.log</string>
  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
