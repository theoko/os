# limine is tracked as a submodule and, until now, was declared nowhere.
#
# Git had the gitlink (mode 160000 at ee5d29cd), .gitignore had `/limine/`, and
# there was no .gitmodules — three states for one path, of which only the first
# does anything. The effect was that `git submodule update --init` did nothing,
# a fresh clone got an empty limine/, and `make iso` died at its first
# dependency. The repo could only be built by whoever already had the directory.
#
# branch is the binary branch, which is what the Makefile wants: it ships the
# prebuilt BOOTAA64.EFI and friends plus the host tool's source, so no
# bootloader toolchain is needed to build an image.
#
# ignore = dirty because compiling the host tool leaves artifacts inside the
# checkout — limine.dSYM/ on macOS — and a parent repo that reports itself
# modified after a normal build teaches people to ignore `git status`.
[submodule "limine"]
	path = limine
	url = https://github.com/limine-bootloader/limine.git
	branch = v9.x-binary
	ignore = dirty
